#include "fw.h"
#include "cm.c"






uint32_t g_pmd_cm_base_addr;
pmd_cm_t g_pmd_cm [MAX_NUM_CM];
uint8_t  g_cm_pcie_save_cntx [MAX_NUM_CM];


bool (*pll_handler_fw_cmd_func_array [NUM_PLL_HANDLER_CMD]) (uint8_t a_cm_no) = {
  pmd_cm__pll_fw_cmd0_cntx_cfg,           
  pmd_cm__pll_fw_cmd1_b4_pllcal,          
  pmd_cm__pll_fw_cmd2_after_pllcal,       
  pmd_cm__pll_fw_cmd3_b4_pll_cntx_switch, 
  pmd_cm__pll_fw_cmd4_b4_pll_disable,     
  pmd_cm__pll_fw_cmd_reserved,            
  pmd_cm__pll_fw_cmd_reserved,            
  pmd_cm__pll_fw_cmd_reserved,            
};

pmd_pll_cfg_settings pmd_pll_cfg_settings_h  [MAX_NUM_CM];


void pmd_cm__static_config (uint8_t a_cm_no) {

  g_pmd_cm_base_addr = g_pmd_cm_base_addr_lut[a_cm_no];

  pmd_cm_t  *vp_pmd_cm = &g_pmd_cm[a_cm_no];
  uint8_t   v_pll_mode; 
  bool      v_cfg_rescal_mode;




  
  v_pll_mode                      = READ_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__CM_CFG0__CM_LANE_MODE );  
  vp_pmd_cm->m_fw_skip_cmX_pwr_up = READ_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__FW_CSR1__FW_SKIP_CMX_PWRUP );

  


  
  vp_pmd_cm->m_pll_handler_st             = e_pmd_handler_idle_st;
  vp_pmd_cm->m_pll_fw_cmd1_b4_pllcal_st   = e_pll_fw_cmd1_b4_pllcal_init_st;
  vp_pmd_cm->m_pllX_host_brk_pnt_st       = e_req1_st;
  vp_pmd_cm->m_skip_pll_handler_ack       = false;
  vp_pmd_cm->m_vctl_temp_meas_in_prog     = false;
  







  

  
  


  
  if (((gPmdConfigBlock.m_use_cm0_only == 1 && gPmdConfigBlock.m_use_cm1_only == 0) || g_retimer_en) && a_cm_no == 1) {
    v_cfg_rescal_mode = e_rescal_mode_slave;

  } else if (gPmdConfigBlock.m_use_cm0_only == 0 && gPmdConfigBlock.m_use_cm1_only == 1 && a_cm_no == 0) {
    v_cfg_rescal_mode = e_rescal_mode_slave;

  } else {
    v_cfg_rescal_mode = READ_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__PMD_CM_OVRDVAL2__CMX_RESCAL_MODE_I );
  }

  if (v_cfg_rescal_mode == e_rescal_mode_slave) {
    WRITE_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__PMD_CM_OVRDVAL2__CMX_RESCAL_MODE_I, e_rescal_mode_slave );
    WRITE_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__PMD_CM_OVRDEN0__OVRD_EN_CMX_RESCAL_MODE_I, 1 );
  }

  if (v_cfg_rescal_mode == e_rescal_mode_master) {
    g_cm_rescal_codes.m_master_cm = a_cm_no;
  }
  


  
  if (v_pll_mode == e_pcie_mode) { 
    WRITE_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__FW_CSR0__PLLX_FW_CMD_SKIP_7_0, 0xF0 );
  } else {
    WRITE_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__FW_CSR0__PLLX_FW_CMD_SKIP_7_0, 0xFC );
  }

  

  
  if (v_pll_mode == e_eth_mode) { 
    g_reg_val = READ_REG (g_pmd_cm_base_addr, PMD_CM__FW_CSR0__ADDR);
    SET_FIELD (g_reg_val, PMD_CM__FW_CSR0__USE_PLLX_FW_SKIP_CAL, 1);
    SET_FIELD (g_reg_val, PMD_CM__FW_CSR0__PLLX_FW_SKIP_CAL, 0);
    WRITE_REG (g_pmd_cm_base_addr, PMD_CM__FW_CSR0__ADDR, g_reg_val);
  }
  

  
  


  
  

  
  

  cm__static_config (a_cm_no, v_pll_mode); 
}




ATTR_INLINE void pmd_cm__pll_handler (uint8_t a_cm_no) {
  uint8_t v_poll_cntr;
  bool    v_flag;

  pmd_cm_t *vp_pmd_cm = &g_pmd_cm[a_cm_no];

  g_pmd_cm_base_addr = g_pmd_cm_base_addr_lut[a_cm_no];
  g_cm_base_addr     = g_cm_base_addr_lut[a_cm_no];


  switch (vp_pmd_cm->m_pll_handler_st) {
    case e_pmd_handler_idle_st: {
      g_reg_val = READ_REG( g_pmd_cm_base_addr, PMD_CM__FW_STAT__ADDR ); 
      v_flag    = GET_FIELD( g_reg_val, PMD_CM__FW_STAT__PLLX_FW_CMD_EN ); 

      if (v_flag == 0) {
        break;
      }

      
      vp_pmd_cm->m_pll_handler_cmd = GET_FIELD( g_reg_val, PMD_CM__FW_STAT__PLLX_FW_CMD_2_0 );

      vp_pmd_cm->m_pll_handler_st = e_pmd_handler_req_st;
      
    }

    case e_pmd_handler_req_st: {
      v_flag = pll_handler_fw_cmd_func_array[vp_pmd_cm->m_pll_handler_cmd] (a_cm_no);
     
      if (v_flag == 0) {
        break;
      }

      if (vp_pmd_cm->m_skip_pll_handler_ack == 0) {
        vp_pmd_cm->m_pll_handler_st = e_pmd_handler_ack_st;
        

      } else { 
        vp_pmd_cm->m_pll_handler_st       = e_pmd_handler_idle_st;
        vp_pmd_cm->m_skip_pll_handler_ack = 0;  
        break;
      }
    }
    
    case e_pmd_handler_ack_st: {
      
      WRITE_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__FW_CSR0__PLLX_FW_CMD_ACK, 0x1 );
      
      
      v_poll_cntr = 0;
      do {
        g_reg_val = READ_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__FW_STAT__PLLX_FW_CMD_EN );
        v_poll_cntr++;
      } while ((g_reg_val == 1) && (v_poll_cntr < 10));
    
      if ((g_reg_val == 1) && (v_poll_cntr == 10)) {
        break;
      }
    
      
      WRITE_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__FW_CSR0__PLLX_FW_CMD_ACK, 0x0 );
      
      
    }

    default: {
      vp_pmd_cm->m_pll_handler_st = e_pmd_handler_idle_st;
      break;
    }
  }
}



ATTR_INLINE bool pmd_cm__pll_fw_cmd0_cntx_cfg (uint8_t a_cm_no) { 

  cm_t     *vp_cm     = &g_cm[a_cm_no];

  pmd_cm__fw_csr__fw_spare_t v_pmd_cm__fw_csr__fw_spare;

  
  vp_cm->m_pllX_cntx = READ_REG_FIELD (g_pmd_cm_base_addr, PMD_CM__FW_STAT__PLLX_CNTX_TO_FW_5_0 );

  
  v_pmd_cm__fw_csr__fw_spare.reg = READ_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__FW_CSR0__FW_SPARE_15_0 );

  if (v_pmd_cm__fw_csr__fw_spare.fields.m_pllX_new_cntx == 1) {
    vp_cm->m_pllX_cntx = v_pmd_cm__fw_csr__fw_spare.fields.m_pllX_new_cntx_encoding;
  }
  

  cm__pll_cntx_config (a_cm_no, vp_cm->m_pllX_cntx);

  return true;
}



ATTR_INLINE bool pmd_cm__pll_fw_cmd1_b4_pllcal (uint8_t a_cm_no) { 
  bool v_done = false;
  bool v_flag = false;

  pmd_cm_t *vp_pmd_cm = &g_pmd_cm[a_cm_no];
  cm_t     *vp_cm     = &g_cm[a_cm_no];

  switch (vp_pmd_cm->m_pll_fw_cmd1_b4_pllcal_st) {

    case e_pll_fw_cmd1_b4_pllcal_init_st: {


      pmd_cm__pll_fw_cmd1_b4_pllcal_host_brk_pnt_en (a_cm_no);

      if ((vp_cm->m_pll_mode == e_pcie_mode) && (vp_cm->m_pllX_cntx_sr_idx < NUM_PCIE_SR_PLLX_CNTX)) {
        pmd_cm__pll_fw_cmd1_b4_pllcal_code_restore (a_cm_no);
      }

      if ( (g_fw_fastsim_en == 0) || ((g_fw_ufastsim_0_fastsim_1 == 1) && (g_fw_fastsim_en == 1)) )  
      {  
        vp_pmd_cm->m_fw_skip_cmX_temp_track = READ_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__FW_CSR1__FW_SKIP_CMX_TEMP_TRACK);

      } else {  
        vp_pmd_cm->m_fw_skip_cmX_temp_track = true; 
      }

      vp_pmd_cm->m_pll_fw_cmd1_b4_pllcal_st = e_pll_fw_cmd1_b4_pllcal_meas_temp_st;
      
    }

    case e_pll_fw_cmd1_b4_pllcal_meas_temp_st: {

         if (vp_pmd_cm->m_fw_skip_cmX_temp_track == 0) {

        if ((general_debug_fsm_h.m_tsense_in_prog == false) && (general_debug_fsm_busy == 0)) {  
          general_debug_fsm_h.m_tsense_in_prog = true;

          general_debug_fsm_h.m_cm_no = a_cm_no;

          general_debug_fsm_h.m_lane_count = 1;

          if (general_debug_fsm_h.m_lane_count == 2) {
            general_debug_fsm_h.m_lane_no[0] = (a_cm_no == 0) ? 0 : 2;
            general_debug_fsm_h.m_lane_no[1] = (a_cm_no == 0) ? 1 : 3;  

          } else {
            general_debug_fsm_h.m_lane_no[0] = (a_cm_no == 0) ? 0 : 2;
            general_debug_fsm_h.m_lane_no[1] = (a_cm_no == 0) ? 0 : 2;
          }

          general_debug_fsm_h.m_average_cnt   = gPmdConfigBlock.m_tsense_average_cnt;
          general_debug_fsm_h.m_trim_code     = ((int32_t) gPmdConfigBlock.m_tsense_trim_code);
    
          general_debug_fsm_busy              = 1;  
          general_debug_fsm_h.current_state   = GENERAL_DEBUG_TSENSE_ST ; 
          
          vp_pmd_cm->m_vctl_temp_meas_in_prog = true;

          vp_pmd_cm->m_pll_fw_cmd1_b4_pllcal_st = e_pll_fw_cmd1_b4_pllcal_pgm_vctl_st;
          

        } else {
          vp_pmd_cm->m_pll_fw_cmd1_b4_pllcal_st = e_pll_fw_cmd1_b4_pllcal_meas_temp_st; 
          break;
        }

      } else {  

        gCmConfigBlock[a_cm_no].m_s2c_meas_temp = gCmConfigBlock[a_cm_no].m_s2c_temp_in;

        vp_pmd_cm->m_vctl_temp_meas_in_prog   = false;
        vp_pmd_cm->m_pll_fw_cmd1_b4_pllcal_st = e_pll_fw_cmd1_b4_pllcal_pgm_vctl_st;
        
      }
    }

    case e_pll_fw_cmd1_b4_pllcal_pgm_vctl_st: {
	    if (vp_pmd_cm->m_vctl_temp_meas_in_prog == false) {
        if ((vp_cm->m_pll_mode == e_pcie_mode) && (gCmConfigBlock[a_cm_no].m_vco_vctrl_update_en == 1)) {
  
        } else { 
		      cm__pll_pgm_vctl(a_cm_no);
	        vp_pmd_cm->m_pll_fw_cmd1_b4_pllcal_st = e_pll_fw_cmd1_b4_pllcal_host_brk_pnt_st;    
	      }

	    } else {
		    vp_pmd_cm->m_pll_fw_cmd1_b4_pllcal_st = e_pll_fw_cmd1_b4_pllcal_pgm_vctl_st;          
        break;
      }
    }

    case e_pll_fw_cmd1_b4_pllcal_host_brk_pnt_st: {

      if (vp_pmd_cm->m_pll_brk_pnt_en) {
        v_flag = pmd_cm__pll_fw_cmd1_b4_pllcal_host_brk_pnt (a_cm_no);

      } else {
        v_flag = true;
      }

      if (v_flag) {
        v_done = v_flag;
        vp_pmd_cm->m_pll_fw_cmd1_b4_pllcal_st = e_pll_fw_cmd1_b4_pllcal_init_st;
        break;


      } else {
        vp_pmd_cm->m_pll_fw_cmd1_b4_pllcal_st = e_pll_fw_cmd1_b4_pllcal_host_brk_pnt_st; 
        break;
      }
    }







    default: {
      v_done = true;
