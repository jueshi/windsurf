#include <stdint.h>
#include <stdio.h>



#define READ_CCM(_a_offset_addr_)           (*((volatile uint32_t *) (CPU_CCM_BASE_ADDR + _a_offset_addr_)))

#define WRITE_CCM(_a_offset_addr_, _a_val_) (*((volatile uint32_t *) (CPU_CCM_BASE_ADDR + _a_offset_addr_)) = (_a_val_))






#define READ_REG( _a_base_addr_, _a_offset_addr_ )                ( *((volatile uint32_t *) (CPU_REG_BASE_ADDR + _a_base_addr_ + _a_offset_addr_)) )

#define WRITE_REG( _a_base_addr_, _a_offset_addr_, _a_reg_val_ )  ( *((volatile uint32_t *) (CPU_REG_BASE_ADDR + _a_base_addr_ + _a_offset_addr_)) = (_a_reg_val_) )



#define READ_REG_FIELD( _a_base_addr_, _a_reg_field_ )                  (  ( (READ_REG( _a_base_addr_, _a_reg_field_##__ADDR )) & (_a_reg_field_##__MASK) )  >>  (_a_reg_field_##__SHIFT)  )

#define WRITE_REG_FIELD( _a_base_addr_, _a_reg_field_, _a_field_val_ )  \
do                                                                      \
{                                                                       \
	volatile uint32_t _v_reg_val_;                                        \
                                                                        \
