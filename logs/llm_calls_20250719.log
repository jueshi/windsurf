void funcFtffeInitialise (uint8_t fsm_no) {
  uint8_t vLaneNo = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;

  rx_t *vp_rx = &g_rx[vLaneNo];

  union tPmdLaneRxRxFwCsr10RxFwSpare1_t vPmdLaneRxRxFwCsr10RxFwSpare1;

  
    vPmdLaneRxRxFwCsr10RxFwSpare1.reg = READ_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR10__RX_FW_SPARE1_21_0);
    gFtffeTapEn[vLaneNo] = vPmdLaneRxRxFwCsr10RxFwSpare1.fields.mRxXFwFtffeTapEn;

  gFtffeTapEn[vLaneNo] = gRxLaneConfigBlock[vLaneNo].m_low_power_mode ? gRxLaneConfigBlock[vLaneNo].m_ffe_float_tap_en : gFtffeTapEn[vLaneNo];  
  

  gFtffeIterMax = (vp_rx->m_rx_mode == 1) ? 4 : 2 ;    

  
  if (gRxLaneConfigBlock[vLaneNo].m_low_power_mode) {
    WRITE_REG_FIELD (g_rx_base_addr_lut[vLaneNo], RX__FFE_CONFIG0__FFE_FLOAT_COEFF_EN_8_0, gRxLaneConfigBlock[vLaneNo].m_ffe_float_coeff_en);
  } else {
    WRITE_REG_FIELD (g_rx_base_addr_lut[vLaneNo], RX__FFE_CONFIG0__FFE_FLOAT_COEFF_EN_8_0, 0x1FF);
  }
 
  pmd_lane_fsm_h[vLaneNo].corr_coll_iter = 0 ;  

  handler_func_pntr[fsm_no] = eRxHandlerSt_FtffeCorrCollEn; 
}

void funcFtffeCorrCollEn (uint8_t fsm_no) {
  uint8_t vLaneNo = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;
  uint8_t vDone, vPollCntr;

  if (gFwRxXAdaptPrevSt[vLaneNo] == 0) {

  
  g_reg_val = READ_REG (g_rx_base_addr, RX__FFE_TRAINING12__ADDR);
  SET_FIELD (g_reg_val, RX__FFE_TRAINING12__FFE_FLOATING_GROUP0_TAP0_MUX_SEL_3_0, 3*pmd_lane_fsm_h[vLaneNo].corr_coll_iter); 
  SET_FIELD (g_reg_val, RX__FFE_TRAINING12__FFE_FLOATING_GROUP0_TAP1_MUX_SEL_3_0, 3*pmd_lane_fsm_h[vLaneNo].corr_coll_iter); 
  SET_FIELD (g_reg_val, RX__FFE_TRAINING12__FFE_FLOATING_GROUP0_TAP2_MUX_SEL_3_0, 3*pmd_lane_fsm_h[vLaneNo].corr_coll_iter); 
  SET_FIELD (g_reg_val, RX__FFE_TRAINING12__FFE_FLOATING_GROUP1_TAP0_MUX_SEL_3_0, 3*pmd_lane_fsm_h[vLaneNo].corr_coll_iter); 
  SET_FIELD (g_reg_val, RX__FFE_TRAINING12__FFE_FLOATING_GROUP1_TAP1_MUX_SEL_3_0, 3*pmd_lane_fsm_h[vLaneNo].corr_coll_iter); 
  SET_FIELD (g_reg_val, RX__FFE_TRAINING12__FFE_FLOATING_GROUP1_TAP2_MUX_SEL_3_0, 3*pmd_lane_fsm_h[vLaneNo].corr_coll_iter); 
  WRITE_REG (g_rx_base_addr, RX__FFE_TRAINING12__ADDR, g_reg_val);

  g_reg_val = READ_REG (g_rx_base_addr, RX__FFE_TRAINING13__ADDR);
  SET_FIELD (g_reg_val, RX__FFE_TRAINING13__FFE_FLOATING_GROUP2_TAP0_MUX_SEL_3_0, 3*pmd_lane_fsm_h[vLaneNo].corr_coll_iter); 
  SET_FIELD (g_reg_val, RX__FFE_TRAINING13__FFE_FLOATING_GROUP2_TAP1_MUX_SEL_3_0, 3*pmd_lane_fsm_h[vLaneNo].corr_coll_iter); 
  SET_FIELD (g_reg_val, RX__FFE_TRAINING13__FFE_FLOATING_GROUP2_TAP2_MUX_SEL_3_0, 3*pmd_lane_fsm_h[vLaneNo].corr_coll_iter); 
  WRITE_REG (g_rx_base_addr, RX__FFE_TRAINING13__ADDR, g_reg_val);

  
  WRITE_REG_FIELD (g_rx_base_addr, RX__FFE_TRAINING1__FFE_FLOATING_TAP_MUX_SEL_UPDATE, 0x1); 
  }

  if ((gFwRxXAdaptPrevSt[vLaneNo] == 0) || (gFwRxXAdaptPrevSt[vLaneNo] == 7)) {
    
    vPollCntr = 0;
    do{
      vDone = READ_REG_FIELD (g_rx_base_addr, RX__STATUS9__FFE_FLOATING_MUX_SEL_UPDATE_DONE);
      vPollCntr++;
    } while ((vDone == 0) && (vPollCntr < 10));
    
    if ((vDone == 0) && (vPollCntr == 10)) {
      gFwRxXAdaptPrevSt[vLaneNo] = 7;
      return;
    } else {
      gFwRxXAdaptPrevSt[vLaneNo] = 0;
    }

    
    WRITE_REG_FIELD (g_rx_base_addr, RX__FFE_TRAINING1__FFE_FLOATING_TAP_MUX_SEL_UPDATE, 0x0);
  }
  
  if ((gFwRxXAdaptPrevSt[vLaneNo] == 0) || (gFwRxXAdaptPrevSt[vLaneNo] == 8)) {
    
    vPollCntr = 0;
    do{
      vDone = READ_REG_FIELD (g_rx_base_addr, RX__STATUS9__FFE_FLOATING_MUX_SEL_UPDATE_DONE);
      vPollCntr++;
    } while ((vDone == 1) && (vPollCntr < 10));
    
    if ((vDone == 1) && (vPollCntr == 10)) {
      gFwRxXAdaptPrevSt[vLaneNo] = 8;
      return;
    } else {
      gFwRxXAdaptPrevSt[vLaneNo] = 0;
    }

    
    WRITE_REG_FIELD (g_rx_base_addr, RX__FFE_TRAINING1__FFE_FLOATING_TAP_CORR_EN, 0x1);
  }

  handler_func_pntr[fsm_no] = eRxHandlerSt_FtffeCorrDone; 
}

void funcFtffeCorrDone  (uint8_t fsm_no) {
  uint8_t vLaneNo = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;

  rx_t *vp_rx = &g_rx[vLaneNo];

  uint8_t vDone=0; 
  uint8_t start_pntr=0;
  uint8_t vPollCntr;

  if ((gFwRxXAdaptPrevSt[vLaneNo] == 9) || (gFwRxXAdaptPrevSt[vLaneNo] == 10) || (gFwRxXAdaptPrevSt[vLaneNo] == 11) || (gFwRxXAdaptPrevSt[vLaneNo] == 12)) {
    vDone = 1;

  } else {
    vDone = READ_REG_FIELD (g_rx_base_addr, RX__STATUS9__FFE_FLOATING_TAP_CORR_DONE) ;
  }

  if (vDone == 0) {
    handler_func_pntr[fsm_no] = eRxHandlerSt_FtffeCorrDone; 

  } else {
    if ((gFwRxXAdaptPrevSt[vLaneNo] == 0) || (gFwRxXAdaptPrevSt[vLaneNo] == 9)) {
      
      
      start_pntr = pmd_lane_fsm_h[vLaneNo].corr_coll_iter*9 ; 
      
      
      if (vp_rx->m_rx_mode == 1 || (vp_rx->m_rx_mode == 0 && start_pntr<18)) { 
         g_reg_val = READ_REG_FIELD (g_rx_base_addr, RX__STATUS13__CORR_ACC_TAP0_21_0) ; 
         pmd_lane_fsm_h[vLaneNo].corr_array[start_pntr] = sign2abs (g_reg_val, RX_CORR_ACC_WIDTH) ; 
         g_reg_val = READ_REG_FIELD (g_rx_base_addr, RX__STATUS14__CORR_ACC_TAP1_21_0) ; 
         pmd_lane_fsm_h[vLaneNo].corr_array[start_pntr+1] = sign2abs (g_reg_val, RX_CORR_ACC_WIDTH) ; 
         g_reg_val = READ_REG_FIELD (g_rx_base_addr, RX__STATUS15__CORR_ACC_TAP2_21_0) ; 
         pmd_lane_fsm_h[vLaneNo].corr_array[start_pntr+2] = sign2abs (g_reg_val, RX_CORR_ACC_WIDTH) ; 
         g_reg_val = READ_REG_FIELD (g_rx_base_addr, RX__STATUS16__CORR_ACC_TAP3_21_0) ; 
         pmd_lane_fsm_h[vLaneNo].corr_array[start_pntr+3] = sign2abs (g_reg_val, RX_CORR_ACC_WIDTH) ; 
         g_reg_val = READ_REG_FIELD (g_rx_base_addr, RX__STATUS17__CORR_ACC_TAP4_21_0) ; 
         pmd_lane_fsm_h[vLaneNo].corr_array[start_pntr+4] = sign2abs (g_reg_val, RX_CORR_ACC_WIDTH) ; 
         g_reg_val = READ_REG_FIELD (g_rx_base_addr, RX__STATUS18__CORR_ACC_TAP5_21_0) ; 
         pmd_lane_fsm_h[vLaneNo].corr_array[start_pntr+5] = sign2abs (g_reg_val, RX_CORR_ACC_WIDTH) ; 
         g_reg_val = READ_REG_FIELD (g_rx_base_addr, RX__STATUS19__CORR_ACC_TAP6_21_0) ; 
         pmd_lane_fsm_h[vLaneNo].corr_array[start_pntr+6] = sign2abs (g_reg_val, RX_CORR_ACC_WIDTH) ; 
         g_reg_val = READ_REG_FIELD (g_rx_base_addr, RX__STATUS20__CORR_ACC_TAP7_21_0) ; 
         pmd_lane_fsm_h[vLaneNo].corr_array[start_pntr+7] = sign2abs (g_reg_val, RX_CORR_ACC_WIDTH) ; 
         g_reg_val = READ_REG_FIELD (g_rx_base_addr, RX__STATUS21__CORR_ACC_TAP8_21_0) ; 
         pmd_lane_fsm_h[vLaneNo].corr_array[start_pntr+8] = sign2abs (g_reg_val, RX_CORR_ACC_WIDTH) ; 

      } else if (vp_rx->m_rx_mode == 0 && start_pntr == 18){
         g_reg_val = READ_REG_FIELD (g_rx_base_addr, RX__STATUS13__CORR_ACC_TAP0_21_0) ; 
         pmd_lane_fsm_h[vLaneNo].corr_array[start_pntr] = sign2abs (g_reg_val, RX_CORR_ACC_WIDTH) ; 
         g_reg_val = READ_REG_FIELD (g_rx_base_addr, RX__STATUS14__CORR_ACC_TAP1_21_0) ; 
         pmd_lane_fsm_h[vLaneNo].corr_array[start_pntr+1] = sign2abs (g_reg_val, RX_CORR_ACC_WIDTH) ; 
         g_reg_val = READ_REG_FIELD (g_rx_base_addr, RX__STATUS15__CORR_ACC_TAP2_21_0) ; 
         pmd_lane_fsm_h[vLaneNo].corr_array[start_pntr+2] = sign2abs (g_reg_val, RX_CORR_ACC_WIDTH) ; 
      }

      
      WRITE_REG_FIELD (g_rx_base_addr, RX__FFE_TRAINING1__FFE_FLOATING_TAP_CORR_EN, 0x0);
    }
    
    if ((gFwRxXAdaptPrevSt[vLaneNo] == 0) || (gFwRxXAdaptPrevSt[vLaneNo] == 12)) {
      vPollCntr = 0;
      do {
        vDone = READ_REG_FIELD (g_rx_base_addr, RX__STATUS9__FFE_FLOATING_TAP_CORR_DONE) ;
        vPollCntr++;
      } while ((vDone==1) && (vPollCntr == 10));   
 
      if ((vDone==1) && (vPollCntr == 10)) {
        gFwRxXAdaptPrevSt[vLaneNo] = 12;
        return;
      } else {
        gFwRxXAdaptPrevSt[vLaneNo] = 0;
      }
    }
    
    if (pmd_lane_fsm_h[vLaneNo].corr_coll_iter == gFtffeIterMax) {
      pmd_lane_fsm_h[vLaneNo].corr_coll_iter = 0 ;
      handler_func_pntr[fsm_no] = eRxHandlerSt_FtffeTapSel; 
    } else {
      pmd_lane_fsm_h[vLaneNo].corr_coll_iter = pmd_lane_fsm_h[vLaneNo].corr_coll_iter+1;
      handler_func_pntr[fsm_no] = eRxHandlerSt_FtffeCorrCollEn; 
    }
  }
} 

void funcFtffeTapSelection (uint8_t fsm_no) {
  uint8_t vLaneNo = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;

  rx_t *vp_rx = &g_rx[vLaneNo];

  uint32_t position_sorted_array[NUM_FTAPS] ; 
  uint32_t isi_3tap_sum_array [NUM_FTAPS] ; 
  uint8_t isi_3tap_sum_array_size ; 
  uint8_t g0t0, g1t0, g2t0 ; 
  uint8_t g1t0_sel_done = 0 ;
  uint8_t g2t0_sel_done = 0 ;
  uint8_t start_pntr = 0 ; 
  uint32_t temp_isi ; 
  uint8_t temp_isi_index ; 

  uint8_t algo_type = 0 ;
  uint8_t algo_type_1_done = 1 ; 


  algo_type = gRxLaneConfigBlock[vLaneNo].m_ftffe_type;

  if (algo_type == 0) {
    isi_3tap_sum_array_size = vp_rx->m_rx_mode == 1 ? 43 : 19 ; 
  } else {
    isi_3tap_sum_array_size = vp_rx->m_rx_mode == 1 ? 45 : 21 ; 
  }
  for (uint8_t i=0; i<isi_3tap_sum_array_size; i++) {
    isi_3tap_sum_array[i] = algo_type == 0 ? (pmd_lane_fsm_h[vLaneNo].corr_array[i] + pmd_lane_fsm_h[vLaneNo].corr_array[i+1] + pmd_lane_fsm_h[vLaneNo].corr_array[i+2]) : pmd_lane_fsm_h[vLaneNo].corr_array[i] ; 
    position_sorted_array[i] = i  ;
  }

  
  for (uint8_t i=0; i<isi_3tap_sum_array_size; i++) {
    for (uint8_t j=i+1; j<isi_3tap_sum_array_size; j++) {
      if (isi_3tap_sum_array[j]>isi_3tap_sum_array[i]) {
        temp_isi = isi_3tap_sum_array[i] ;
        temp_isi_index = position_sorted_array[i] ; 
        isi_3tap_sum_array[i] = isi_3tap_sum_array[j] ; 
        position_sorted_array[i] = position_sorted_array[j] ; 
        isi_3tap_sum_array[j] = temp_isi ; 
        position_sorted_array[j] = temp_isi_index ; 
      }
    }
  }
  if (algo_type == 0) {
    g0t0 = position_sorted_array[0] ; 
    g1t0 = position_sorted_array[1] ; 
    g2t0 = position_sorted_array[2] ;
    start_pntr = 1 ; 

    while ((g1t0_sel_done == 0 || g2t0_sel_done == 0) && ((start_pntr+1) < isi_3tap_sum_array_size)) {
      if ((abs(g0t0-g1t0)>=3) && (g1t0_sel_done == 0)) { 
        g1t0_sel_done = 1 ;
      }
      if ((abs(g0t0-g2t0)>=3) && (abs(g1t0-g2t0)>=3) && (g2t0_sel_done == 0) && (g1t0_sel_done == 1)) { 
        g2t0_sel_done = 1 ;
      }
      if (g1t0_sel_done == 0) { 
        start_pntr = start_pntr+1 ; 
        g1t0 = position_sorted_array[start_pntr] ; 
        g2t0 = position_sorted_array[start_pntr+1] ;
      } else { 
        if (g2t0_sel_done == 0) {
          start_pntr = start_pntr +1 ; 
          g2t0 = position_sorted_array[start_pntr+1] ; 
        }
      }
    }
  } 
 
  if (((g1t0_sel_done == 0 || g2t0_sel_done == 0) && (algo_type == 0)) || ((algo_type_1_done == 0) && (algo_type == 1))) {
    gRxLaneConfigBlock[vLaneNo].m_ftffe_error = 0x1;

    g0t0=0;
    g1t0=3;
    g2t0=6;
  }

  if (algo_type == 0) {
    for (uint8_t i=0; i<3; i++) {
      pmd_lane_fsm_h[vLaneNo].g0[(g0t0+i)%3] = g0t0+i ; 
      pmd_lane_fsm_h[vLaneNo].g1[(g1t0+i)%3] = g1t0+i ; 
      pmd_lane_fsm_h[vLaneNo].g2[(g2t0+i)%3] = g2t0+i ; 
    }
  } 



  
  g_reg_val = READ_REG (g_rx_base_addr, RX__FFE_TRAINING12__ADDR);
  SET_FIELD (g_reg_val, RX__FFE_TRAINING12__FFE_FLOATING_GROUP0_TAP0_MUX_SEL_3_0, g0t0_array[pmd_lane_fsm_h[vLaneNo].g0[0]]);
  SET_FIELD (g_reg_val, RX__FFE_TRAINING12__FFE_FLOATING_GROUP0_TAP1_MUX_SEL_3_0, g0t1_array[pmd_lane_fsm_h[vLaneNo].g0[1]]); 
  SET_FIELD (g_reg_val, RX__FFE_TRAINING12__FFE_FLOATING_GROUP0_TAP2_MUX_SEL_3_0, g0t2_array[pmd_lane_fsm_h[vLaneNo].g0[2]]); 
  SET_FIELD (g_reg_val, RX__FFE_TRAINING12__FFE_FLOATING_GROUP1_TAP0_MUX_SEL_3_0, g1t0_array[pmd_lane_fsm_h[vLaneNo].g1[0]]); 
  SET_FIELD (g_reg_val, RX__FFE_TRAINING12__FFE_FLOATING_GROUP1_TAP1_MUX_SEL_3_0, g1t1_array[pmd_lane_fsm_h[vLaneNo].g1[1]]); 
  SET_FIELD (g_reg_val, RX__FFE_TRAINING12__FFE_FLOATING_GROUP1_TAP2_MUX_SEL_3_0, g1t2_array[pmd_lane_fsm_h[vLaneNo].g1[2]]); 
  WRITE_REG (g_rx_base_addr, RX__FFE_TRAINING12__ADDR, g_reg_val);

  g_reg_val = READ_REG (g_rx_base_addr, RX__FFE_TRAINING13__ADDR);
  SET_FIELD (g_reg_val, RX__FFE_TRAINING13__FFE_FLOATING_GROUP2_TAP0_MUX_SEL_3_0, g2t0_array[pmd_lane_fsm_h[vLaneNo].g2[0]]); 
  SET_FIELD (g_reg_val, RX__FFE_TRAINING13__FFE_FLOATING_GROUP2_TAP1_MUX_SEL_3_0, g2t1_array[pmd_lane_fsm_h[vLaneNo].g2[1]]); 
  SET_FIELD (g_reg_val, RX__FFE_TRAINING13__FFE_FLOATING_GROUP2_TAP2_MUX_SEL_3_0, g2t2_array[pmd_lane_fsm_h[vLaneNo].g2[2]]); 
  WRITE_REG (g_rx_base_addr, RX__FFE_TRAINING13__ADDR, g_reg_val);


  if (vp_rx->m_rx_mode==0) {
    

    
    uint8_t vRate = vp_rx->m_rx_rate;

    rx_adapt_seq[vLaneNo][vRate].ftffe_tap_mux_sel[0][0] = g0t0_array[pmd_lane_fsm_h[vLaneNo].g0[0]];
    rx_adapt_seq[vLaneNo][vRate].ftffe_tap_mux_sel[0][1] = g0t0_array[pmd_lane_fsm_h[vLaneNo].g0[1]];
    rx_adapt_seq[vLaneNo][vRate].ftffe_tap_mux_sel[0][2] = g0t0_array[pmd_lane_fsm_h[vLaneNo].g0[2]];
    rx_adapt_seq[vLaneNo][vRate].ftffe_tap_mux_sel[1][0] = g0t0_array[pmd_lane_fsm_h[vLaneNo].g1[0]];
    rx_adapt_seq[vLaneNo][vRate].ftffe_tap_mux_sel[2][1] = g0t0_array[pmd_lane_fsm_h[vLaneNo].g1[1]];
    rx_adapt_seq[vLaneNo][vRate].ftffe_tap_mux_sel[2][2] = g0t0_array[pmd_lane_fsm_h[vLaneNo].g1[2]];
    rx_adapt_seq[vLaneNo][vRate].ftffe_tap_mux_sel[2][0] = g0t0_array[pmd_lane_fsm_h[vLaneNo].g2[0]];
    rx_adapt_seq[vLaneNo][vRate].ftffe_tap_mux_sel[2][1] = g0t0_array[pmd_lane_fsm_h[vLaneNo].g2[1]];
    rx_adapt_seq[vLaneNo][vRate].ftffe_tap_mux_sel[2][2] = g0t0_array[pmd_lane_fsm_h[vLaneNo].g2[2]];
  }

  
  WRITE_REG_FIELD (g_rx_base_addr, RX__FFE_TRAINING1__FFE_FLOATING_TAP_MUX_SEL_UPDATE, 0x1) ;
 

  handler_func_pntr[fsm_no] = eRxHandlerSt_FtffeMuxSelUpdate; 
}

void funcFtffeMuxSelUpdate (uint8_t fsm_no) {
  uint8_t vLaneNo = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;

  rx_t *vp_rx = &g_rx[vLaneNo];

  uint8_t vDone, vPollCntr;
  
  if ((gFwRxXAdaptPrevSt[vLaneNo] == 13) || (gFwRxXAdaptPrevSt[vLaneNo] == 14) || (gFwRxXAdaptPrevSt[vLaneNo] == 15)) {
    g_reg_val = 1;
  } else {
    
    g_reg_val = READ_REG_FIELD (g_rx_base_addr, RX__STATUS9__FFE_FLOATING_MUX_SEL_UPDATE_DONE) ;
  }
  
  if (g_reg_val) { 
    if (gFwRxXAdaptPrevSt[vLaneNo] == 0) {
    
      
      WRITE_REG_FIELD (g_rx_base_addr, RX__FFE_TRAINING1__FFE_FLOATING_TAP_MUX_SEL_UPDATE, 0x0) ;
    }

    if ((gFwRxXAdaptPrevSt[vLaneNo] == 0) || (gFwRxXAdaptPrevSt[vLaneNo] == 15)) {
      vPollCntr = 0;
      do {
        vDone = READ_REG_FIELD (g_rx_base_addr, RX__STATUS9__FFE_FLOATING_MUX_SEL_UPDATE_DONE) ;
        vPollCntr++;
      } while ((vDone == 1) && (vPollCntr < 10));   

      if ((vDone == 1) && (vPollCntr == 10)) {
        gFwRxXAdaptPrevSt[vLaneNo] = 15;
        return;
      } else {
        gFwRxXAdaptPrevSt[vLaneNo] = 0;
      }
    }

    
    WRITE_REG_FIELD (g_rx_base_addr, RX__FFE_TRAINING1__FFE_FLOATING_TAP_EN_8_0, gFtffeTapEn[vLaneNo]) ;

    if(vp_rx->m_rx_mode==1) {       

      handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;

    } else {        
      handler_func_pntr[fsm_no] = eRxHandlerSt_PcieLtAdaptDone1;
    }

  } else { 
    handler_func_pntr[fsm_no] = eRxHandlerSt_FtffeMuxSelUpdate; 
  }
}


