void func_rx_check (uint8_t vLaneNo) {

  rx_t *vp_rx = &g_rx[vLaneNo];

  if (vp_rx->m_rx_mode == e_pcie_mode) { 
    if (gRxFwRptStrupCount[vLaneNo] == 4) {
      delay_ns(300);
      WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_REQ_I, 0x0);
      delay_ns(100);

      WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDEN0__OVRD_EN_RXX_REQ_I, 0x0);
      WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDEN1__OVRD_EN_RXX_ACK_O, 0x0);

      trigger_rx_ack_check[vLaneNo] = 0;
    }

  } else {
    func_rx_data_en(vLaneNo);
  }
}



void func_rx_data_en (uint8_t vLaneNo) {
  uint8_t rxX_ack_o, rxX_rdy_o;


  g_reg_val = READ_REG (g_pmd_lane_rx_base_addr,PMD_LANE_RX__PMD_RX_OVRDVAL3__ADDR);
  rxX_ack_o = GET_FIELD (g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL3__RXX_ACK_O);
  rxX_rdy_o = GET_FIELD (g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL3__RXX_RDY_O);

  if (rxX_rdy_o == 1 ) {
    if (gFwEthDoKr[vLaneNo] == 1) {
      g_reg_val = READ_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__FETX_FFE_TRAIN_CFG1__ADDR) ;
      SET_FIELD (g_reg_val, PMD_LANE_RX__FETX_FFE_TRAIN_CFG1__FW_GATE_RX_RDY, 0x1) ;
      WRITE_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__FETX_FFE_TRAIN_CFG1__ADDR, g_reg_val) ;
    } else {
      WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDEN1__OVRD_EN_LANEX_SIGNAL_OK_O, 0x0);
    }
    trigger_rx_ack_check[vLaneNo] = 0;
    
    g_dccm_time_stamp_rx[vLaneNo][e_dts_rx_31_rxx_rdy_1] = dump_rtc();
  } 

  if (rxX_rdy_o == 0 && rxX_ack_o == 0 &&  gFwLaneXSignalOk[vLaneNo] == 0) { 
    g_reg_val = READ_REG_FIELD(g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_RESET_I);
    if(g_reg_val == 0){   
      if (gFwEthDoAn[vLaneNo] == 0  ) {
        func_rx_assert_data_en (vLaneNo);
      }
    }
  }

}

void func_rx_fwcmd_idle_detect (uint8_t fsm_no) {
  
  uint8_t vLaneNo = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;
  uint8_t idle_exit, idle_entry;
  bool    v_bypass_idle_detect = false;
  
  rx_t *vp_rx = &g_rx[vLaneNo];
  
  g_reg_val = READ_REG_FIELD(g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_RESET_I);


  v_bypass_idle_detect = (g_reg_val == 1) || (g_do_pmix_inl_powerup == true && g_pmix_inl_cal_startup_done == false);
  if(v_bypass_idle_detect == true) {
    vp_rx->m_idle_detect_fsm_st = e_fsm_done_st;
  }
  
  
  switch (vp_rx->m_idle_detect_fsm_st) {
  
    case e_fsm_idle_st: {
      vp_rx->m_idle_detect_fsm_st = e_en_idle_detect_st;
      vp_rx->m_idle_detect_en = 0;
      vp_rx->m_idle_timer_en = 0;
      vp_rx->m_idle_exited = 0;
      vp_rx->m_idle_entry = 0;
      vp_rx->m_idle_timer_done = 0;
    }
  
    case e_en_idle_detect_st: {
  
      WRITE_REG_FIELD (g_rx_base_addr_lut[vLaneNo], RX__PIN_OVRDVAL2__INT_RX0_IDLE_DETECT_EN_I, 0x1);
      WRITE_REG_FIELD (g_rx_base_addr_lut[vLaneNo], RX__PIN_OVRDEN1__OVRD_EN_RX0_IDLE_DETECT_EN_I, 0x1);
      vp_rx->m_idle_detect_en = 1;
      vp_rx->m_idle_detect_fsm_st = e_wait_for_idle_exit_st;
    }
  
    case e_wait_for_idle_exit_st: {
      g_reg_val = READ_REG (g_pmd_lane_rx_base_addr_lut[vLaneNo], PMD_LANE_RX__INTR1__STAT_INTERRUPT_31_0__ADDR);
      idle_exit = (g_reg_val & 0x00002000)>>13;
  
      g_reg_val = READ_REG_FIELD (g_rx_base_addr_lut[vLaneNo], RX__PIN_OVRDVAL2__INT_RX0_IDLE_O); 
  
      if (idle_exit == 1 || g_reg_val == 0){  
        WRITE_REG (g_pmd_lane_rx_base_addr_lut[vLaneNo], PMD_LANE_RX__INTR_CLR1__CLR_INTERRUPT_31_0__ADDR, 0x00002000);
        WRITE_REG (g_pmd_lane_rx_base_addr_lut[vLaneNo], PMD_LANE_RX__INTR_CLR1__CLR_INTERRUPT_31_0__ADDR, 0x00000000);
  
        delay_start (&vp_rx->m_idle_timer, gRxLaneConfigBlock[vLaneNo].m_idle_timer_delay);
  
  
        vp_rx->m_idle_exited = 1;
        vp_rx->m_idle_entry = 0;
        vp_rx->m_idle_timer_en = 1; 
        vp_rx->m_idle_detect_fsm_st = e_wait_for_timer_done_st;
      }
      break;
    }

    case e_wait_for_timer_done_st: {
      g_reg_val = READ_REG (g_pmd_lane_rx_base_addr_lut[vLaneNo], PMD_LANE_RX__INTR1__STAT_INTERRUPT_31_0__ADDR);
      idle_entry = (g_reg_val & 0x00004000)>>14;
  
      g_reg_val = READ_REG_FIELD (g_rx_base_addr_lut[vLaneNo], RX__PIN_OVRDVAL2__INT_RX0_IDLE_O); 
  
      if (idle_entry == 1 || g_reg_val == 1) {  
        WRITE_REG (g_pmd_lane_rx_base_addr_lut[vLaneNo], PMD_LANE_RX__INTR_CLR1__CLR_INTERRUPT_31_0__ADDR, 0x00004000);
        WRITE_REG (g_pmd_lane_rx_base_addr_lut[vLaneNo], PMD_LANE_RX__INTR_CLR1__CLR_INTERRUPT_31_0__ADDR, 0x00000000);
  
        delay_cancel(&vp_rx->m_idle_timer);
        vp_rx->m_idle_exited = 0;
        vp_rx->m_idle_timer_en = 0;
        vp_rx->m_idle_entry = 1;
        vp_rx->m_idle_detect_fsm_st = e_wait_for_idle_exit_st;
      
      } else {
        if (delay_is_done(&vp_rx->m_idle_timer)) {
          vp_rx->m_idle_timer_done = 1;
          vp_rx->m_idle_detect_fsm_st = e_fsm_done_st;
  
          g_reg_val = READ_REG_FIELD (g_rx_base_addr_lut[vLaneNo], RX__STATUS2__ADC_DATA_PEAK_6_0);
          gRxLaneConfigBlock[vLaneNo].m_idle_exit_adc_data_peak = g_reg_val ;
  
          if (gFwEthDoAn[vLaneNo] == 0) {
            
            if (vp_rx->m_pr_mode_en == 1 && gRxLaneConfigBlock[vLaneNo].m_force_disable_pr_mode == 0) {
              rx__pr_mode_cfg (vLaneNo);
            }
  
            if ((gRxLaneConfigBlock[vLaneNo].m_mlsd_en == 1) && (gRxLaneConfigBlock[vLaneNo].m_mlsd_prestartup0_poststartup1 == 0)) {
              rx__mlsd_config (vLaneNo);
            }
          }
        }
      }
      break;
    }
    case e_fsm_done_st: {
      vp_rx->m_idle_detect_fsm_st = e_fsm_idle_st;
      handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
      break;
    }
  }

}

bool func_rx_assert_data_en (uint8_t vLaneNo) {

  rx_t *vp_rx = &g_rx[vLaneNo];
  bool v_done = false;

  if (READ_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR13__FW_ETH_HOLD_RXX_ADAPT_START ) != 1) {


    func_do_adapt (vLaneNo, 0 , 0);

  

  if (g_rx[vLaneNo].m_skip_startup_adapts == 0) { 
    if (gFwEthDoKr[vLaneNo] == 0) {  

      WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_DATA_EN_I, 1);
      WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDEN0__OVRD_EN_RXX_DATA_EN_I, 1);

    } else {
      func_rx_fast_krt_en (vLaneNo);
    }
  }
  v_done = true;

  vp_rx->m_rxX_data_en_done = true;

  if(vp_rx->m_rx_ne_serial_lpbk_en == true) { 
    trigger_rx_ack_check[vLaneNo] = 1;
    gFwLaneXSignalOk[vLaneNo] = 1;
  } else { 
    trigger_rx_ack_check[vLaneNo] = 0;
  }
 } 

  return v_done;
}



void func_rx_fast_krt_en (uint8_t vLaneNo) {
  
  if (g_fw_fastsim_en == 0 || (g_fw_fastsim_en == 1 && g_fw_ufastsim_0_fastsim_1 == 1)) {
    WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__KRT_OVRD_VAL0__PMD_KRT_TRAIN_EN, 0x1) ;
    WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__KRT_OVRD_EN1__OVRD_EN_PMD_KRT_TRAIN_EN, 0x1) ;
  }

  WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_DATA_EN_I, 1);
  WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDEN0__OVRD_EN_RXX_DATA_EN_I, 1);
  
  do {
    g_reg_val = READ_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__BASER_PMD_CONTROL__RESTART_TRAINING);
  } while (g_reg_val == 1);
  
  gFwLaneXSignalOk[vLaneNo] = 1;
  WRITE_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDEN1__OVRD_EN_LANEX_SIGNAL_OK_O, 0x0);  

}


void funcRxStrtupAdapt (uint8_t fsm_no) {
  uint8_t vLaneNo = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;
  
  rx_t *vp_rx = &g_rx[vLaneNo];

  if (vp_rx->m_rx_mode == e_pcie_mode) { 
    handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
    
  } else { 
    g_reg_val = READ_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_PWR_CTL_STAT__STATE_CNT_4_0); 

    if (g_reg_val == eRxEthAdaptFwCmdSt5_krt && gKrtFlag[vLaneNo] == 1) { 
      handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
      return;
    }
    
   switch (g_reg_val) {
      case (eRxEthAdaptFwCmdSt2_InlCorr): {
              handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
              break;
      }
      case (eRxEthAdaptFwCmdSt4_CtleGainAdjust): {
              funcRxCtleGainAdjust (fsm_no);  
              break;
      }
      case (eRxEthAdaptFwCmdSt5_krt): {   
              handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
              break;
      }
      case (eRxEthAdaptFwCmdSt6_Ftffe): {
              funcFtffeInitialise (fsm_no);
              break;
      }
      case (eRxEthAdaptFwCmdSt8_ShortChnlCtleBoost): {
      			  funcRxShortChnlCtleBoostAdj (fsm_no);
			        break;
      }
      case (eRxEthAdaptFwCmdSt9_CtleLutReload): {
        handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
        break;
      }
      case (eRxEthAdaptFwCmdSt31_Cca): {
              pmd_rx__eth_cca_init (fsm_no);  
              break;
      }
      default: {
              handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
              break;
      }
    } 

  }
}

void funcRxShortChnlCtleBoostAdj (uint8_t fsm_no) {




  handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
}

void funcRxCtleGainAdjust (uint8_t fsm_no) {
  uint8_t  v_lane_no = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;

  gRxRepeatStrupAdaptFlag[v_lane_no] = 0;

   if (gRxCtleGainAdjustDone[v_lane_no] == 0) {
    rx__ctle_gain_adjust (v_lane_no) ; 
   } 
    if (gRxRepeatStrupAdaptFlag[v_lane_no] == 1) {
      gCcaAdaptStartMode[v_lane_no] = 1;
      gCcaAdaptEndMode[v_lane_no] = g_fw_fastsim_en ? 3 : 6;
      gPostRxAdaptFuncSt[v_lane_no] = eRxHandlerSt_RxCtleGainAdjust ;
      handler_func_pntr[fsm_no] = eRxHandlerSt_RxCcaAdaptEn ; 
    } else {
      gRxCtleGainAdjustDone[v_lane_no] = 0;
      handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
    }
}


void pmd_rx__eth_cca_init (uint8_t fsm_no) {

  uint8_t v_lane_no = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;
  bool v_cca_en, v_cca_en_gated;

  rx_t *vp_rx = &g_rx[v_lane_no];

  v_cca_en = READ_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR13__RXX_FW_CCA_EN );

  v_cca_en_gated = (v_cca_en && vp_rx->m_rx_internal_cca_en) ? true : false;

  
  if (v_cca_en_gated == 1) { 







    handler_func_pntr[fsm_no] = eRxHandlerSt_CcaMisMode ;

  } else {  
    gFwLaneXSignalOk[v_lane_no] = 1;
    trigger_rx_ack_check[v_lane_no] = 1; 
    


    handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
  }
}


void funcRxPcieCcaInit (uint8_t fsm_no) {
  uint8_t vLaneNo = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;
  bool v_cca_en_gated;

  rx_t *vp_rx = &g_rx[vLaneNo];

  g_reg_val = READ_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR13__RXX_FW_CCA_EN );
  
  v_cca_en_gated = (g_reg_val && vp_rx->m_rx_internal_cca_en) ? true : false;

  if (v_cca_en_gated == 1) { 
    WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_LANE_CFG1__RX_CCA_IDLE_TIME_X64K_11_0, 0x1);

    WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR1__RX_NO_CCA_FW_CTL, 0x0);
    cca_loop_entered [vLaneNo] = 0 ; 
    non_first_cca_entry[vLaneNo] = 0 ; 

  } else {  
     WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR1__RX_NO_CCA_FW_CTL, 0x1);
  }

  handshake_fsm_st[fsm_no]=2; 
}


void pmd_rx__cca (uint8_t fsm_no) {

  uint8_t v_lane_no = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;
  rx_t *vp_rx = &g_rx[v_lane_no];

  bool v_cca_cal_done = false, v_fom_snr_cm1_adapt_done = false;
  bool v_fw_req = false, v_lane_margin_req = false;
  uint8_t v_fw_req_type;

    vp_rx->m_rx_cca_abort = !(READ_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_DATA_EN_I ));
    if (vp_rx->m_rx_cca_abort && vp_rx->m_rx_cca_non_first_entry) { 
      vp_rx->m_rx_cca_st = e_rx_cca_abort;
    } else if (!vp_rx->m_rx_cca_abort && vp_rx->m_rx_cca_non_first_entry) { 
      g_reg_val = READ_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR10__ADDR);
      v_fw_req  = GET_FIELD (g_reg_val, PMD_LANE_RX__RX_FW_CSR10__RX_FW_REQ);
      v_fw_req_type = GET_FIELD(g_reg_val, PMD_LANE_RX__RX_FW_CSR10__RX_FW_REQ_TYPE_2_0);
      v_lane_margin_req = v_fw_req && (v_fw_req_type == eRxHandlerReqType_LaneMargin); 
    }

    g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR13__ADDR );
    vp_rx->m_rx_cca_cal_inner_loop_cnt = GET_FIELD( g_reg_val, PMD_LANE_RX__RX_FW_CSR13__RXX_FW_CCA_CAL_REPEAT_CNT_7_0 );
    gRxLaneConfigBlock[v_lane_no].m_cca_pause  = GET_FIELD( g_reg_val, PMD_LANE_RX__RX_FW_CSR13__RXX_FW_CCA_PAUSE ) | v_lane_margin_req;


  vp_rx->m_rx_cca_cal_inner_loop_cnt = (vp_rx->m_rx_cca_cal_inner_loop_cnt == 0) ? 1 : vp_rx->m_rx_cca_cal_inner_loop_cnt;



  switch (vp_rx->m_rx_cca_st) {

    case e_rx_cca_first_cfg: {
      if (g_fw_fastsim_en == 0) {
        WRITE_REG_FIELD (g_rx_base_addr, RX__DIG_OVRDVAL33__DIG_CDR_LOCK_DETECT_EN_MODE_CTRL, 0x1);
      }
        
      rx__wa_ctle_deq_fix_ctle_cca (v_lane_no);

      vp_rx->m_rx_cca_abort = false;
      vp_rx->m_rx_cca_non_first_entry = false;
      vp_rx->m_rx_cca_st = e_rx_cca_cals;
    }

  case e_rx_cca_cals: {

      v_cca_cal_done = rx__cca_cals (v_lane_no);

      if (vp_rx->m_rx_cca_non_first_entry && (gRxLaneConfigBlock[v_lane_no].m_rx_parallel_cca_en == 1)) { 
        vp_rx->m_rx_cca_st = e_rx_cca_fom_snr_cm1_adapt;
      } else { 
        if (v_cca_cal_done) {
          vp_rx->m_rx_cca_st = e_rx_cca_fom_snr_cm1_adapt;
        } else {
          vp_rx->m_rx_cca_st = e_rx_cca_cals;
          break;
        }
      }

    }

    case e_rx_cca_fom_snr_cm1_adapt: {

      v_fom_snr_cm1_adapt_done = rx__cca_fom_cm1_adapt (v_lane_no);

      if (vp_rx->m_rx_cca_non_first_entry && (gRxLaneConfigBlock[v_lane_no].m_rx_parallel_cca_en == 1)) { 
        vp_rx->m_rx_cca_st = e_rx_cca_done;
      } else { 

        if (v_fom_snr_cm1_adapt_done) {

          if(vp_rx->m_rx_cca_non_first_entry == false) { 
            if ((gRxLaneConfigBlock[v_lane_no].m_mlsd_en == 1) && (gRxLaneConfigBlock[v_lane_no].m_mlsd_prestartup0_poststartup1 == 1)) {
              rx__mlsd_config (v_lane_no);
            }
            
        
            if (vp_rx->m_rx_mode == e_eth_mode) { 
              gFwLaneXSignalOk[v_lane_no] = 1;
              trigger_rx_ack_check[v_lane_no] = 1; 
            }

            do {
              rx_handler_ack_gen (fsm_no);
            } while (handshake_fsm_st[fsm_no] != e_pmd_handler_idle_st);
          }

          vp_rx->m_rx_cca_st = e_rx_cca_done;
        } else {
          vp_rx->m_rx_cca_st = e_rx_cca_fom_snr_cm1_adapt;
          break;
        }
      }

    }

    case e_rx_cca_done: {

      if (vp_rx->m_rx_cca_non_first_entry == false) {
        handshake_fsm_st[fsm_no] = e_pmd_handler_req_st;
        handler_func_pntr[fsm_no] = eRxHandlerSt_CcaMisMode ;  
      }

      vp_rx->m_rx_cca_non_first_entry = true;

      vp_rx->m_rx_cca_st = e_rx_cca_cals;
      break;
    }

    case e_rx_cca_abort: {

      vp_rx->m_rx_cca_abort = true;
      if (!vp_rx->m_rx_cca_cal_abort_done)      rx__cca_cals (v_lane_no);
      if (!vp_rx->m_rx_cca_fom_snr_abort_done)  rx__cca_fom_cm1_adapt (v_lane_no);

      if (vp_rx->m_rx_cca_cal_abort_done && vp_rx->m_rx_cca_fom_snr_abort_done) {
        vp_rx->m_rx_cca_abort = false;
        handshake_fsm_st[fsm_no] = e_pmd_handler_idle_st;
        vp_rx->m_rx_cca_st = e_rx_cca_first_cfg;
      } else {
        vp_rx->m_rx_cca_st = e_rx_cca_abort;
      }
      break;
    }

  }


    bool v_cca_status = (gRxLaneConfigBlock[v_lane_no].m_rx_parallel_cca_en == 1) ? (vp_rx->m_rx_cca_cal_pause_done && vp_rx->m_cm1_adapt_pause_done) : (vp_rx->m_rx_cca_cal_pause_done || vp_rx->m_cm1_adapt_pause_done) ;

    if (v_lane_margin_req == false) {
      WRITE_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR14__RXX_FW_CCA_STATUS, v_cca_status );
    }

  if (v_cca_status && v_lane_margin_req) {

    handler_func_pntr[fsm_no] = eRxHandlerSt_RxLaneMargining; 
    do {
      rx_handler_task_array[handler_func_pntr[fsm_no]] (fsm_no);
    } while(handshake_fsm_st[fsm_no] != e_pmd_handler_ack_st);

    rx_handler_ack_gen (fsm_no);
    handshake_fsm_st[fsm_no] = e_pmd_handler_req_st;
    handler_func_pntr[fsm_no] = eRxHandlerSt_CcaMisMode; 

    v_lane_margin_req = false;

  }



}





void funcRxCcaAdaptEn (uint8_t fsm_no) {

  uint8_t vLaneNo = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;
  
  if (gRxLaneConfigBlock[vLaneNo].m_skip_cca_adapt_cont == 0  || (gRxRepeatStrupAdaptFlag[vLaneNo] == 1)) {
    g_reg_val = READ_REG (g_rx_base_addr, RX__PIN_OVRDVAL3__ADDR) ; 
    SET_FIELD (g_reg_val, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_MODE_START_I_4_0,gCcaAdaptStartMode[vLaneNo]) ; 
    SET_FIELD (g_reg_val, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_MODE_END_I_4_0,gCcaAdaptEndMode[vLaneNo]) ; 
    WRITE_REG (g_rx_base_addr, RX__PIN_OVRDVAL3__ADDR, g_reg_val) ; 
  
    g_reg_val = READ_REG (g_rx_base_addr, RX__PIN_OVRDEN1__ADDR) ; 
    SET_FIELD (g_reg_val, RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_MODE_START_I,0x1) ; 
    SET_FIELD (g_reg_val, RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_MODE_END_I,0x1) ;
    SET_FIELD (g_reg_val, RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_EN_I,0x1) ;
    WRITE_REG (g_rx_base_addr, RX__PIN_OVRDEN1__ADDR, g_reg_val) ; 
  
    WRITE_REG_FIELD (g_rx_base_addr, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_EN_I,0x1) ; 
  }

  handler_func_pntr[fsm_no] = eRxHandlerSt_RxCcaAdaptDone1 ;
}

void funcRxCcaAdaptDone1 (uint8_t fsm_no) {

  uint8_t vLaneNo;
  uint8_t vDone ; 

  vLaneNo =fsm_no - MAX_NUM_CM - MAX_NUM_LANE;

  vDone = READ_REG_FIELD (g_rx_base_addr, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_DONE_O) ; 

 if (vDone == 0 && ((gRxLaneConfigBlock[vLaneNo].m_skip_cca_adapt_cont == 0) || (gRxRepeatStrupAdaptFlag[vLaneNo] == 1))) {
     handler_func_pntr[fsm_no] = eRxHandlerSt_RxCcaAdaptDone1 ;

  } else {
    WRITE_REG_FIELD (g_rx_base_addr, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_EN_I,0x0) ; 

    while (vDone == 1) {
      vDone = READ_REG_FIELD (g_rx_base_addr, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_DONE_O) ; 
    }

    g_reg_val = READ_REG (g_rx_base_addr, RX__PIN_OVRDEN1__ADDR) ; 
    SET_FIELD (g_reg_val, RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_MODE_START_I,0x0) ; 
    SET_FIELD (g_reg_val, RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_MODE_END_I,0x0) ;
    SET_FIELD (g_reg_val, RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_EN_I,0x0) ;
    WRITE_REG (g_rx_base_addr, RX__PIN_OVRDEN1__ADDR, g_reg_val) ; 

    handler_func_pntr[fsm_no] = gPostRxAdaptFuncSt[vLaneNo]; 
  }
}


void pmd_rx__lane_margining (uint8_t fsm_no) {

  uint8_t v_lane_no = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;
 
  int16_t   v_vdac;
  int8_t    v_iq;
  uint8_t   v_eye_sel;
  bool      v_margin_in_prog, v_margin_err_clr;

  g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__ADDR );
  v_margin_in_prog = GET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_MARGIN_IN_PROG_I );
  v_margin_err_clr = GET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_MARGIN_ERROR_CLEAR_I ); 
  
  g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL3__ADDR );
  v_eye_sel = GET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL3__RXX_MARGIN_EYE_SEL_I_1_0 );
  v_vdac =    GET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL3__RXX_MARGIN_VDAC_I_8_0 );
  v_vdac =    (int16_t) ((v_vdac & (1 << 8)) ? (v_vdac | 0xFE00) : v_vdac);
  v_iq =      GET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL3__RXX_MARGIN_IQ_I_6_0 );
  v_iq =      (int8_t) ((v_iq & (1 << 6)) ? (v_iq | (1 << 7)) : v_iq);



  WRITE_REG_FIELD ( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN0__USE_RXX_MARGIN_ERROR_CLEAR_I, 0x0 ); 



  rx_t *vp_rx = &g_rx[v_lane_no];

  if (v_margin_in_prog) { 
    g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN0__ADDR );
    SET_FIELD( g_reg_val, PMD_LANE_RX__EYE_SCAN0__NDES_FDF_EN, 0x0 );
    SET_FIELD( g_reg_val, PMD_LANE_RX__EYE_SCAN0__NDES_EN, 0x0 );
    SET_FIELD( g_reg_val, PMD_LANE_RX__EYE_SCAN0__NDES_MARGIN_ERR_CLR, 0x0 ); 
    WRITE_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN0__ADDR, g_reg_val );

    

    bool v_signal_type;
    uint8_t v_iq_fdf_index;
    v_signal_type = READ_REG_FIELD( g_rx_base_addr, RX__PIN_OVRDVAL0__INT_RX0_SIGNAL_TYPE_I );

    WRITE_REG_FIELD( g_rx_base_addr, RX__RXS_CFG4__CG_BYPASS_EN_RX_ADC_DATA_PACK, 0x1 );

    g_reg_val = READ_REG( g_rx_base_addr, RX__DFT22__ADDR );
    SET_FIELD( g_reg_val, RX__DFT22__DEBUG_MODE_3_0, 0x8 );
    SET_FIELD( g_reg_val, RX__DFT22__DEBUG_MUX_EN, 1 );
    WRITE_REG( g_rx_base_addr, RX__DFT22__ADDR, g_reg_val );

    g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN0__ADDR );
    SET_FIELD( g_reg_val, PMD_LANE_RX__EYE_SCAN0__NDES_MODE_3_0, 0xA );
    SET_FIELD( g_reg_val, PMD_LANE_RX__EYE_SCAN0__NDES_SAR_SEL_5_0, 0xA ); 
    WRITE_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN0__ADDR, g_reg_val );

    
    set_volt_margining_thresh (2, v_vdac, v_signal_type, v_eye_sel);
    set_volt_margining_thresh (1, v_vdac, v_signal_type, v_eye_sel);
    set_volt_margining_thresh (0, v_vdac, v_signal_type, v_eye_sel);

    
    if (v_signal_type == 0) {
	    v_iq = (v_iq < -25) ? -25 : ((v_iq > 25) ? 25 : v_iq);
    }
    else {
	    v_iq = (v_iq < -16) ? -16 : ((v_iq > 16) ? 16 : v_iq);
    }
    v_iq_fdf_index = (uint8_t) (v_iq + 25);

    for(uint8_t reg_ii = 0; reg_ii < 3; reg_ii++) {
      uint32_t v_filt_coeff_grouped = (reg_ii == 2 ? 0 : (g_filter_coeff_array[ (v_iq_fdf_index*11) + ((4 * reg_ii) + 3) ] << 24)) + \
                                      (g_filter_coeff_array[ (v_iq_fdf_index*11) + ((4 * reg_ii) + 2) ] << 16) + \
                                      (g_filter_coeff_array[ (v_iq_fdf_index*11) + ((4 * reg_ii) + 1) ] << 8) + \
                                      (g_filter_coeff_array[ (v_iq_fdf_index*11) + ((4 * reg_ii) + 0) ] << 0);
    
      WRITE_REG( g_pmd_lane_rx_base_addr, (PMD_LANE_RX__EYE_SCAN4__ADDR + (reg_ii*0x4)), v_filt_coeff_grouped ); 
    }

    vp_rx->m_rx_ndes_fdf_en = (v_iq != 0) ? true : false;
    vp_rx->m_rx_ndes_en = true;

  } else { 
    WRITE_REG_FIELD( g_rx_base_addr, RX__DFT22__DEBUG_MUX_EN, 0 );

    vp_rx->m_rx_ndes_fdf_en = false;
    vp_rx->m_rx_ndes_en = false;

    g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN0__ADDR );
    SET_FIELD( g_reg_val, PMD_LANE_RX__EYE_SCAN0__NDES_FDF_EN, vp_rx->m_rx_ndes_fdf_en );
    SET_FIELD( g_reg_val, PMD_LANE_RX__EYE_SCAN0__NDES_EN, vp_rx->m_rx_ndes_en );
    WRITE_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN0__ADDR, g_reg_val );

    WRITE_REG_FIELD( g_rx_base_addr, RX__RXS_CFG4__CG_BYPASS_EN_RX_ADC_DATA_PACK, 0x0 );
  }
    if(v_margin_err_clr) {  
      g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN0__ADDR );
      SET_FIELD( g_reg_val, PMD_LANE_RX__EYE_SCAN0__NDES_MARGIN_ERR_CLR, 0x0 );
      WRITE_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN0__ADDR, g_reg_val );
      SET_FIELD( g_reg_val, PMD_LANE_RX__EYE_SCAN0__NDES_MARGIN_ERR_CLR, 0x1 );
      WRITE_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN0__ADDR, g_reg_val );
    }

  handshake_fsm_st [fsm_no] = e_pmd_handler_ack_st;

}

void set_volt_margining_thresh (uint8_t a_thresh_sel, int16_t a_vdac, bool a_signal_type, uint8_t a_eye_sel) {
  uint16_t  v_th0, v_th1, v_th2, v_th3;
  int32_t   v_prog_th; 
  uint32_t  v_prog_th_ref, v_prog_th_fdf;
  uint8_t   v_readbk_thresh_sel;

  if (a_signal_type) { 
    v_readbk_thresh_sel = a_thresh_sel;
  } else { 
    v_readbk_thresh_sel = 1; 
  }

  g_reg_val = READ_REG( g_rx_base_addr, (RX__DIG_OVRDVAL38__DIG_BOT_COMP_TH_31_0__ADDR - (0x8*v_readbk_thresh_sel)) );
  v_th0     = g_reg_val & 0x3FF ; 
  v_th0     = (((v_th0 >> 9) & 0x1) == 1) ? (0xFC00 | v_th0) : v_th0;
  v_th1     = g_reg_val>>10 & 0x3FF ;
  v_th1     = (((v_th1 >> 9) & 0x1) == 1) ? (0xFC00 | v_th1) : v_th1;
  v_th2     = g_reg_val>>20 & 0x3FF ; 
  v_th2     = (((v_th2 >> 9) & 0x1) == 1) ? (0xFC00 | v_th2) : v_th2;
  v_th3     = g_reg_val>>30 & 0x3 ;
  g_reg_val = READ_REG( g_rx_base_addr, (RX__DIG_OVRDVAL39__DIG_BOT_COMP_TH_39_32__ADDR - (0x8*v_readbk_thresh_sel)) );

  g_reg_val = (g_reg_val & 0xFF) << 2;
  v_th3     = v_th3 + g_reg_val;
  v_th3     = (((v_th3 >> 9) & 0x1) == 1) ? (0xFC00 | v_th3) : v_th3;

  v_prog_th = ((int16_t) (v_th0)) + ((int16_t) (v_th1)) + ((int16_t) (v_th2)) + ((int16_t) (v_th3));
  v_prog_th = v_prog_th/4;
  
  v_prog_th_ref = (uint32_t) v_prog_th;

  v_prog_th = v_prog_th << 2;

  if(a_signal_type == 0) { 
    v_prog_th_fdf = (uint32_t) (v_prog_th + (a_vdac << 4));
  } else { 
    v_prog_th_fdf = (uint32_t) (((a_eye_sel == a_thresh_sel) || (a_eye_sel == 3)) ? (v_prog_th + (a_vdac << 3)) : v_prog_th);
  }
  switch(a_thresh_sel) {
    case 0: {
      WRITE_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN7__NDES_REF_BOT_COMP_TH_9_0, v_prog_th_ref ); 
      WRITE_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN8__NDES_FDF_BOT_COMP_TH_11_0, v_prog_th_fdf );
      break;
    }
    case 1: {
      WRITE_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN7__NDES_REF_MID_COMP_TH_9_0, v_prog_th_ref ); 
      WRITE_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN9__NDES_FDF_MID_COMP_TH_11_0, v_prog_th_fdf );
      break;
    }
    case 2: {
      WRITE_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN8__NDES_REF_TOP_COMP_TH_9_0, v_prog_th_ref ); 
      WRITE_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN9__NDES_FDF_TOP_COMP_TH_11_0, v_prog_th_fdf );
      break;
    }
  }
}





void pmd_rx__bit_slip (uint8_t fsm_no) {
  handshake_fsm_st [fsm_no] = e_pmd_handler_ack_st ; 
}









bool check_tx_ready(uint8_t a_lane_no){
  bool v_tx_ack = READ_REG_FIELD(g_pmd_lane_tx_base_addr_lut[a_lane_no], PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_ACK_O);
  bool v_tx_rdy = READ_REG_FIELD(g_pmd_lane_tx_base_addr_lut[a_lane_no], PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_RDY_O);

  return ((v_tx_ack == false) && (v_tx_rdy == true));
}

void pmd_rx__pmix_inl_cal (uint8_t fsm_no) {

  uint8_t v_lane_no = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;
  bool v_inl_en_check = (gRxLaneConfigBlock[v_lane_no].m_do_inl_corr == 1) && (g_num_cm > 1) && (((g_rx[v_lane_no].m_rx_rate == e_ref_156p25m_eth_106g) && \
        (gRxLaneConfigBlock[v_lane_no].m_pmix_inl_rate_sel_106g1_53g0 == 1)) || ((g_rx[v_lane_no].m_rx_rate == e_ref_156p25m_eth_53g) && (gRxLaneConfigBlock[v_lane_no].m_pmix_inl_rate_sel_106g1_53g0 == 0))); 
  rx_t *vp_rx = &g_rx[v_lane_no];

  if (g_fw_fastsim_en == 1) { 
      handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
  } else { 

    if(g_pmix_inl_cal_startup_done) { 
      WRITE_REG_FIELD( g_rx_base_addr, RX__RXS_CFG5__PMIX_INL_CORRECTION_EN, v_inl_en_check);
      handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
      return;
    } 

    bool vDone = false;
    if (v_inl_en_check) {

      if (!check_tx_ready(v_lane_no)) {
        return;
      } 

      if(v_lane_no < 2) { 
          vDone = rx__pmix_inl_cal (v_lane_no);
      } else { 
        g_pmix_inl_lane0_lane1_done = (g_rx[0].m_rx_pmix_inl_cal_done == true) && (g_rx[1].m_rx_pmix_inl_cal_done == true);
        if(g_pmix_inl_lane0_lane1_done) {
            vDone = rx__pmix_inl_cal (v_lane_no);
        }
      }
    } else { 
      vp_rx->m_rx_pmix_inl_pos_done = true; 
      vp_rx->m_rx_pmix_inl_neg_done = true; 
      vp_rx->m_rx_pmix_inl_cal_done = true; 
      vDone = true;
    }

    if (vDone) {
      handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
    }
  }
}





void func_do_adapt(uint8_t vLaneNo, uint8_t vStartMode, uint8_t vEndMode) {

  uint8_t vDone;

  g_reg_val = READ_REG (g_rx_base_addr, RX__PIN_OVRDEN1__ADDR); 
  SET_FIELD (g_reg_val, RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_MODE_START_I,  0x1); 
  SET_FIELD (g_reg_val, RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_MODE_END_I,    0x1); 
  SET_FIELD (g_reg_val, RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_EN_I, 0x1); 
  WRITE_REG (g_rx_base_addr, RX__PIN_OVRDEN1__ADDR, g_reg_val);

  g_reg_val = READ_REG (g_rx_base_addr, RX__PIN_OVRDVAL3__ADDR); 
  SET_FIELD (g_reg_val, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_MODE_START_I_4_0, vStartMode); 
  SET_FIELD (g_reg_val, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_MODE_END_I_4_0, vEndMode);
  WRITE_REG (g_rx_base_addr, RX__PIN_OVRDVAL3__ADDR, g_reg_val);

  WRITE_REG_FIELD( g_rx_base_addr, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_EN_I, 0x1);

  do {
    vDone = READ_REG_FIELD (g_rx_base_addr, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_DONE_O) ;
    delay_ns(100);
  } while (vDone==0);   

 
  WRITE_REG_FIELD (g_rx_base_addr, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_EN_I, 0x0);

  do {
    vDone = READ_REG_FIELD (g_rx_base_addr, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_DONE_O) ;
  } while (vDone==1);   

  g_reg_val = READ_REG (g_rx_base_addr, RX__PIN_OVRDEN1__ADDR); 
  SET_FIELD (g_reg_val, RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_MODE_START_I,  0x0); 
  SET_FIELD (g_reg_val, RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_MODE_END_I,    0x0); 
  SET_FIELD (g_reg_val, RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_EN_I, 0x0); 
  WRITE_REG (g_rx_base_addr, RX__PIN_OVRDEN1__ADDR, g_reg_val);
  
}







ATTR_INLINE void pmd_rx__save_rx_cfg (uint8_t a_lane_no) {
  pmd_rx_cfg_settings *vp_pmd_rx_cfg_settings_h = &pmd_rx_cfg_settings_h[a_lane_no];
  g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__ADDR );
  vp_pmd_rx_cfg_settings_h->m_rxX_rate = GET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_RATE_I_5_0 ); 
  vp_pmd_rx_cfg_settings_h->m_rxX_width = GET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_WIDTH_I_3_0 ); 
  vp_pmd_rx_cfg_settings_h->m_rxX_pll_sel = GET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_PLL_SEL_I );
  vp_pmd_rx_cfg_settings_h->m_rxX_hold_adapt = READ_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR13__FW_ETH_HOLD_RXX_ADAPT_START );

}

ATTR_INLINE void pmd_rx__restore_rx_cfg (uint8_t a_lane_no) {
  pmd_rx_cfg_settings *vp_pmd_rx_cfg_settings_h = &pmd_rx_cfg_settings_h[a_lane_no];
  g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__ADDR );
  SET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_RATE_I_5_0, vp_pmd_rx_cfg_settings_h->m_rxX_rate ); 
  SET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_WIDTH_I_3_0, vp_pmd_rx_cfg_settings_h->m_rxX_width ); 
  SET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_PLL_SEL_I, vp_pmd_rx_cfg_settings_h->m_rxX_pll_sel );
  WRITE_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__ADDR, g_reg_val );
  WRITE_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR13__FW_ETH_HOLD_RXX_ADAPT_START, vp_pmd_rx_cfg_settings_h->m_rxX_hold_adapt );
}

ATTR_INLINE void pmd_rx__pmix_inl_rx_cfg (uint8_t a_lane_no) {
  uint8_t v_inl_rate = ( gRxLaneConfigBlock[a_lane_no].m_pmix_inl_rate_sel_106g1_53g0 ? e_ref_156p25m_eth_106g : e_ref_156p25m_eth_53g ) ;    
  
  g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__ADDR );
  SET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_RESET_I, 1 );
  SET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_WIDTH_I_3_0, 9 ); 
  SET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_RATE_I_5_0, v_inl_rate ); 
  if(a_lane_no < 2) {
    SET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_PLL_SEL_I, 1 ); 
  } else {
    SET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_PLL_SEL_I, 0 ); 
  }
  WRITE_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__ADDR, g_reg_val );

  g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDEN0__ADDR );
  SET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDEN0__OVRD_EN_RXX_RESET_I, 1 );
  SET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDEN0__OVRD_EN_RXX_WIDTH_I, 1 );
  SET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDEN0__OVRD_EN_RXX_RATE_I, 1 );
  SET_FIELD( g_reg_val, PMD_LANE_RX__PMD_RX_OVRDEN0__OVRD_EN_RXX_PLL_SEL_I, 1 );
  WRITE_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDEN0__ADDR, g_reg_val );

  WRITE_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR13__FW_ETH_HOLD_RXX_ADAPT_START, 1 );

  WRITE_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_RESET_I, 0 );

}







