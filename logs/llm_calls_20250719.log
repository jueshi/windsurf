}







ATTR_INLINE bool tx__cca_mis_mode (uint8_t a_lane_no, uint8_t a_cntx) {

  tx_t *vp_tx = &g_tx[a_lane_no];
  bool v_done = false;

  tx_dcc_cal_settings *tx_dcc_cal_settings_p;
  tx_dcc_cal_settings_p = &tx_dcc_cal_settings_h[a_lane_no][a_cntx];


  switch (vp_tx->m_tx_cca_cal_st) {

    case e_tx_cca_config_st: {

      gTxLaneConfigBlock[a_lane_no].m_tx_cca_status = gTxLaneConfigBlock[a_lane_no].m_tx_cca_pause;
      if (gTxLaneConfigBlock[a_lane_no].m_tx_cca_pause == 1) {
        break;
      }

      if (vp_tx->m_tx_cals_use_pads) { 

        if (gTxLaneConfigBlock[a_lane_no].m_tx_dcc_pad_txpn_avg_en == 1) { 
          g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL5__ADDR );
          SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL5__DCC000_CAL_STATIC_PATTERN_3_0, 0x9 ); 
          SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL5__DCC090_CAL_STATIC_PATTERN_3_0, 0x3 ); 
          SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL5__DCC180_CAL_STATIC_PATTERN_3_0, 0x6 ); 
          SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL5__DCC270_CAL_STATIC_PATTERN_3_0, 0xC ); 
          WRITE_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL5__ADDR, g_reg_val );
        }
      }
      
      vp_tx->m_tx_cca_iter_cnt_curr = 0;
      vp_tx->m_tx_cca_cal_st = e_tx_cca_dcc_vcm_cal_restore_st;
    }

    case e_tx_cca_dcc_vcm_cal_restore_st: {
      if (gTxLaneConfigBlock[a_lane_no].m_tx_cca_skip_dcc_cal) {
        vp_tx->m_tx_cca_cal_st = e_tx_cca_iq_cal_st;
        break;
      }
        
      vp_tx->m_tx_cca_cal_st = e_tx_cca_dcc_cal_st;
    } 
    

    case e_tx_cca_dcc_cal_st: {
      
      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_DCC_CAL_MODE_I, 1);
      SET_FIELD (g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_DCC_CAL_REQ_I, 1);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR, g_reg_val);
      
      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_DCC_CAL_MODE_I, 1);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR, g_reg_val);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_DCC_CAL_REQ_I, 1);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR, g_reg_val);
      
      vp_tx->m_tx_cca_cal_st = e_tx_cca_dcc_cal_done_st;
    }

    case e_tx_cca_dcc_cal_done_st: {
      g_reg_val = READ_REG_FIELD (g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_DCC_CAL_DONE_O);
      if (g_reg_val == 0) {
        break;
      }
      WRITE_REG_FIELD (g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_DCC_CAL_REQ_I, 0);

      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_DCC_CAL_MODE_I, 0);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_DCC_CAL_REQ_I, 0);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR, g_reg_val);

      vp_tx->m_tx_cca_cal_st = e_tx_cca_iq_vcm_cal_restore_st;
    }

    case e_tx_cca_iq_vcm_cal_restore_st: {
      if (gTxLaneConfigBlock[a_lane_no].m_tx_cca_skip_iq_cal) {
        vp_tx->m_tx_cca_cal_st = e_tx_cca_dll_cal_st;
        break;
      }

      vp_tx->m_tx_cca_cal_st = e_tx_cca_iq_cal_st;
    }     
 
    case e_tx_cca_iq_cal_st: {
         
      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_IQ_CAL_MODE_I, 1);
      SET_FIELD (g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_IQ_CAL_REQ_I, 1);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR, g_reg_val);
      
      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_IQ_CAL_MODE_I, 1);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR, g_reg_val);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_IQ_CAL_REQ_I, 1);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR, g_reg_val);

      vp_tx->m_tx_cca_cal_st = e_tx_cca_iq_cal_done_st;
    }

    case e_tx_cca_iq_cal_done_st: {
      g_reg_val = READ_REG_FIELD (g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_IQ_CAL_DONE_O);
      if (g_reg_val == 0) {
        break;
      }
      WRITE_REG_FIELD (g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_IQ_CAL_REQ_I, 0);

      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_IQ_CAL_MODE_I, 0);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_IQ_CAL_REQ_I, 0);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR, g_reg_val);

      vp_tx->m_tx_cca_cal_st = e_tx_cca_dll_cal_st;
    }

    case e_tx_cca_dll_cal_st: {
      if (gTxLaneConfigBlock[a_lane_no].m_tx_cca_skip_dll_cal) {
        vp_tx->m_tx_cca_cal_st = e_tx_cca_loop_st;
        break;
      }
      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_DLL_CAL_MODE_I, 1); 
      SET_FIELD (g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_DLL_CAL_REQ_I, 1);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR, g_reg_val);
      
      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDEN1__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN1__OVRD_EN_TX0_DLL_CAL_MODE_I, 1);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN1__ADDR, g_reg_val);

      SET_FIELD (g_reg_val, TX__PIN_OVRDEN1__OVRD_EN_TX0_DLL_CAL_REQ_I, 1);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN1__ADDR, g_reg_val);

      vp_tx->m_tx_cca_cal_st = e_tx_cca_dll_cal_done_st;
    }

    case e_tx_cca_dll_cal_done_st: {
      g_reg_val = READ_REG_FIELD (g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_DLL_CAL_DONE_O);
      if (g_reg_val == 0) {
        break;
      }
      WRITE_REG_FIELD (g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_DLL_CAL_REQ_I, 0);

      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDEN1__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN1__OVRD_EN_TX0_DLL_CAL_MODE_I, 0);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN1__OVRD_EN_TX0_DLL_CAL_REQ_I, 0);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN1__ADDR, g_reg_val);

      vp_tx->m_tx_cca_cal_st = e_tx_cca_loop_st;
    }

    case e_tx_cca_loop_st: {
      vp_tx->m_tx_cca_iter_cnt_curr++;

      if (vp_tx->m_tx_cca_iter_cnt_curr < vp_tx->m_tx_cca_iter_cnt) {
        vp_tx->m_tx_cca_cal_st = e_tx_cca_dcc_vcm_cal_restore_st;
        break;
      } else {
        vp_tx->m_tx_cca_cal_st = e_tx_cca_done_st;
      }
    }

    case e_tx_cca_done_st: {
      
      g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL5__ADDR );
      SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL5__DCC000_CAL_STATIC_PATTERN_3_0, 0x6 ); 
      SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL5__DCC090_CAL_STATIC_PATTERN_3_0, 0xC ); 
      SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL5__DCC180_CAL_STATIC_PATTERN_3_0, 0x9 ); 
      SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL5__DCC270_CAL_STATIC_PATTERN_3_0, 0x3 ); 
      WRITE_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL5__ADDR, g_reg_val );


      v_done = true;
      vp_tx->m_tx_cca_cal_st = e_tx_cca_config_st;
      break;
    }
  }

  return v_done;
}





