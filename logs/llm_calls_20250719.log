inline void config_rx_pwrseq (uint8_t vLaneNo) {

  rx_t *vp_rx = &g_rx[vLaneNo];

  uint32_t vI;
  uint32_t vAddrOfst;

  struct tPowerSequencePstateStep_t *vpPowerUpSequencePstateStepLut;
  struct tPowerSequencePstateStep_t *vpPowerDownSequencePstateStepLut;


  

    vpPowerUpSequencePstateStepLut   = &gEthRxPowerUpSequencePstateStepLut;
    vpPowerDownSequencePstateStepLut = &gEthRxPowerDownSequencePstateStepLut;


  
  g_reg_val = READ_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_PWRUP_CFG64__ADDR);
  SET_FIELD (g_reg_val, PMD_LANE_RX__RX_PWRUP_CFG64__RX_PWRUP_RST_STEP_MAPPING_6_0, vpPowerUpSequencePstateStepLut->rst_step_map);
  SET_FIELD (g_reg_val, PMD_LANE_RX__RX_PWRUP_CFG64__RX_PWRUP_P2_STEP_MAPPING_6_0 , vpPowerUpSequencePstateStepLut->p2_step_map );
  SET_FIELD (g_reg_val, PMD_LANE_RX__RX_PWRUP_CFG64__RX_PWRUP_P1_STEP_MAPPING_6_0 , vpPowerUpSequencePstateStepLut->p1_step_map );
  WRITE_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_PWRUP_CFG64__ADDR, g_reg_val);

  g_reg_val = READ_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_PWRUP_CFG65__ADDR);
  SET_FIELD (g_reg_val, PMD_LANE_RX__RX_PWRUP_CFG65__RX_PWRUP_P0S_STEP_MAPPING_6_0, vpPowerUpSequencePstateStepLut->p0s_step_map);
  SET_FIELD (g_reg_val, PMD_LANE_RX__RX_PWRUP_CFG65__RX_PWRUP_P0_STEP_MAPPING_6_0 , vpPowerUpSequencePstateStepLut->p0_step_map );
  WRITE_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_PWRUP_CFG65__ADDR, g_reg_val);


  vAddrOfst = 0x0;
  for (vI = 0; vI <= vpPowerUpSequencePstateStepLut->p0_step_map ; vI=vI+2)
  {
    if (vp_rx->m_rx_mode == e_pcie_mode) { 
      g_reg_val = (uint32_t)(*((uint32_t *)&gPcieRxPowerUpSequenceTableLut[vI]));
    } else {  
      g_reg_val = (uint32_t)(*((uint32_t *)&gEthRxPowerUpSequenceTableLut[vI]));
    }

    WRITE_REG (g_pmd_lane_rx_base_addr, (PMD_LANE_RX__RX_PWRUP_CFG0__ADDR + vAddrOfst), g_reg_val);

    vAddrOfst += 0x04;
  }

  
  g_reg_val = READ_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_PWRDN_CFG16__ADDR);
  SET_FIELD (g_reg_val, PMD_LANE_RX__RX_PWRDN_CFG16__RX_PWRDN_RST_STEP_MAPPING_4_0, vpPowerDownSequencePstateStepLut->rst_step_map);
  SET_FIELD (g_reg_val, PMD_LANE_RX__RX_PWRDN_CFG16__RX_PWRDN_P2_STEP_MAPPING_4_0 , vpPowerDownSequencePstateStepLut->p2_step_map );
  SET_FIELD (g_reg_val, PMD_LANE_RX__RX_PWRDN_CFG16__RX_PWRDN_P1_STEP_MAPPING_4_0 , vpPowerDownSequencePstateStepLut->p1_step_map );
  SET_FIELD (g_reg_val, PMD_LANE_RX__RX_PWRDN_CFG16__RX_PWRDN_P0S_STEP_MAPPING_4_0, vpPowerDownSequencePstateStepLut->p0s_step_map);
  SET_FIELD (g_reg_val, PMD_LANE_RX__RX_PWRDN_CFG16__RX_PWRDN_P0_STEP_MAPPING_4_0 , vpPowerDownSequencePstateStepLut->p0_step_map );
  WRITE_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_PWRDN_CFG16__ADDR, g_reg_val);

  vAddrOfst = 0x0;
  for (vI = 0; vI <= vpPowerDownSequencePstateStepLut->rst_step_map ; vI=vI+2)
  {
    if (vp_rx->m_rx_mode == e_pcie_mode) { 
      g_reg_val = (uint32_t)(*((uint32_t *)&gPcieRxPowerDownSequenceLut[vI]));
    } else {  
      g_reg_val = (uint32_t)(*((uint32_t *)&gEthRxPowerDownSequenceLut[vI]));
    }

    WRITE_REG (g_pmd_lane_rx_base_addr, (PMD_LANE_RX__RX_PWRDN_CFG0__ADDR + vAddrOfst), g_reg_val);

    vAddrOfst += 0x04;
  }


}




inline void config_rx_adapt (uint8_t vLaneNo) {
  union tPmdLaneRxRxFwCsr10RxFwSpare1_t vPmdLaneRxRxFwCsr10RxFwSpare1;


  gRxXFwDoFtffe[vLaneNo] = (g_fw_fastsim_en == 0);

    vPmdLaneRxRxFwCsr10RxFwSpare1.reg = READ_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR10__RX_FW_SPARE1_21_0);
    vPmdLaneRxRxFwCsr10RxFwSpare1.fields.mRxXFwFtffeTapEn = 0x1FF;  
    WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR10__RX_FW_SPARE1_21_0, vPmdLaneRxRxFwCsr10RxFwSpare1.reg);

  WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR13__RXX_FW_DO_FTFFE, gRxXFwDoFtffe[vLaneNo]); 



  if (g_rx[vLaneNo].m_rx_mode == e_eth_mode) { 
    WRITE_REG_FIELD (g_pmd_lane_rx_base_addr_lut[vLaneNo], PMD_LANE_RX__ETH_ADAPT_CTRL60__EN_MISSION_MODE, 0x0);
  }



    if ((g_fw_fastsim_en == 1) || (g_fw_fastsim_en == 0 && g_rx[vLaneNo].m_rx_mode == e_pcie_mode)) { 
      WRITE_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR13__RXX_FW_CCA_EN, 0  );  
    }
  
    g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR13__ADDR );
    SET_FIELD( g_reg_val, PMD_LANE_RX__RX_FW_CSR13__RXX_FW_CCA_ADAPT_MODE_START_4_0, 15 );
    SET_FIELD( g_reg_val, PMD_LANE_RX__RX_FW_CSR13__RXX_FW_CCA_ADAPT_MODE_END_4_0,   15 );
    SET_FIELD( g_reg_val, PMD_LANE_RX__RX_FW_CSR13__RXX_FW_CCA_CAL_REPEAT_CNT_7_0,   8  );
    SET_FIELD( g_reg_val, PMD_LANE_RX__RX_FW_CSR13__RXX_FW_CCA_PAUSE,                0  );
    WRITE_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR13__ADDR, g_reg_val );

    WRITE_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR14__RXX_FW_CCA_STATUS, 1 );

    
}




