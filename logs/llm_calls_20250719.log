  vp_pmd_tx_cfg_settings_h->m_txX_master_pll_st =  GET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_MASTER_PLL_STATE_I );
  vp_pmd_tx_cfg_settings_h->m_txX_master_pll_st_ovrden =  READ_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDEN0__OVRD_EN_TXX_MASTER_PLL_STATE_I );
