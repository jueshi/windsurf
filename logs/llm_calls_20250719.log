ATTR_INLINE void fw_ver_dccm_to_dccm () {
  WRITE_CCM( 0x8FF80, READ_CCM( 0x8FF80 ) );
  WRITE_CCM( 0x8FF84, READ_CCM( 0x8FF84 ) );
}




ATTR_INLINE void fw_init () {
  uint8_t  v_cpu_clk_freq_10Mhz;


  
  g_reg_val  = READ_REG( PMD_BASE_ADDR, PMD__PMD_SPARE_STAT0__ADDR );
  g_num_lane = GET_FIELD( g_reg_val, PMD__PMD_SPARE_STAT0__PMD_NUM_LANES_3_0 );
  g_num_cm   = GET_FIELD( g_reg_val, PMD__PMD_SPARE_STAT0__PMD_NUM_CMS_3_0 );


  
  v_cpu_clk_freq_10Mhz = READ_REG_FIELD( PMD_BASE_ADDR, PMD__FW_CSR0__CPU_CLK_FREQ_7_0 );
  v_cpu_clk_freq_10Mhz = (v_cpu_clk_freq_10Mhz == 0) ? 50 : v_cpu_clk_freq_10Mhz; 

  
  delay_init(v_cpu_clk_freq_10Mhz * 10);


  g_pmd__fw_csr2__fw_spare2.reg = READ_REG( PMD_BASE_ADDR, PMD__FW_CSR2__FW_SPARE2_31_0__ADDR );

  g_pg_exit = READ_REG_FIELD( PMD_BASE_ADDR, PMD__PMD_OVRDVAL0__PG_EXIT_I );
  if (g_pg_exit == 0) { 
    g_fw_skip_pcie_repeat_strup = g_pmd__fw_csr2__fw_spare2.fields.m_fw_skip_pcie_repeat_strup;
    g_fw_ufastsim_0_fastsim_1  = g_pmd__fw_csr2__fw_spare2.fields.m_fw_ultra_fastsim_disable;
    g_retimer_en                = g_pmd__fw_csr2__fw_spare2.fields.m_fw_retimer_en ;

    g_reg_val = READ_REG( PMD_BASE_ADDR, PMD__FW_CSR8__ADDR );
    g_fw_fastsim_en = GET_FIELD( g_reg_val, PMD__FW_CSR8__FW_FASTSIM_EN );  
    g_fw_test_mode  = GET_FIELD( g_reg_val, PMD__FW_CSR8__FW_TEST_MODE );   
    SET_FIELD( g_reg_val, PMD__FW_CSR8__FW_STATIC_CFG_DONE, 0 );            
    WRITE_REG( PMD_BASE_ADDR, PMD__FW_CSR8__ADDR, g_reg_val );

    if ((g_fw_fastsim_en == 1) && (g_fw_ufastsim_0_fastsim_1 == 0)) {  
      g_fw_skip_pcie_repeat_strup = 1;
      g_pmd__fw_csr2__fw_spare2.fields.m_fw_skip_pcie_repeat_strup = g_fw_skip_pcie_repeat_strup;

      WRITE_REG( PMD_BASE_ADDR, PMD__FW_CSR2__FW_SPARE2_31_0__ADDR, g_pmd__fw_csr2__fw_spare2.reg );
    }

  } else { 

    g_fw_skip_pcie_repeat_strup = 1; 

    g_pmd__fw_csr2__fw_spare2.fields.m_fw_skip_pcie_repeat_strup = g_fw_skip_pcie_repeat_strup;
    g_pmd__fw_csr2__fw_spare2.fields.m_fw_ultra_fastsim_disable  = g_fw_ufastsim_0_fastsim_1;
    g_pmd__fw_csr2__fw_spare2.fields.m_fw_retimer_en             = g_retimer_en;

    g_reg_val = READ_REG( PMD_BASE_ADDR, PMD__FW_CSR8__ADDR );
    SET_FIELD( g_reg_val, PMD__FW_CSR8__FW_FASTSIM_EN, g_fw_fastsim_en );  
    SET_FIELD( g_reg_val, PMD__FW_CSR8__FW_TEST_MODE,  g_fw_test_mode );   
    SET_FIELD( g_reg_val, PMD__FW_CSR8__FW_STATIC_CFG_DONE, 0 );           
    WRITE_REG( PMD_BASE_ADDR, PMD__FW_CSR8__ADDR, g_reg_val );

    WRITE_REG( PMD_BASE_ADDR, PMD__FW_CSR2__FW_SPARE2_31_0__ADDR, g_pmd__fw_csr2__fw_spare2.reg );
  }
}




void run_static_configs (bool a_force_tx_replica_cals) {
  
  g_cm_rescal_codes.m_master_cm = 0 ;

  
  new_general_debug_cmd   = 0; 
  general_debug_cmd_cmplt = 0; 
  general_debug_fsm_busy  = 0;
  general_debug_fsm_h.current_state  = GENERAL_DEBUG_IDLE_ST;

  
  gInlOngoing = 0;
  gHistFsmSt = dHistCfgSt; 


  

  
  for (uint8_t v_inst_no = 0; v_inst_no < g_num_lane; v_inst_no++) {
    
    if (v_inst_no < g_num_cm) {
      pmd_cm__static_config (v_inst_no);
    }

    
    handshake_fsm_st [MAX_NUM_CM + v_inst_no] = e_pmd_handler_idle_st;
    set_tx_lane_config (v_inst_no, (a_force_tx_replica_cals ? false : gTxLaneConfigBlock[v_inst_no].m_tx_cals_use_pads)); 

    
    handshake_fsm_st [MAX_NUM_CM + MAX_NUM_LANE + v_inst_no] = e_pmd_handler_req_st;
    handler_func_pntr[MAX_NUM_CM + MAX_NUM_LANE + v_inst_no] = eRxHandlerSt_RxTrimRtermConfig;
    set_rx_lane_config (v_inst_no); 
  }

  
  for (uint8_t v_inst_no = 0; v_inst_no < g_num_lane; v_inst_no++) {
    if (v_inst_no < g_num_cm) {
      if (g_pmd_cm[v_inst_no].m_fw_skip_cmX_pwr_up == 0) WRITE_REG_FIELD( g_pmd_cm_base_addr_lut[v_inst_no], PMD_CM__FW_CSR0__CM_FW_INIT_DONE, 1 );
    }
    WRITE_REG_FIELD( g_pmd_lane_tx_base_addr_lut[v_inst_no], PMD_LANE_TX__TX_LANE_CFG0__FW_STATIC_CONFIG_DONE, 1 );
    WRITE_REG_FIELD( g_pmd_lane_rx_base_addr_lut[v_inst_no], PMD_LANE_RX__RX_LANE_CFG0__FW_STATIC_CONFIG_DONE, 1 );
  }
}




void static_config () {
  run_static_configs(false); 

  WRITE_REG_FIELD( PMD_BASE_ADDR, PMD__FW_CSR8__FW_STATIC_CFG_DONE, 1 );
}




ATTR_INLINE void fw__vmt_handler () {

  uint8_t vTxHandlerFsmId, vRxHandlerFsmId;

  
  for (uint8_t v_inst_no = 0; v_inst_no < g_num_lane; v_inst_no++)  {
    
    if (v_inst_no < g_num_cm) {
      pmd_cm__pll_handler (v_inst_no);
    }

    
    vTxHandlerFsmId = MAX_NUM_CM + v_inst_no ;
    g_pmd_lane_tx_base_addr = g_pmd_lane_tx_base_addr_lut[v_inst_no];
    g_tx_base_addr = g_tx_base_addr_lut[v_inst_no];
    
    if (handshake_fsm_st[vTxHandlerFsmId] == e_pmd_handler_idle_st) tx_handler_req_decode (vTxHandlerFsmId); 
    if (handshake_fsm_st[vTxHandlerFsmId] == e_pmd_handler_req_st)  tx_handler_task_array[handler_func_pntr[vTxHandlerFsmId]] (vTxHandlerFsmId); 
    if (handshake_fsm_st[vTxHandlerFsmId] == e_pmd_handler_ack_st)  tx_handler_ack_gen    (vTxHandlerFsmId);
    
    if (trigger_tx_ack_check[v_inst_no] == 1)               func_tx_check       (v_inst_no);


    
    g_pmd_lane_rx_base_addr = g_pmd_lane_rx_base_addr_lut[v_inst_no];
    g_rx_base_addr = g_rx_base_addr_lut[v_inst_no];
    vRxHandlerFsmId = MAX_NUM_CM + MAX_NUM_LANE + v_inst_no;
    
    if (handshake_fsm_st[vRxHandlerFsmId] == e_pmd_handler_idle_st) rx_handler_req_decode (vRxHandlerFsmId); 
    if (handshake_fsm_st[vRxHandlerFsmId] == e_pmd_handler_req_st)  rx_handler_task_array[handler_func_pntr[vRxHandlerFsmId]] (vRxHandlerFsmId); 
    if (handshake_fsm_st[vRxHandlerFsmId] == e_pmd_handler_ack_st)  rx_handler_ack_gen    (vRxHandlerFsmId);
    
    if (trigger_rx_ack_check[v_inst_no] == 1)               func_rx_check       (v_inst_no);
  }

    
  func_sch_decode_mb_req ();

  
  if (new_general_debug_cmd == 1)   execute_general_debug_mb_cmd ();
  general_debug_func_array [general_debug_fsm_h.current_state] ();
  if (general_debug_cmd_cmplt == 1) generate_general_debug_ack ();
}




ATTR_INLINE void start_pmix_inl_cal_pwrup () {
  for (uint8_t v_inst_no = 0; v_inst_no < g_num_lane; v_inst_no++) {

    g_pmd_lane_tx_base_addr = g_pmd_lane_tx_base_addr_lut[v_inst_no];
    g_pmd_lane_rx_base_addr = g_pmd_lane_rx_base_addr_lut[v_inst_no];

    if (v_inst_no < g_num_cm) {
      g_pmd_cm_base_addr = g_pmd_cm_base_addr_lut[v_inst_no];
      pmd_cm__save_pll_cfg     (v_inst_no);
      pmd_cm__pmix_inl_pll_cfg (v_inst_no);
    }

    pmd_tx__save_tx_cfg     (v_inst_no);
    pmd_tx__pmix_inl_tx_cfg (v_inst_no);

    pmd_rx__save_rx_cfg     (v_inst_no);
    pmd_rx__pmix_inl_rx_cfg (v_inst_no);
  }
}




ATTR_INLINE void startup_2cm_pmix_inl_cal () {

  g_pmix_inl_cal_startup_done = false; 

  g_hw_static_cfg_st = e_hw_static_check_pmix_inl_en;

  switch (g_hw_static_cfg_st) {

    case e_hw_static_check_pmix_inl_en: {

      g_do_pmix_inl_powerup = false;

      for (uint8_t v_lane_no = 0; v_lane_no < g_num_lane; v_lane_no++) {
        g_do_pmix_inl_powerup = g_do_pmix_inl_powerup || (gRxLaneConfigBlock[v_lane_no].m_do_inl_corr == 1);
      }

      if (!g_do_pmix_inl_powerup) { 
        break;
      }

      run_static_configs(true); 
      g_hw_static_cfg_st = e_hw_static_cfg_pmix_inl_pwrup;
    }
  
    case e_hw_static_cfg_pmix_inl_pwrup: {
      start_pmix_inl_cal_pwrup();
      bool v_pmix_inl_powerup_incomplete[MAX_NUM_LANE];
      bool v_powerup_incomplete = false;

      do {
        fw__vmt_handler ();

        for (uint8_t v_lane_no = 0; v_lane_no < g_num_lane; v_lane_no++) {
          v_pmix_inl_powerup_incomplete[v_lane_no] = READ_REG_FIELD(g_pmd_lane_rx_base_addr_lut[v_lane_no], PMD_LANE_RX__PMD_RX_OVRDVAL3__RXX_ACK_O);
        }

        v_powerup_incomplete = false;
        for (uint8_t v_lane_no = 0; v_lane_no < g_num_lane; v_lane_no++) {
          v_powerup_incomplete = v_powerup_incomplete || v_pmix_inl_powerup_incomplete[v_lane_no];
        }

      } while (v_powerup_incomplete);

      g_pmix_inl_cal_startup_done = true;

      g_hw_static_cfg_st = e_hw_static_cfg_pmix_inl_pwrdn;
    }

    case e_hw_static_cfg_pmix_inl_pwrdn: {
      for (uint8_t v_lane_no = 0; v_lane_no < g_num_lane; v_lane_no++) {
        WRITE_REG_FIELD(g_pmd_lane_rx_base_addr_lut[v_lane_no], PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_DATA_EN_I, 0 );
        WRITE_REG_FIELD(g_pmd_lane_rx_base_addr_lut[v_lane_no], PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_RESET_I, 1 );
        WRITE_REG_FIELD(g_pmd_lane_tx_base_addr_lut[v_lane_no], PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_DATA_EN_I, 0 );
        WRITE_REG_FIELD(g_pmd_lane_tx_base_addr_lut[v_lane_no], PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_RESET_I, 1 );
      }

      bool v_tx_pwrdn_complete[MAX_NUM_LANE];
      bool v_rx_pwrdn_complete[MAX_NUM_LANE];
      bool v_powerdown_complete;
      do {
        fw__vmt_handler ();

        for (uint8_t v_lane_no = 0; v_lane_no < g_num_lane; v_lane_no++) {
          v_tx_pwrdn_complete[v_lane_no] = (READ_REG_FIELD( g_pmd_lane_tx_base_addr_lut[v_lane_no], PMD_LANE_TX__TX_FW_CSR1__TX_PSTATE_CURR_2_0 ) == 4) ? true : false;
          v_rx_pwrdn_complete[v_lane_no] = (READ_REG_FIELD( g_pmd_lane_rx_base_addr_lut[v_lane_no], PMD_LANE_RX__RX_FW_CSR2__RX_PSTATE_CURR_2_0 ) == 4) ? true : false;
        }
        v_powerdown_complete = true;
        for (uint8_t v_lane_no = 0; v_lane_no < g_num_lane; v_lane_no++) {
          v_powerdown_complete = v_powerdown_complete && (v_tx_pwrdn_complete[v_lane_no] && v_rx_pwrdn_complete[v_lane_no]);
        }
      } while(!v_powerdown_complete);

      for (uint8_t v_inst_no = 0; v_inst_no < g_num_lane; v_inst_no++) {
        g_pmd_lane_tx_base_addr = g_pmd_lane_tx_base_addr_lut[v_inst_no];
        g_pmd_lane_rx_base_addr = g_pmd_lane_rx_base_addr_lut[v_inst_no];
        g_tx_base_addr = g_tx_base_addr_lut[v_inst_no];

        if (v_inst_no < g_num_cm) {
          g_pmd_cm_base_addr = g_pmd_cm_base_addr_lut[v_inst_no];
          pmd_cm__restore_pll_cfg (v_inst_no);
        }
        pmd_tx__restore_tx_cfg (v_inst_no);
        pmd_rx__restore_rx_cfg (v_inst_no);

        WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDEN5__OVRD_EN_TX_ANA_DRV_SER_DATA_EN, 0 ); 
        WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDEN0__OVRD_EN_TX_ANA_DRV_DAC_PWR_GATE_EN, 0 ); 
        tx__ffe_coeff_squelch (v_inst_no, false); 
      }
    }
  } 
}



ATTR_INLINE void pmd_cm__rescal_code_save () {
  bool v_cm_rdy;

  if (g_pg_exit == 0) {
    g_pmd_cm_base_addr = g_pmd_cm_base_addr_lut[g_cm_rescal_codes.m_master_cm];

    do {
      v_cm_rdy = READ_REG_FIELD (g_pmd_cm_base_addr, PMD_CM__CTRL_FSM_CM_STAT0__CM_RDY);
    } while (v_cm_rdy != 1);

    g_cm_rescal_codes.m_code = READ_REG_FIELD (g_pmd_cm_base_addr, PMD_CM__PMD_CM_OVRDVAL2__CMX_RESCAL_CODEOUT_O_7_0);
  }
}




void cm_power_up() {
  g_reg_val = READ_REG (g_cm_base_addr,CM__ANA_OVRDVAL1__ADDR) ;
  SET_FIELD (g_reg_val, CM__ANA_OVRDVAL1__CM_ANA_BG_EN, 0x1);
  SET_FIELD (g_reg_val, CM__ANA_OVRDVAL1__CM_ANA_BG_EN_DCO, 0x1);
  SET_FIELD (g_reg_val, CM__ANA_OVRDVAL1__CM_ANA_BG_CHOP_EN, 0x1);
  SET_FIELD (g_reg_val, CM__ANA_OVRDVAL1__CM_ANA_BG_BYP_FILT, 0x0);
  SET_FIELD (g_reg_val, CM__ANA_OVRDVAL1__CM_ANA_BG_VREF_FAST_START, 0x0);
  WRITE_REG (g_cm_base_addr, CM__ANA_OVRDVAL1__ADDR, g_reg_val);

  g_reg_val = READ_REG (g_cm_base_addr,CM__ANA_OVRDVAL10__ADDR) ;
  SET_FIELD (g_reg_val, CM__ANA_OVRDVAL10__CM_ANA_REFRES_RESMODE, 0x1);
  SET_FIELD (g_reg_val, CM__ANA_OVRDVAL10__CM_ANA_REFRES_BIAS_EN, 0x1);
  WRITE_REG (g_cm_base_addr, CM__ANA_OVRDVAL10__ADDR, g_reg_val);


  g_reg_val = READ_REG( g_cm_base_addr, CM__ANA_OVRDVAL11__ADDR);
  SET_FIELD (g_reg_val, CM__ANA_OVRDVAL11__CM_ANA_REFRES_RES_CODE_7_0, g_cm_rescal_codes.m_code);
  WRITE_REG (g_cm_base_addr, CM__ANA_OVRDVAL11__ADDR, g_reg_val);

  g_reg_val = READ_REG (g_cm_base_addr,CM__ANA_OVRDVAL13__ADDR) ;
  SET_FIELD (g_reg_val, CM__ANA_OVRDVAL13__CM_ANA_VREG_DOUBLER_EN, 0x1);
  SET_FIELD (g_reg_val, CM__ANA_OVRDVAL13__CM_ANA_VREG_DOUBLER_FAST_START, 0x0);
  WRITE_REG (g_cm_base_addr, CM__ANA_OVRDVAL13__ADDR, g_reg_val);
 


  
  g_reg_val = READ_REG (g_cm_base_addr,CM__ANA_OVRDEN0__ADDR) ;
  SET_FIELD (g_reg_val, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_BG_EN, 0x1);
  SET_FIELD (g_reg_val, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_BG_EN_DCO, 0x1);
  WRITE_REG (g_cm_base_addr, CM__ANA_OVRDEN0__ADDR, g_reg_val);
 
  g_reg_val = READ_REG (g_cm_base_addr,CM__ANA_OVRDEN4__ADDR) ;
  SET_FIELD (g_reg_val, CM__ANA_OVRDEN4__OVRD_EN_CM_ANA_REFRES_RESMODE, 0x1);
  SET_FIELD (g_reg_val, CM__ANA_OVRDEN4__OVRD_EN_CM_ANA_REFRES_BIAS_EN, 0x1);
  WRITE_REG (g_cm_base_addr, CM__ANA_OVRDEN4__ADDR, g_reg_val);

  g_reg_val = READ_REG (g_cm_base_addr,CM__ANA_OVRDEN0__ADDR) ;
  SET_FIELD (g_reg_val, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_BG_CHOP_EN, 0x1);
  WRITE_REG (g_cm_base_addr, CM__ANA_OVRDEN0__ADDR, g_reg_val);

  delay_ns(5000); 

  g_reg_val = READ_REG( g_cm_base_addr, CM__ANA_OVRDEN4__ADDR);
  SET_FIELD (g_reg_val, CM__ANA_OVRDEN4__OVRD_EN_CM_ANA_REFRES_RES_CODE, 0x1);
  WRITE_REG (g_cm_base_addr, CM__ANA_OVRDEN4__ADDR, g_reg_val); 
  
  g_reg_val = READ_REG (g_cm_base_addr,CM__ANA_OVRDEN0__ADDR) ;
  SET_FIELD (g_reg_val, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_BG_BYP_FILT, 0x1);
  SET_FIELD (g_reg_val, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_BG_VREF_FAST_START, 0x1);
  WRITE_REG (g_cm_base_addr, CM__ANA_OVRDEN0__ADDR, g_reg_val);

  g_reg_val = READ_REG (g_cm_base_addr,CM__ANA_OVRDEN6__ADDR) ;
  SET_FIELD (g_reg_val, CM__ANA_OVRDEN6__OVRD_EN_CM_ANA_VREG_DOUBLER_EN, 0x1);
  WRITE_REG (g_cm_base_addr, CM__ANA_OVRDEN6__ADDR, g_reg_val);


  delay_ns(300); 

  g_reg_val = READ_REG (g_cm_base_addr,CM__ANA_OVRDEN6__ADDR) ;
  SET_FIELD (g_reg_val, CM__ANA_OVRDEN6__OVRD_EN_CM_ANA_VREG_DOUBLER_FAST_START, 0x1);
  WRITE_REG (g_cm_base_addr, CM__ANA_OVRDEN6__ADDR, g_reg_val);


}





ATTR_INLINE void pmd_cm_power_up () {
  
  uint8_t v_cm_no, v_lane_no;

  if ((gPmdConfigBlock.m_use_cm0_only == 1 && gPmdConfigBlock.m_use_cm1_only == 0) || g_retimer_en) {
    v_cm_no = 0;

    g_pmd_cm_base_addr = g_pmd_cm_base_addr_lut[1] ;
    g_cm_base_addr = g_cm_base_addr_lut[1] ;
 
  } else if (gPmdConfigBlock.m_use_cm0_only == 0 && gPmdConfigBlock.m_use_cm1_only == 1) {
    v_cm_no = 1;

    g_pmd_cm_base_addr = g_pmd_cm_base_addr_lut[0] ;
    g_cm_base_addr = g_cm_base_addr_lut[0] ;
 
  } else {
    return;
  }

  cm_power_up ();

  for(v_lane_no = 0; v_lane_no<g_num_lane; v_lane_no++) {
    g_pmd_lane_rx_base_addr = g_pmd_lane_rx_base_addr_lut[v_lane_no];
    g_pmd_lane_tx_base_addr = g_pmd_lane_tx_base_addr_lut[v_lane_no];
    WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_LANE_CFG0__CM_SEL, v_cm_no );
    WRITE_REG_FIELD( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_LANE_CFG0__CM_SEL, v_cm_no );

  }

}




int main () {

  fw_ver_dccm_to_dccm ();

  fw_init ();

  if (g_num_cm > 1) {
    startup_2cm_pmix_inl_cal ();
  }

  static_config ();


  pmd_cm__rescal_code_save ();

  pmd_cm_power_up ();

  while (1) {
    
    fw__vmt_handler ();
    
  }  
}


 

ATTR_INLINE void cnt_ref_clk (uint8_t a_lane_no) {

  bool v_poll_done = false;

  if (gRxLaneConfigBlock[a_lane_no].m_start_refclk_cntr == 1) {
   
    WRITE_REG_FIELD(g_rx_base_addr_lut[a_lane_no], RX__GENERIC_CAL0__CALCOMP_COUNTER_DIVREFCLK_CNT_11_0, gPmdConfigBlock.m_refclk_cntr_samples);
 
    WRITE_REG_FIELD(g_rx_base_addr_lut[a_lane_no], RX__GENERIC_CAL0__CALCOMP_COUNTER_START, 0); 
 
     
    WRITE_REG_FIELD(g_rx_base_addr_lut[a_lane_no], RX__CAL_SETTINGS0__CAL_COMP_CLK_REFCLK_DIV_4_0, gRxLaneConfigBlock[a_lane_no].m_refclk_cntr_div1);

    g_dccm_time_stamp_rx[a_lane_no][e_dts_rx_100] = dump_rtc();   

    WRITE_REG_FIELD(g_rx_base_addr_lut[a_lane_no], RX__GENERIC_CAL0__CALCOMP_COUNTER_START, 1); 
  
    v_poll_done = false;
    do {
      v_poll_done = READ_REG_FIELD (g_rx_base_addr_lut[a_lane_no], RX__STATUS11__CALCOMP_COUNTER_DONE);
    } while ((v_poll_done == false) && (gRxLaneConfigBlock[a_lane_no].m_stop_refclk_cntr == 0));
 
    g_dccm_time_stamp_rx[a_lane_no][e_dts_rx_101] = dump_rtc();   
    g_dccm_time_stamp_rx[a_lane_no][e_dts_rx_102] = g_dccm_time_stamp_rx[a_lane_no][e_dts_rx_101] - g_dccm_time_stamp_rx[a_lane_no][e_dts_rx_100] ; 
 
    WRITE_REG_FIELD(g_rx_base_addr_lut[a_lane_no], RX__GENERIC_CAL0__CALCOMP_COUNTER_START, 0); 
 
    do {
      v_poll_done = READ_REG_FIELD (g_rx_base_addr_lut[a_lane_no], RX__STATUS11__CALCOMP_COUNTER_DONE);
    } while (v_poll_done == true);
  
    
    WRITE_REG_FIELD(g_rx_base_addr_lut[a_lane_no], RX__CAL_SETTINGS0__CAL_COMP_CLK_REFCLK_DIV_4_0, gRxLaneConfigBlock[a_lane_no].m_refclk_cntr_div2);

    g_dccm_time_stamp_rx[a_lane_no][e_dts_rx_103] = dump_rtc();
 
    WRITE_REG_FIELD(g_rx_base_addr_lut[a_lane_no], RX__GENERIC_CAL0__CALCOMP_COUNTER_START, 1);
  
    v_poll_done = false;
    do {
      v_poll_done = READ_REG_FIELD (g_rx_base_addr_lut[a_lane_no], RX__STATUS11__CALCOMP_COUNTER_DONE);
    } while ((v_poll_done == false) && (gRxLaneConfigBlock[a_lane_no].m_stop_refclk_cntr == 0));
 
    g_dccm_time_stamp_rx[a_lane_no][e_dts_rx_104] = dump_rtc();   
    g_dccm_time_stamp_rx[a_lane_no][e_dts_rx_105] = g_dccm_time_stamp_rx[a_lane_no][e_dts_rx_104] - g_dccm_time_stamp_rx[a_lane_no][e_dts_rx_103] ; 
 
    WRITE_REG_FIELD(g_rx_base_addr_lut[a_lane_no], RX__GENERIC_CAL0__CALCOMP_COUNTER_START, 0); 
 
    do {
      v_poll_done = READ_REG_FIELD (g_rx_base_addr_lut[a_lane_no], RX__STATUS11__CALCOMP_COUNTER_DONE);
    } while (v_poll_done == true);
  } 

}


ATTR_INLINE void cpu_clk_log () {

if (gPmdConfigBlock.m_enable_cpu_clk_log) {
  bool v_poll_start = false;
  bool v_poll_stop = false;

  do {
    v_poll_start = gPmdConfigBlock.m_start_cpu_clk_log;
    delay_ns(10000);
  } while (v_poll_start == 0);

  g_dccm_time_stamp_fw[e_dts_fw_10] = dump_rtc(); 

  do {
    v_poll_stop = gPmdConfigBlock.m_stop_cpu_clk_log;
    delay_ns(10000);
  } while (v_poll_stop == 0);

  g_dccm_time_stamp_fw[e_dts_fw_11] = dump_rtc(); 
  g_dccm_time_stamp_fw[e_dts_fw_12] = g_dccm_time_stamp_fw[e_dts_fw_11] - g_dccm_time_stamp_fw[e_dts_fw_10]  ; 
}

}


