void func_rx_fwcmd_restore_reset_defaults (uint8_t fsm_no) {
  uint8_t v_lane_no = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;

  rx_t *vp_rx = &g_rx[v_lane_no];

  g_dccm_time_stamp_rx[v_lane_no][e_dts_rx_4_pwrup_cmd1] = dump_rtc();

  vp_rx->m_rx_rate = READ_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_RATE_I_5_0);


  g_reg_val = READ_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__KRT_OVRD_VAL0__ADDR) ;
  SET_FIELD (g_reg_val, PMD_LANE_RX__KRT_OVRD_VAL0__OVRD_VAL_RX_TXFFE_CN_TRAIN_DONE, 0x0) ;
  SET_FIELD (g_reg_val, PMD_LANE_RX__KRT_OVRD_VAL0__OVRD_VAL_RX_TXFFE_C0_TRAIN_DONE, 0x0) ;
  WRITE_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__KRT_OVRD_VAL0__ADDR, g_reg_val) ;

  g_reg_val = READ_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__KRT_OVRD_EN1__ADDR) ;
  SET_FIELD (g_reg_val, PMD_LANE_RX__KRT_OVRD_EN1__OVRD_EN_RX_TXFFE_CN_TRAIN_DONE, 0x0) ;
  SET_FIELD (g_reg_val, PMD_LANE_RX__KRT_OVRD_EN1__OVRD_EN_RX_TXFFE_C0_TRAIN_DONE, 0x0) ;
  WRITE_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__KRT_OVRD_EN1__ADDR, g_reg_val) ;

  WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__BASER_PMD_CONTROL__TRAINING_ENABLE, 0x0); 


  gKrtFlag[v_lane_no] = 0;

  rx__restore_reset_defaults (v_lane_no);
  handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
}

