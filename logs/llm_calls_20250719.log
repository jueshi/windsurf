inline void config_tx_pwrseq (uint8_t vLaneNo) {

  tx_t *vp_tx = &g_tx[vLaneNo];

  uint32_t vI;
  uint32_t vAddrOfst;

  struct tPowerSequencePstateStep_t *vpPowerUpSequencePstateStepLut;
  struct tPowerSequencePstateStep_t *vpPowerDownSequencePstateStepLut;

  

    vpPowerUpSequencePstateStepLut   = &gEthTxPowerUpSequencePstateStepLut;
    vpPowerDownSequencePstateStepLut = &gEthTxPowerDownSequencePstateStepLut;


  
  g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_PWRUP_CFG32__ADDR );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRUP_CFG32__TX_PWRUP_RST_STEP_MAPPING_5_0, vpPowerUpSequencePstateStepLut->rst_step_map );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRUP_CFG32__TX_PWRUP_P2_STEP_MAPPING_5_0 , vpPowerUpSequencePstateStepLut->p2_step_map  );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRUP_CFG32__TX_PWRUP_P1_STEP_MAPPING_5_0 , vpPowerUpSequencePstateStepLut->p1_step_map  );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRUP_CFG32__TX_PWRUP_P0S_STEP_MAPPING_5_0, vpPowerUpSequencePstateStepLut->p0s_step_map );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRUP_CFG32__TX_PWRUP_P0_STEP_MAPPING_5_0 , vpPowerUpSequencePstateStepLut->p0_step_map  );
  WRITE_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_PWRUP_CFG32__ADDR, g_reg_val );


  vAddrOfst = 0x0;
  for (vI = 0; vI <= vpPowerUpSequencePstateStepLut->p0_step_map ; vI=vI+2)
  {
    if (vp_tx->m_tx_mode == e_pcie_mode) { 
      g_reg_val = (uint32_t)(*((uint32_t *)&gPcieTxPowerUpSequenceTableLut[vI]));
    } else {  
      g_reg_val = (uint32_t)(*((uint32_t *)&gEthTxPowerUpSequenceTableLut[vI]));
    }

    WRITE_REG( g_pmd_lane_tx_base_addr, (PMD_LANE_TX__TX_PWRUP_CFG0__ADDR + vAddrOfst), g_reg_val );
    
    vAddrOfst += 0x04;
  }

  
  g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_PWRDN_CFG16__ADDR );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRDN_CFG16__TX_PWRDN_RST_STEP_MAPPING_4_0, vpPowerDownSequencePstateStepLut->rst_step_map );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRDN_CFG16__TX_PWRDN_P2_STEP_MAPPING_4_0 , vpPowerDownSequencePstateStepLut->p2_step_map  );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRDN_CFG16__TX_PWRDN_P1_STEP_MAPPING_4_0 , vpPowerDownSequencePstateStepLut->p1_step_map  );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRDN_CFG16__TX_PWRDN_P0S_STEP_MAPPING_4_0, vpPowerDownSequencePstateStepLut->p0s_step_map );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRDN_CFG16__TX_PWRDN_P0_STEP_MAPPING_4_0 , vpPowerDownSequencePstateStepLut->p0_step_map  );
  WRITE_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_PWRDN_CFG16__ADDR, g_reg_val );

  vAddrOfst = 0x0;
  for (vI = 0; vI <= vpPowerDownSequencePstateStepLut->rst_step_map ; vI=vI+2)
  {
    if (vp_tx->m_tx_mode == e_pcie_mode) { 
      g_reg_val = (uint32_t)(*((uint32_t *)&gPcieTxPowerDownSequenceLut[vI]));
    } else {  
      g_reg_val = (uint32_t)(*((uint32_t *)&gEthTxPowerDownSequenceLut[vI]));
    }

    WRITE_REG( g_pmd_lane_tx_base_addr, (PMD_LANE_TX__TX_PWRDN_CFG0__ADDR + vAddrOfst), g_reg_val );
    
    vAddrOfst += 0x04;
  }


}

void set_tx_lane_config (uint8_t vLaneNo, bool a_tx_cals_use_pads) {

  g_pmd_lane_tx_base_addr = g_pmd_lane_tx_base_addr_lut[vLaneNo];

  

  bool v_tx_mode;
  tx_t *vp_tx = &g_tx[vLaneNo];
  
  
  v_tx_mode = READ_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_LANE_CFG0__TX_LANE_MODE );
 
  


  tx__static_config(vLaneNo, v_tx_mode, a_tx_cals_use_pads); 


  
  trigger_tx_ack_check [vLaneNo] = 0;
  gTxBrkPointState[vLaneNo] = e_req1_st;

  if (g_pg_exit == 0) {
    gTxFwRptStrupCount[vLaneNo] = 1;
    gTxRptStrupFlag[vLaneNo] = 0;
  }

  for (int v_idx = 0; v_idx < NUM_PCIE_SR_PLLX_CNTX; v_idx++) {
    vp_tx->m_tx_cal_save_done [v_idx] = 0;  
  }
  

  
  gTxLaneConfigBlock[vLaneNo].m_tx_cca_en = 1;
  


  config_tx_pwrseq (vLaneNo);

  
  if ((g_fw_fastsim_en == 1) && (g_fw_ufastsim_0_fastsim_1 == 0)) { 
    gTxLaneConfigBlock[vLaneNo].m_tx_cca_en = 0;
  }

  WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_FW_CSR1__TX_NO_CCA_FW_CTL, (gTxLaneConfigBlock[vLaneNo].m_tx_cca_en == 1 ? 0 : 1));

  
  

  
  WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_LANE_CFG0__CM_SEL, ((g_num_cm == 2 ) && (vLaneNo >= 2)) );
  



  


  if (v_tx_mode == e_pcie_mode) {  
    WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_SPARE_CFG0__LOGICAL_TX_MUX_SEL_1_0, vLaneNo );

    if(g_fw_skip_pcie_repeat_strup == 0) {
      WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_PWRUP_CFG33__TX_REPEAT_STRUP_3_0, 0x1 );  
    }
  }

  if (g_fw_fastsim_en == 1) {

  } else {  
    g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_FW_CSR4__ADDR );
    SET_FIELD( g_reg_val, PMD_LANE_TX__TX_FW_CSR4__TX_DO_DCC_CAL_1_0, 3);
    SET_FIELD( g_reg_val, PMD_LANE_TX__TX_FW_CSR4__TX_DO_DLL_CAL_1_0, 3);
    SET_FIELD( g_reg_val, PMD_LANE_TX__TX_FW_CSR4__TX_DO_IQ_CAL_1_0, 3);
    WRITE_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_FW_CSR4__ADDR, g_reg_val );
  }


  
  

  
  

  
}





void tx_handler_req_decode (uint8_t fsm_no) {

  uint8_t vReqType;

  g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_FW_CSR1__ADDR );
  vReqType = GET_FIELD( g_reg_val, PMD_LANE_TX__TX_FW_CSR1__TX_FW_REQ_TYPE_2_0 );
  g_reg_val = GET_FIELD( g_reg_val, PMD_LANE_TX__TX_FW_CSR1__TX_FW_REQ );

  if (g_reg_val == 1) {
    switch(vReqType) {
      case eTxHandlerReqType_PwrCmd:
        g_reg_val  = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_FW_CSR0__ADDR );
          
        handler_func_pntr[fsm_no] = GET_FIELD( g_reg_val, PMD_LANE_TX__TX_FW_CSR0__TX_FW_PWRCMD_5_0 );
      
        handler_cmd_arg[fsm_no]   = GET_FIELD( g_reg_val, PMD_LANE_TX__TX_FW_CSR0__TX_FW_PWRCMD_ARG_2_0 );
        break;

      case eTxHandlerReqType_Cca:
        handler_func_pntr[fsm_no] = eTxHandlerSt_TxCcaMisMode;
        break;


      default:
        handler_func_pntr[fsm_no] = eTxHandlerSt_TxNop;
        break;
    }

    handshake_fsm_st[fsm_no] = e_pmd_handler_req_st;
  } 
}


void tx_handler_ack_gen (uint8_t fsm_no) {
  uint8_t vLaneNo;
  uint8_t vPollCntr = 0;

  vLaneNo = fsm_no - MAX_NUM_CM;

  
  WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_FW_CSR1__TX_FW_ACK, 0x1 );

  
  do {
    g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_FW_CSR1__ADDR );
    g_reg_val = GET_FIELD( g_reg_val, PMD_LANE_TX__TX_FW_CSR1__TX_FW_REQ );
    vPollCntr++;
  } while ((g_reg_val==1) && (vPollCntr < 10));

  if ((g_reg_val==1) && (vPollCntr == 10)) {
    return;
  }

  
  WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_FW_CSR1__TX_FW_ACK, 0x0 );

  handshake_fsm_st[fsm_no] = e_pmd_handler_idle_st;
}



void func_tx_fwcmd_host_brk_pnt (uint8_t fsm_no) {
  uint8_t vLaneNo = fsm_no - MAX_NUM_CM;
  uint32_t base; uint32_t offset; 
  uint32_t req_val; uint32_t ack_val;
 
  base = g_pmd_lane_tx_base_addr;

  offset = PMD_LANE_TX__TX_FW_CSR6__ADDR;
  req_val = 0x1;    
  ack_val = 0x2;    

  g_reg_val = READ_REG (base, offset);

  switch (gTxBrkPointState[vLaneNo]) {
    case e_req1_st: 
      WRITE_REG (base, offset, g_reg_val | req_val);            
      gTxBrkPointState[vLaneNo] = e_ack1_poll_req0_st;          
      break;

    case e_ack1_poll_req0_st:
      if ((g_reg_val & ack_val) == ack_val) {                   
        WRITE_REG (base, offset, g_reg_val & (~(req_val)));     
        gTxBrkPointState[vLaneNo] = e_ack0_poll_st;             
      }
      break;

    case e_ack0_poll_st:
      if ((g_reg_val & ack_val) != ack_val) {                  
        gTxBrkPointState[vLaneNo] = e_req1_st;                 
        handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;       
      }
      break;
  }
}


void func_tx_fwcmd_err (uint8_t fsm_no) {
  g_reg_val = READ_REG( PMD_BASE_ADDR, PMD__FW_CSR0__ADDR );
  SET_FIELD( g_reg_val, PMD__FW_CSR0__FW_ERROR, 1 );
  SET_FIELD( g_reg_val, PMD__FW_CSR0__FW_ERROR_CODE_9_0, 1 );
  WRITE_REG( PMD_BASE_ADDR, PMD__FW_CSR0__ADDR, g_reg_val );
 
  while (1) {};
 
}



void func_tx_fwcmd_nop (uint8_t fsm_no) {
  handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
}


void func_tx_fwcmd_pll_rdy_chk (uint8_t fsm_no) {
  
  uint8_t vLaneNo, vCmNo, vPollCntr;

  vLaneNo = fsm_no - MAX_NUM_CM;

  vCmNo = READ_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_PLL_SEL_I );

  vPollCntr = 0;

  do {
    vPollCntr++;

    g_reg_val = READ_REG_FIELD( g_pmd_cm_base_addr_lut[vCmNo], PMD_CM__CTRL_FSM_CM_STAT0__CTRL_FSM_PLLX_ST_3_0 );

    if (g_reg_val == 10) { 
      handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
      vPollCntr = 11;
    }
  } while (vPollCntr <= 10);

}

void pmd_tx__set_link_maps (uint8_t a_lane_no, bool a_enable1_disable0) {

  tx_t *vp_tx = &g_tx[a_lane_no];

  for (uint8_t v_cm_no = 0; v_cm_no < g_num_cm; v_cm_no++) {
    g_reg_val = READ_REG_FIELD( g_pmd_cm_base_addr_lut[v_cm_no], PMD_CM__CM_CFG6__TX_PLL_LINK_MAP_7_0 );
    if (a_enable1_disable0 && (v_cm_no == vp_tx->m_tx_pll_sel)) { 
      g_reg_val = g_reg_val | (1 << a_lane_no);
    } else { 
      g_reg_val = g_reg_val & (~(1 << a_lane_no));
    }
    WRITE_REG_FIELD( g_pmd_cm_base_addr_lut[v_cm_no], PMD_CM__CM_CFG6__TX_PLL_LINK_MAP_7_0, g_reg_val );
  }

  uint8_t v_cm_sel; 
  v_cm_sel = ((g_num_cm == 2) && (a_lane_no >= 2)) ? 1 : 0;

  g_reg_val = READ_REG_FIELD( g_pmd_cm_base_addr_lut[v_cm_sel], PMD_CM__CM_CFG0__TX_LANE_LINK_MAP_7_0 );
  if (a_enable1_disable0) {
    g_reg_val = g_reg_val | (1 << a_lane_no);
  } else {
    g_reg_val = g_reg_val & (~(1 << a_lane_no));
  }
  WRITE_REG_FIELD( g_pmd_cm_base_addr_lut[v_cm_sel], PMD_CM__CM_CFG0__TX_LANE_LINK_MAP_7_0, g_reg_val );

}


void func_tx_fwcmd_rate_cfgs (uint8_t fsm_no) {
  uint8_t vLaneNo = fsm_no - MAX_NUM_CM;

  tx_t *vp_tx = &g_tx[vLaneNo];

  uint8_t tx_symdata_width;

  union tPmdLaneTxTxFwCsr4TxFwSpare0_t vPmdLaneTxTxFwCsr4TxFwSpare0;

  
  g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDVAL0__ADDR );
  vp_tx->m_tx_pll_sel = GET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_PLL_SEL_I );
  vp_tx->m_tx_rate    = GET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_RATE_I_5_0 );
  tx_symdata_width    = GET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_WIDTH_I_3_0 );

  if ((vp_tx->m_tx_mode == e_pcie_mode) && (g_fw_skip_pcie_repeat_strup == 0) && (gTxFwRptStrupCount[vLaneNo] == 1)) {    
    gTxPcieSaveRate[vLaneNo]  = vp_tx->m_tx_rate;
    gTxPcieSaveWidth[vLaneNo] = tx_symdata_width;

    g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDVAL0__ADDR );
    SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_RATE_I_5_0, 5 );  
    SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_WIDTH_I_3_0, 6 ); 
    WRITE_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDVAL0__ADDR, g_reg_val );

    g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDEN0__ADDR );
    SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDEN0__OVRD_EN_TXX_RATE_I, 0x1 );  
    SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDEN0__OVRD_EN_TXX_WIDTH_I, 0x1 ); 
    WRITE_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDEN0__ADDR, g_reg_val );


  } else if (vp_tx->m_tx_mode == e_eth_mode) {
    
    if (vp_tx->m_tx_rate == 62) {           
      WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_LANE_CFG0__TX_SIGNAL_TYPE, 0 );
    } else if (vp_tx->m_tx_rate == 63) {    
      WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_LANE_CFG0__TX_SIGNAL_TYPE, 1 );
    }

    
    vPmdLaneTxTxFwCsr4TxFwSpare0.reg = READ_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_FW_CSR4__TX_FW_SPARE0_24_0 );

    if (vPmdLaneTxTxFwCsr4TxFwSpare0.fields.mTxXNewRate == 1) {
      vp_tx->m_tx_rate  = vPmdLaneTxTxFwCsr4TxFwSpare0.fields.mTxXNewRateEncoding;
    }

    trigger_tx_ack_check[vLaneNo] = 1; 
  }

  vp_tx->m_tx_rate_idx = rate_index_map[vp_tx->m_tx_rate];
  vp_tx->m_tx_rate_width_idx = rate_width_index_map[vp_tx->m_tx_rate_idx][tx_symdata_width];
  


  
  pmd_tx__set_link_maps(vLaneNo, true); 
  

  

  
  




  


  
  union tPmdLaneTxTxFwCsr5TxFwSpare1_t v_pmd_lane_tx_tx_fw_csr5_tx_fw_spare1;
  v_pmd_lane_tx_tx_fw_csr5_tx_fw_spare1.reg = READ_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_FW_CSR5__TX_FW_SPARE1_31_0 );

  vp_tx->m_tx_ne_serial_lpbk_en = v_pmd_lane_tx_tx_fw_csr5_tx_fw_spare1.fields.m_txX_ne_serial_lpbk_en;
  
  

  
  if (vp_tx->m_tx_rate_idx != 255) { 
    WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_LANE_CFG0__TX_SIGNAL_TYPE, gRateConfigMasterDefaults[vp_tx->m_tx_rate_idx].tx0_signal_type_i );

    tx__rate_config (vLaneNo);
  }
  

  tx__ne_serial_lpbk_config (vLaneNo); 

  handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
}


void func_tx_fwcmd_fractional_div_cfgs (uint8_t fsm_no) {
  uint8_t vLaneNo = fsm_no - MAX_NUM_CM;
  bool v_done = false;

  if (g_tx[vLaneNo].m_tx_1p25_div_retry_iter == 0) {
  }

  v_done = tx__fractional_div_config (vLaneNo);

  if (v_done == true) {
    g_tx[vLaneNo].m_tx_1p25_div_retry_iter = 0;
    handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
  }
}



void func_tx_fwcmd_level_cal (uint8_t fsm_no) {
  
  uint8_t v_lane_no = fsm_no - MAX_NUM_CM;

  tx_t *vp_tx = &g_tx[v_lane_no];

  if (vp_tx->m_tx_level_cal_st == e_tx_level_cal_done_st) {
    vp_tx->m_tx_level_cal_st = e_tx_level_cal_cfg_st;

    handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;

  } else {
    tx__level_cal (v_lane_no);
  }

}




void func_tx_fwcmd_clk_align_req (uint8_t fsm_no) {

  uint8_t vLaneNo = fsm_no - MAX_NUM_CM;
  bool vSkipClkAlign;

  vSkipClkAlign = READ_REG_FIELD (g_pmd_lane_tx_base_addr,PMD_LANE_TX__TX_PWRDN_CFG16__TX_SKIP_CLK_ALIGN);

  if (!vSkipClkAlign) {
    tx__clk_align (vLaneNo) ;
  }
   
  handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
