  }
}



void func_tx_fwcmd_level_cal (uint8_t fsm_no) {
  
  uint8_t v_lane_no = fsm_no - MAX_NUM_CM;

  tx_t *vp_tx = &g_tx[v_lane_no];

  if (vp_tx->m_tx_level_cal_st == e_tx_level_cal_done_st) {
    vp_tx->m_tx_level_cal_st = e_tx_level_cal_cfg_st;

    handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;

