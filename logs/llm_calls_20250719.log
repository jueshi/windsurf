ATTR_INLINE void cm__static_config (uint8_t a_cm_no, bool a_pll_mode) {

  g_cm_base_addr = g_cm_base_addr_lut[a_cm_no];


  
  cm_t *vp_cm = &g_cm[a_cm_no];

  vp_cm->m_pll_mode         = a_pll_mode;
  vp_cm->m_pllX_cntx_sr_idx = NUM_PCIE_SR_PLLX_CNTX;

  if (g_pg_exit == 0) { 
    for (uint8_t i = 0; i < NUM_PCIE_SR_PLLX_CNTX; i++) {
      vp_cm->m_pll_cal_code_save_done[i] = false;
    }
  }
  


  if (g_fw_fastsim_en == 1) { 
  } else {  

  }

  if (vp_cm->m_pll_mode == e_eth_mode) {  
    WRITE_REG_FIELD (g_cm_base_addr, CM__PLL0_CFG2__PLL0_SKIP_LOCK_DETECT, 0);
  }


  


  

  if (gCmConfigBlock[a_cm_no].m_cm_skip_wa4_cm_pll_slow_temp_track == 0) {
    g_reg_val = READ_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDVAL7__CM_ANA_PLL_TEST_VCO_31_0);
    WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDVAL7__CM_ANA_PLL_TEST_VCO_31_0, g_reg_val);

    g_reg_val = READ_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDVAL8__CM_ANA_PLL_TEST_VCO_63_32);
    g_reg_val = (g_reg_val & 0xFFFFF807) | (25 << 3) ;
    WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDVAL8__CM_ANA_PLL_TEST_VCO_63_32, g_reg_val);

    WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDEN2__OVRD_EN_CM_ANA_PLL_TEST_VCO, 1);
  }

  
  
  


  
  
}




ATTR_INLINE void cm__pll_cntx_config (uint8_t a_cm_no, uint8_t a_pllX_cntx) {
  uint8_t v_pllX_cntx_idx;
  uint8_t v_fbdiv_div5_en = 0;

  const struct tCmPLLConfigMasterDefaults_t *vp_cntx_config_master_defaults;

  cm_t *vp_cm = &g_cm[a_cm_no];
  
  if (vp_cm->m_pll_mode == e_pcie_mode) {
  }

  v_pllX_cntx_idx = cntx_index_map[a_pllX_cntx];  
   
  vp_cntx_config_master_defaults = &gCmPLLConfigMasterDefaults[v_pllX_cntx_idx];
  
  if (v_pllX_cntx_idx != 255) {  
    WRITE_REG_FIELD(g_cm_base_addr, CM__PLL0_CFG2__PLL0_FBCLKDIV_10_0, vp_cntx_config_master_defaults->pll0_fbclkdiv);

    g_reg_val = READ_REG (g_cm_base_addr, CM__PLL0_CFG5__ADDR);
    SET_FIELD (g_reg_val, CM__PLL0_CFG5__PLL0_PREDIV_4_0, vp_cntx_config_master_defaults->pll0_prediv);
    SET_FIELD (g_reg_val, CM__PLL0_CFG5__PLL0_WORDCLK_DIV_3_0, vp_cntx_config_master_defaults->pll0_wordclk_div);
    SET_FIELD (g_reg_val, CM__PLL0_CFG5__PLL0_WORDCLK_DIV5_SEL, vp_cntx_config_master_defaults->pll0_wordclk_div5_sel);
    WRITE_REG (g_cm_base_addr, CM__PLL0_CFG5__ADDR, g_reg_val);

    WRITE_REG_FIELD(g_cm_base_addr, CM__PLL0_CFG6__PLL0_DIG_FBDIV_SEL, vp_cntx_config_master_defaults->pll0_dig_fbdiv_sel);

    g_reg_val = READ_REG( g_cm_base_addr, CM__PLL0_CFG23__ADDR );
    SET_FIELD(g_reg_val, CM__PLL0_CFG23__PLL0_LOOPCLK_CALIB_CNT_COARSE_7_0, vp_cntx_config_master_defaults->pll0_loopclk_calib_cnt_coarse);
    SET_FIELD(g_reg_val, CM__PLL0_CFG23__PLL0_LOOPCLK_CALIB_CNT_FINE_7_0, vp_cntx_config_master_defaults->pll0_loopclk_calib_cnt_fine);
    WRITE_REG( g_cm_base_addr, CM__PLL0_CFG23__ADDR, g_reg_val);

    g_reg_val = READ_REG (g_cm_base_addr, CM__ANA_OVRDVAL0__ADDR);
    SET_FIELD (g_reg_val, CM__ANA_OVRDVAL0__CM_ANA_PLL_BW_14_0, vp_cntx_config_master_defaults->cm_ana_pll_bw);
    SET_FIELD (g_reg_val, CM__ANA_OVRDVAL0__CM_ANA_PLL_FBDIV_DIV4_EN, vp_cntx_config_master_defaults->cm_ana_pll_fbdiv_div4_en);
    SET_FIELD (g_reg_val, CM__ANA_OVRDVAL0__CM_ANA_PLL_PMIX_DIV4_EN, vp_cntx_config_master_defaults->cm_ana_pll_pmix_div4_en);
    WRITE_REG (g_cm_base_addr, CM__ANA_OVRDVAL0__ADDR, g_reg_val);

    g_reg_val = READ_REG (g_cm_base_addr, CM__ANA_OVRDEN0__ADDR);
    SET_FIELD (g_reg_val, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_PLL_BW, 1);
    SET_FIELD (g_reg_val, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_PLL_FBDIV_DIV4_EN, 1);
    SET_FIELD (g_reg_val, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_PLL_PMIX_DIV4_EN, 1);
    WRITE_REG (g_cm_base_addr, CM__ANA_OVRDEN0__ADDR, g_reg_val);


    uint32_t v_cm_ana_spare, v_ovrd_en_cm_ana_spare;

    v_cm_ana_spare         = READ_REG(g_cm_base_addr, CM__ANA_OVRDVAL12__CM_ANA_SPARE_I_31_0__ADDR);
    v_ovrd_en_cm_ana_spare = READ_REG(g_cm_base_addr, CM__ANA_OVRDEN5__OVRD_EN_CM_ANA_SPARE_I_31_0__ADDR);

      v_cm_ana_spare         = vp_cntx_config_master_defaults->cm_ana_spare_i;
      v_ovrd_en_cm_ana_spare = (vp_cntx_config_master_defaults->ovrd_en_cm_ana_spare_i) | (0x1FE00); 
      gCmConfigBlock[a_cm_no].m_pll_curr_code = (vp_cntx_config_master_defaults->cm_ana_spare_i & 0x1FE00) >> 9;
    WRITE_REG(g_cm_base_addr, CM__ANA_OVRDVAL12__CM_ANA_SPARE_I_31_0__ADDR, v_cm_ana_spare);
    WRITE_REG(g_cm_base_addr, CM__ANA_OVRDEN5__OVRD_EN_CM_ANA_SPARE_I_31_0__ADDR, v_ovrd_en_cm_ana_spare);


    uint8_t v_vco_range_sel_addr_start = 0;
    uint8_t v_vco_coarse_start = 16;

    if (gCmConfigBlock[a_cm_no].m_cm_skip_wa2_pll0_range_sel == 0 && (a_pllX_cntx == 2 || a_pllX_cntx ==3)) { 
      v_vco_range_sel_addr_start = 0;
      v_vco_coarse_start = 8;
      
    } else { 
      v_vco_range_sel_addr_start = vp_cntx_config_master_defaults->pll0_vco_range_sel_addr_start;
      v_vco_coarse_start = 16;
    }

    WRITE_REG_FIELD(g_cm_base_addr, CM__PLL0_CFG22__PLL0_VCO_RANGE_SEL_ADDR_START_4_0, v_vco_range_sel_addr_start);
    WRITE_REG_FIELD (g_cm_base_addr, CM__PLL0_CFG2__PLL0_VCO0_COARSE_START_4_0, v_vco_coarse_start);
    
    WRITE_REG_FIELD(g_cm_base_addr, CM__ANA_OVRDVAL14__CM_ANA_SPEED_I_15_0, vp_cntx_config_master_defaults->cm_ana_speed_i);
    WRITE_REG_FIELD(g_cm_base_addr, CM__ANA_OVRDEN4__OVRD_EN_CM_ANA_SPEED_I, 1);

    WRITE_REG_FIELD(g_cm_base_addr, CM__ANA_OVRDVAL4__CM_ANA_PLL_SPAREIN_5_0, vp_cntx_config_master_defaults->cm_ana_pll_sparein);
    WRITE_REG_FIELD(g_cm_base_addr, CM__ANA_OVRDEN2__OVRD_EN_CM_ANA_PLL_SPAREIN_5_0, 0x3F);

    WRITE_REG_FIELD(g_cm_base_addr, CM__ANA_OVRDVAL5__CM_ANA_PLL_TEST_7_0, vp_cntx_config_master_defaults->cm_ana_pll_test);
    WRITE_REG_FIELD(g_cm_base_addr, CM__ANA_OVRDEN3__OVRD_EN_CM_ANA_PLL_TEST_7_0, 0xFF);

    g_reg_val = READ_REG( g_cm_base_addr, CM__PLL0_SSC_CFG0__ADDR );
    SET_FIELD( g_reg_val, CM__PLL0_SSC_CFG0__PLL0_SSC_UP_SPREAD, vp_cntx_config_master_defaults->pll0_ssc_up_spread );
    SET_FIELD( g_reg_val, CM__PLL0_SSC_CFG0__PLL0_SSC_STEP_SIZE_20_0, vp_cntx_config_master_defaults->pll0_ssc_step_size );
    WRITE_REG( g_cm_base_addr, CM__PLL0_SSC_CFG0__ADDR, g_reg_val );

    g_reg_val = READ_REG( g_cm_base_addr, CM__PLL0_SSC_CFG1__ADDR );
    SET_FIELD( g_reg_val, CM__PLL0_SSC_CFG1__PLL0_SSC_MINT_11_0, vp_cntx_config_master_defaults->pll0_ssc_mint );
    SET_FIELD( g_reg_val, CM__PLL0_SSC_CFG1__PLL0_SSC_PEAK_19_0, vp_cntx_config_master_defaults->pll0_ssc_peak );
    WRITE_REG( g_cm_base_addr, CM__PLL0_SSC_CFG1__ADDR, g_reg_val );

    g_reg_val = READ_REG( g_cm_base_addr, CM__PLL0_CFG24__ADDR);
    SET_FIELD( g_reg_val, CM__PLL0_CFG24__PLL0_PI_FBDIV_SAMPLE_SEL, vp_cntx_config_master_defaults->pll0_pi_fbdiv_sample_sel);
    SET_FIELD( g_reg_val, CM__PLL0_CFG24__PLL0_ETH0_PCIE1_MODE, (!vp_cm->m_pll_mode));
    WRITE_REG( g_cm_base_addr, CM__PLL0_CFG24__ADDR, g_reg_val);

    WRITE_REG_FIELD (g_cm_base_addr, CM__PLL0_CFG32__PLL0_CAL_FINE_CALIB_TOL_11_0, vp_cntx_config_master_defaults->pll0_cal_fine_calib_tol);

    if (g_fw_fastsim_en == 1) {
    } else {
      WRITE_REG_FIELD (g_cm_base_addr, CM__PIN_OVRDVAL3__INT_PLL0_SHORT_LOCK_EN_I, vp_cntx_config_master_defaults->pll0_short_lock_en_i);
    }

    WRITE_REG_FIELD (g_cm_base_addr, CM__PIN_OVRDVAL0__INT_CM_REF_RANGE_I_3_0, vp_cntx_config_master_defaults->cm_ref_range_i);

    g_reg_val = READ_REG (g_cm_base_addr, CM__PIN_OVRDEN0__ADDR);
    SET_FIELD (g_reg_val, CM__PIN_OVRDEN0__OVRD_EN_PLL0_SHORT_LOCK_EN_I, 1);
    SET_FIELD (g_reg_val, CM__PIN_OVRDEN0__OVRD_EN_CM_REF_RANGE_I, 1);
    WRITE_REG (g_cm_base_addr, CM__PIN_OVRDEN0__ADDR, g_reg_val);
  }


  v_fbdiv_div5_en |= READ_REG_FIELD (g_cm_base_addr, CM__PLL0_CFG24__PLL0_DIV_VCOCLK_DIV5_SEL);
  v_fbdiv_div5_en |= READ_REG_FIELD (g_cm_base_addr, CM__PLL0_CFG2__PLL0_CLKOUT_VCOCLK_DIV5_SEL);   
  v_fbdiv_div5_en |= READ_REG_FIELD (g_cm_base_addr, CM__PLL0_CFG5__PLL0_WORDCLK_DIV5_SEL);

  WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDVAL0__CM_ANA_PLL_FBDIV_DIV5_EN, v_fbdiv_div5_en);
  WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_PLL_FBDIV_DIV5_EN, 1);


  
  if ((a_pllX_cntx == 8) || (a_pllX_cntx == 9)){ 
    WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDVAL4__CM_ANA_PLL_TEST_CLKPATH_ITAIL_INC, gCmConfigBlock[a_cm_no].m_cm_ana_pll_test_clkpath_itail_inc_10g_cntx);
    WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDVAL2__CM_ANA_PLL_INC_CURR_DIV2_BUF, gCmConfigBlock[a_cm_no].m_cm_ana_pll_inc_curr_div2_buf_10g_cntx);
 
  }else{
    WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDVAL4__CM_ANA_PLL_TEST_CLKPATH_ITAIL_INC, gCmConfigBlock[a_cm_no].m_cm_ana_pll_test_clkpath_itail_inc_non_10g_cntx);
    WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDVAL2__CM_ANA_PLL_INC_CURR_DIV2_BUF, gCmConfigBlock[a_cm_no].m_cm_ana_pll_inc_curr_div2_buf_non_10g_cntx);
  }

  WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDEN2__OVRD_EN_CM_ANA_PLL_TEST_CLKPATH_ITAIL_INC, 1);
  WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDEN1__OVRD_EN_CM_ANA_PLL_INC_CURR_DIV2_BUF, 1);
  



}




