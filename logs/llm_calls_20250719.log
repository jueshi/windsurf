ATTR_INLINE void pmd_tx__pmix_inl_tx_cfg (uint8_t a_lane_no) {
  
  uint8_t v_txx_pll_sel = ((g_num_cm ==2) && (a_lane_no >= 2));
  uint8_t v_inl_rate = ( gRxLaneConfigBlock[a_lane_no].m_pmix_inl_rate_sel_106g1_53g0 ? e_ref_156p25m_eth_106g : e_ref_156p25m_eth_53g ) ;    

  g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDVAL0__ADDR );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_RESET_I, 1 );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_CLK_RDY_I, 0 );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_MASTER_PLL_STATE_I, 1 );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_WIDTH_I_3_0, 9 ); 
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_RATE_I_5_0, v_inl_rate );
  if(a_lane_no < 2) {
    SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_PLL_SEL_I, 0 ); 
  } else {
    SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_PLL_SEL_I, 1 ); 
  }
  WRITE_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDVAL0__ADDR, g_reg_val );

  WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__FREQ_CODE_FWD0__FCODE_FWD_BYPASS, 0); 
  WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__FREQ_CODE_FWD6__TX_WORD_CLK_CM_SEL_2_0, v_txx_pll_sel );

  g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDEN0__ADDR );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDEN0__OVRD_EN_TXX_RESET_I, 1 );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDEN0__OVRD_EN_TXX_CLK_RDY_I, 1 );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDEN0__OVRD_EN_TXX_MASTER_PLL_STATE_I, 1 );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDEN0__OVRD_EN_TXX_WIDTH_I, 1 );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDEN0__OVRD_EN_TXX_RATE_I, 1 );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDEN0__OVRD_EN_TXX_PLL_SEL_I, 1 );
  WRITE_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDEN0__ADDR, g_reg_val );

  g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDVAL0__ADDR );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_RESET_I, 0 );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_CLK_RDY_I, 1 );
  WRITE_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDVAL0__ADDR, g_reg_val );

}


