#include "rx.h"







void rx__adapt_en ( uint8_t a_lane_no, uint8_t a_adapt_mode_start, uint8_t a_adapt_mode_end ) {

  uint8_t a_stats_capture_window_ldVal;

  rx_t *vp_rx = &g_rx[a_lane_no];

  if (a_adapt_mode_start < 16) {
    if (g_fw_fastsim_en == 1) {  
      a_stats_capture_window_ldVal = gRateConfigMasterDefaults[vp_rx->m_rx_rate_idx].stats_capture_window_ldval_sim;
    } else {  
      a_stats_capture_window_ldVal = gRateConfigMasterDefaults[vp_rx->m_rx_rate_idx].stats_capture_window_ldval_lab;
      } 

  } else { 
    a_stats_capture_window_ldVal = gRateClockDependentDefaults[vp_rx->m_rx_rate_clk_idx].stats_capture_window_ldval_cdr;
    }

  WRITE_REG_FIELD (g_rx_base_addr, RX__MODE_CTL0__STATS_CAPTURE_WINDOW_LDVAL_10_0, a_stats_capture_window_ldVal);

  a_adapt_mode_end = (a_adapt_mode_start > a_adapt_mode_end) ? a_adapt_mode_start : a_adapt_mode_end ;
  
  g_reg_val = READ_REG(g_rx_base_addr, RX__PIN_OVRDVAL3__ADDR);
  SET_FIELD (g_reg_val,RX__PIN_OVRDVAL3__INT_RX0_ADAPT_MODE_START_I_4_0, a_adapt_mode_start);
  SET_FIELD (g_reg_val,RX__PIN_OVRDVAL3__INT_RX0_ADAPT_MODE_END_I_4_0,   a_adapt_mode_end);
  SET_FIELD (g_reg_val,RX__PIN_OVRDVAL3__INT_RX0_ADAPT_ABORT_I,          0 );
  SET_FIELD (g_reg_val,RX__PIN_OVRDVAL3__INT_RX0_ADAPT_EN_I,             0 );
  WRITE_REG (g_rx_base_addr, RX__PIN_OVRDVAL3__ADDR, g_reg_val);
  
  g_reg_val = READ_REG(g_rx_base_addr, RX__PIN_OVRDEN1__ADDR);
  SET_FIELD (g_reg_val,RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_MODE_START_I,1);
  SET_FIELD (g_reg_val,RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_MODE_END_I,1);
  WRITE_REG (g_rx_base_addr, RX__PIN_OVRDEN1__ADDR, g_reg_val);
  
  WRITE_REG_FIELD( g_rx_base_addr, RX__PIN_OVRDEN2__OVRD_EN_RX0_ADAPT_ABORT_I, 1 );
  WRITE_REG_FIELD( g_rx_base_addr, RX__PIN_OVRDEN1__OVRD_EN_RX0_ADAPT_EN_I,    1 );

  WRITE_REG_FIELD (g_rx_base_addr, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_EN_I, 0x1);
}




void rx__adapt_done_poll (uint8_t a_lane_no){

  uint8_t a_adapt_done, a_poll_cntr;
  
  rx_t *vp_rx = &g_rx[a_lane_no];
  
  switch (vp_rx->m_rx_adapt_done_st)
  {
    case e_rx_adapt_done_assert_poll:
    
      a_poll_cntr = 0;
     
      do {
         a_adapt_done = READ_REG_FIELD (g_rx_base_addr, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_DONE_O);
         a_poll_cntr++;
      }  while ((a_adapt_done == 0) && (a_poll_cntr < 10));
     
     
      if (a_adapt_done == 1){
     	  WRITE_REG_FIELD (g_rx_base_addr, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_EN_I, 0x0);
     
     	  vp_rx->m_rx_adapt_done_st = e_rx_adapt_done_deassert_poll;
      }
      break;
    
    
    case e_rx_adapt_done_deassert_poll:
    
      a_poll_cntr = 0;
     
      do {
       	a_adapt_done = READ_REG_FIELD (g_rx_base_addr, RX__PIN_OVRDVAL3__INT_RX0_ADAPT_DONE_O);
        a_poll_cntr++;
      }  while ((a_adapt_done == 1) && (a_poll_cntr < 10));
     
      if (a_adapt_done == 0){
        vp_rx->m_rx_adapt_done_st = e_rx_adapt_done_handshake_closed;
      }
      break;
     
     
    case e_rx_adapt_done_handshake_closed:
    
      break;
  
  }
}


