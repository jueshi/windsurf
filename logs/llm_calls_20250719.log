  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_PLL_SEL_I, vp_pmd_tx_cfg_settings_h->m_txX_pll_sel );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_CLK_RDY_I, vp_pmd_tx_cfg_settings_h->m_txX_clk_rdy );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_MASTER_PLL_STATE_I, vp_pmd_tx_cfg_settings_h->m_txX_master_pll_st );
  WRITE_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDVAL0__ADDR, g_reg_val );
  WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDEN0__OVRD_EN_TXX_MASTER_PLL_STATE_I, vp_pmd_tx_cfg_settings_h->m_txX_master_pll_st_ovrden );
