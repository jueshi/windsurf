#ifndef __CM_H__
#define __CM_H__


#include "fw.h"




typedef enum cm_rescal_mode {
  e_rescal_mode_master = 0,
  e_rescal_mode_slave  = 1
} cm_rescal_mode_t;

typedef enum vco_srf_cal_st {
  e_vco_srf_cal_poll_st      = 0,
  e_vco_srf_cal_re_start_st  = 1,
  e_vco_srf_cal_re_enable_st = 2,
  e_vco_srf_cal_re_lock_st   = 3,
  e_vco_srf_cal_err_st       = 4,
  e_vco_srf_cal_done_st      = 5,
} vco_srf_cal_st_t;


typedef struct cm {
  bool                  m_pll_mode;                                       
  uint8_t               m_pllX_cntx;
  uint8_t               m_pllX_cntx_sr_idx;                               
  bool                  m_pll_cal_code_save_done [NUM_PCIE_SR_PLLX_CNTX]; 
  struct delay_timer_t  m_pll_lock_timer;
} cm_t;


typedef struct cm_rescal_codes {
  uint16_t  m_master_cm : 8;
  uint16_t  m_code      : 8;
} cm_rescal_codes_t;

typedef struct pll_cal_codes {
  uint32_t reserved         : 8;  
  uint32_t current_code     : 8;
  uint32_t range_sel        : 4;
  uint32_t calib_fine_bin   : 4;
  uint32_t calib_coarse_bin : 5;
  uint32_t vco_sel          : 2;  
} pll_cal_codes_t;

typedef struct vctl_tsense_lut {
  uint8_t temp;

  uint8_t vco_gain_cal_lvl_bg : 6;  
  uint8_t vco_gain_cal_bg     : 2;  
} vctl_tsense_lut_t;

typedef struct pmd_pll_cfg_settings {
  uint8_t m_pll_cntx;
} pmd_pll_cfg_settings;


extern pmd_pll_cfg_settings pmd_pll_cfg_settings_h  [MAX_NUM_CM];

extern cm_rescal_codes_t g_cm_rescal_codes;

extern pll_cal_codes_t g_pll_cal_codes [MAX_NUM_CM] [NUM_PCIE_SR_PLLX_CNTX];

extern uint16_t pll_curr_code_scale_lut [NUM_VCO_RANGE_SEL] [NUM_COARSE_CODES];

extern vctl_tsense_lut_t g_vctl_tsense_lut[40];


extern uint32_t g_cm_base_addr;
extern cm_t     g_cm [MAX_NUM_CM];


extern ATTR_INLINE void cm__static_config               (uint8_t a_cm_no, bool v_pll_mode);
extern ATTR_INLINE void cm__pll_cntx_config             (uint8_t a_cm_no, uint8_t a_pllX_cntx);
extern ATTR_INLINE void cm__pll_cal_code_restore        (uint8_t a_cm_no);
