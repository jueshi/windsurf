#include "fw_delay.h"
#include "arc_reg.h"





 




uint32_t gDelay1Nop_ns;



static uint64_t rtc_ticks_per_us;











static inline uint64_t read_rtc()
{
	uint32_t rtc_low, rtc_ctrl;
	uint64_t rtc_high, rtc;

	
	do
	{
		rtc_low = _lr(AUX_RTC_LOW);
		rtc_high = (uint64_t)(_lr(AUX_RTC_HIGH));
		rtc_ctrl = _lr(AUX_RTC_CTRL);
	}
	while (!(rtc_ctrl & 0x80000000));

	rtc = rtc_low;
	rtc |= (rtc_high << 32);

	return rtc;
}

void delay_init(uint32_t cpu_clk_freq)
{
	_sr(1, AUX_RTC_CTRL);
	rtc_ticks_per_us = cpu_clk_freq;


  gDelay1Nop_ns = 4000 / cpu_clk_freq; 

}

void delay_start(struct delay_timer_t *delay, uint32_t us)
{
	uint64_t current_rtc_ticks;
    
	uint64_t delay_ticks;

	
	delay_ticks = ((uint64_t) (us * rtc_ticks_per_us));

	current_rtc_ticks = read_rtc();

    delay->to_ticks = current_rtc_ticks + delay_ticks;
}




void delay_cancel(struct delay_timer_t *delay)
{
	delay->to_ticks = 0;
}


bool delay_is_done(struct delay_timer_t *delay)
{
    uint64_t timer_ticks;
	
	timer_ticks = read_rtc();

	if (timer_ticks >= delay->to_ticks)
	{
		delay->to_ticks = 0;
		return 1;
	}

    return 0;
}

void delay_num_nop(uint32_t aNum)
{
    uint32_t vI;
    for (vI = 0; vI < aNum; vI++)
    {
        _nop();
    }
}





inline void wait_for_nops (uint32_t wait_nop_cnt) {
   do {
      __asm__ __volatile__(" nop");
      wait_nop_cnt--;
   } while (wait_nop_cnt > 0);      
}


void delay_ns (uint32_t delay_ns) {

  wait_for_nops (((delay_ns / gDelay1Nop_ns) + 1));
}



uint64_t dump_rtc()
{
	uint32_t rtc_low, rtc_ctrl;
	uint64_t rtc_high, rtc;

	
	do
	{
		rtc_low = _lr(AUX_RTC_LOW);
		rtc_high = (uint64_t)(_lr(AUX_RTC_HIGH));
		rtc_ctrl = _lr(AUX_RTC_CTRL);
	}
	while (!(rtc_ctrl & 0x80000000));

	rtc = rtc_low;
	rtc |= (rtc_high << 32);

	return rtc;
}



