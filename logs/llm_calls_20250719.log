ATTR_INLINE void tx__dcc_cal_cm_patgen_cfg (uint8_t a_lane_no) {

  tx_t *vp_tx = &g_tx[a_lane_no];

  WRITE_REG_FIELD (g_tx_base_addr, TX__TST_CFG0__PATGEN_EN, 0x0) ;

  WRITE_REG_FIELD (g_tx_base_addr, TX__TST_CFG0__PATTERN_SEL_4_0, 22) ;

  g_reg_val = READ_REG (g_tx_base_addr, TX__TXS_CFG0__ADDR);
  SET_FIELD (g_reg_val, TX__TXS_CFG0__GRAYCODE_EN, gRateConfigMasterDefaults[vp_tx->m_tx_rate_idx].tx0_signal_type_i ); 
  SET_FIELD (g_reg_val, TX__TXS_CFG0__PRECODE_EN, 0x0);
  WRITE_REG (g_tx_base_addr, TX__TXS_CFG0__ADDR, g_reg_val); 

  uint32_t v_high_data_pattern = gRateConfigMasterDefaults[vp_tx->m_tx_rate_idx].tx0_signal_type_i ? 0x55555555 : 0xFFFFFFFF;

  WRITE_REG (g_tx_base_addr, TX__TST_CFG1__ADDR, 0x0) ;
  WRITE_REG (g_tx_base_addr, TX__TST_CFG2__ADDR, 0x0) ;
  WRITE_REG (g_tx_base_addr, TX__TST_CFG3__ADDR, v_high_data_pattern );
  WRITE_REG (g_tx_base_addr, TX__TST_CFG4__ADDR, v_high_data_pattern );
  WRITE_REG (g_tx_base_addr, TX__TST_CFG5__ADDR, 0x0) ;
  WRITE_REG (g_tx_base_addr, TX__TST_CFG9__ADDR, 0x0) ;
  WRITE_REG (g_tx_base_addr, TX__TST_CFG10__ADDR, v_high_data_pattern );
  WRITE_REG (g_tx_base_addr, TX__TST_CFG11__ADDR, v_high_data_pattern );

  WRITE_REG_FIELD (g_tx_base_addr, TX__TXS_DCC_CAL_CTRL0__DCC_CAL_CM_USE_PATGEN, 0x1) ; 
}

ATTR_INLINE bool tx__vcm_vref_cal (uint8_t a_lane_no) {

  tx_t *vp_tx = &g_tx[a_lane_no];

  bool v_done = false, v_poll_done; 
  uint8_t v_poll_cntr;


  switch (vp_tx->m_tx_ana_vref_cal_st) {
    case e_tx_ana_vref_cal_cfg_st: {

      vp_tx->m_tx_ana_vref_cal_code       = 512 ; 
      vp_tx->m_tx_ana_vref_cal_code_step  = 256 ; 
      
      g_reg_val = READ_REG (g_tx_base_addr, TX__ANA_OVRDVAL5__ADDR) ;
      SET_FIELD (g_reg_val, TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_COMP_MODE_1_0, 0x2) ; 
      SET_FIELD (g_reg_val, TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_REF_SEL_9_0, vp_tx->m_tx_ana_vref_cal_code ); 
      WRITE_REG (g_tx_base_addr,TX__ANA_OVRDVAL5__ADDR, g_reg_val) ;

      g_reg_val = READ_REG (g_tx_base_addr, TX__ANA_OVRDVAL6__ADDR) ;
      SET_FIELD (g_reg_val, TX__ANA_OVRDVAL6__ANA_TX_ANA_CAL_MUXA_SEL_3_0, 0x1) ; 
      SET_FIELD (g_reg_val, TX__ANA_OVRDVAL6__ANA_TX_ANA_CAL_MUXB_SEL_3_0, 0x0) ; 
      SET_FIELD (g_reg_val, TX__ANA_OVRDVAL6__ANA_TX_ANA_CAL_EN, 0x0) ;

      WRITE_REG (g_tx_base_addr,TX__ANA_OVRDVAL6__ADDR, g_reg_val) ;


      g_reg_val = READ_REG (g_tx_base_addr,TX__ANA_OVRDEN1__ADDR) ; 
      SET_FIELD (g_reg_val, TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_CAL_COMP_MODE, 0x1) ; 
      SET_FIELD (g_reg_val, TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_CAL_REF_SEL, 0x1) ;

      WRITE_REG (g_tx_base_addr,TX__ANA_OVRDEN1__ADDR, g_reg_val) ; 
      
      g_reg_val = READ_REG (g_tx_base_addr, TX__ANA_OVRDEN4__ADDR) ;
      SET_FIELD (g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CAL_MUXA_SEL, 0x1) ; 
      SET_FIELD (g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CAL_MUXB_SEL, 0x1) ; 
      SET_FIELD (g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CAL_EN, 0x1) ; 

      WRITE_REG (g_tx_base_addr,TX__ANA_OVRDEN4__ADDR, g_reg_val) ; 
     
      WRITE_REG_FIELD (g_tx_base_addr, TX__ANA_OVRDVAL0__ANA_TX_ANA_DRV_REP_EN, 0x1) ; 

      g_reg_val = READ_REG (g_tx_base_addr, TX__ANA_OVRDEN5__ADDR) ;
      SET_FIELD (g_reg_val, TX__ANA_OVRDEN5__OVRD_EN_TX_ANA_DRV_REP_EN, 0x1) ;
      WRITE_REG (g_tx_base_addr,TX__ANA_OVRDEN5__ADDR, g_reg_val) ; 

      WRITE_REG_FIELD (g_tx_base_addr, TX__TXS_CFG1__CAL_COMP_SAMPLE_CNT_14_0, vp_tx->m_tx_ana_vref_cal_samp_cnt ); 

      WRITE_REG_FIELD (g_tx_base_addr, TX__ANA_OVRDVAL6__ANA_TX_ANA_CAL_EN, 0x1) ; 

      vp_tx->m_tx_ana_vref_cal_st = e_tx_ana_vref_cal_code_change_st ; 
    }
  
    case e_tx_ana_vref_cal_code_change_st: {
      
      g_reg_val = READ_REG (g_tx_base_addr, TX__ANA_OVRDVAL5__ADDR) ;
      SET_FIELD (g_reg_val, TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_REF_SEL_9_0, vp_tx->m_tx_ana_vref_cal_code) ; 

      WRITE_REG (g_tx_base_addr, TX__ANA_OVRDVAL5__ADDR, g_reg_val) ; 

      v_poll_cntr = 0;

      do {
        v_poll_done = READ_REG_FIELD (g_tx_base_addr, TX__TXS_STAT0__CAL_SAMPLE_DONE);
        v_poll_cntr++;
      } while ((v_poll_done == true) && (v_poll_cntr < 10));

      if (v_poll_done == true) {
        break;
      }
      
      WRITE_REG_FIELD (g_tx_base_addr, TX__TXS_CFG1__CAL_SAMPLE_START, 0x1) ;  
      
      vp_tx->m_tx_ana_vref_cal_st = e_tx_ana_vref_cal_decision_st ;       
    }

    case e_tx_ana_vref_cal_decision_st: {
      
      g_reg_val = READ_REG_FIELD (g_tx_base_addr, TX__TXS_STAT0__CAL_SAMPLE_DONE) ; 

      if (g_reg_val == 1) { 

        g_reg_val = READ_REG_FIELD (g_tx_base_addr, TX__TXS_STAT0__CAL_COMP_SAMPLE_COUNT_14_0) ; 
         
        WRITE_REG_FIELD (g_tx_base_addr, TX__TXS_CFG1__CAL_SAMPLE_START, 0x0) ;


        if (vp_tx->m_tx_ana_vref_cal_code_step > 0) { 
          if (g_reg_val >= (vp_tx->m_tx_ana_vref_cal_samp_cnt/2)) {
            vp_tx->m_tx_ana_vref_cal_code += vp_tx->m_tx_ana_vref_cal_code_step; 
          } else {
            vp_tx->m_tx_ana_vref_cal_code -= vp_tx->m_tx_ana_vref_cal_code_step; 
          }
        } else { 
          if (g_reg_val >= (vp_tx->m_tx_ana_vref_cal_samp_cnt/2)) {
            if (vp_tx->m_tx_ana_vref_cal_code >= 1023) {
            }
          } else {
            vp_tx->m_tx_ana_vref_cal_code = vp_tx->m_tx_ana_vref_cal_code - 1; 
          }
        }

        if(vp_tx->m_tx_ana_vref_cal_code_step > 0) {
          vp_tx->m_tx_ana_vref_cal_code_step = vp_tx->m_tx_ana_vref_cal_code_step/2;
          vp_tx->m_tx_ana_vref_cal_st = e_tx_ana_vref_cal_code_change_st;
          break;
        } else { 
          g_reg_val = READ_REG (g_tx_base_addr, TX__ANA_OVRDVAL5__ADDR) ; 
          SET_FIELD (g_reg_val, TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_REF_SEL_9_0, vp_tx->m_tx_ana_vref_cal_code) ; 

          WRITE_REG (g_tx_base_addr, TX__ANA_OVRDVAL5__ADDR, g_reg_val) ; 

          vp_tx->m_tx_ana_vref_cal_st = e_tx_ana_vref_cal_done_st;
        }
      
      } else { 
        break;
      }

    }

    case e_tx_ana_vref_cal_done_st: {

      WRITE_REG_FIELD (g_tx_base_addr, TX__ANA_OVRDVAL6__ANA_TX_ANA_CAL_EN, 0x0) ;

      
      g_reg_val = READ_REG (g_tx_base_addr,TX__ANA_OVRDEN1__ADDR) ;
      SET_FIELD (g_reg_val, TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_CAL_COMP_MODE, 0x0) ; 
      WRITE_REG (g_tx_base_addr,TX__ANA_OVRDEN1__ADDR, g_reg_val) ; 
      
      g_reg_val = READ_REG (g_tx_base_addr, TX__ANA_OVRDEN4__ADDR) ;
      SET_FIELD (g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CAL_MUXA_SEL, 0x0) ; 
      SET_FIELD (g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CAL_MUXB_SEL, 0x0) ; 
      SET_FIELD (g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CAL_EN, 0x0) ;
      WRITE_REG (g_tx_base_addr,TX__ANA_OVRDEN4__ADDR, g_reg_val) ; 
      
      g_reg_val = READ_REG (g_tx_base_addr, TX__ANA_OVRDEN5__ADDR) ;
      SET_FIELD (g_reg_val, TX__ANA_OVRDEN5__OVRD_EN_TX_ANA_DRV_REP_EN, 0x0) ;
      WRITE_REG (g_tx_base_addr,TX__ANA_OVRDEN5__ADDR, g_reg_val) ; 

      vp_tx->m_tx_ana_vref_cal_st = e_tx_ana_vref_cal_cfg_st;

      v_done = true ; 
      break;
    }
  }

  return (v_done) ;

}

ATTR_INLINE bool tx__dcc_replica_vref_cal (uint8_t a_lane_no) {

  tx_t *vp_tx = &g_tx[a_lane_no];
  bool v_done = false;

  tx_dcc_cal_settings *vp_tx_dcc_cal_codes_restore = &(vp_tx->m_tx_dcc_cal_codes_restore);

  switch (vp_tx->m_tx_dcc_replica_vref_cal_st) {

    case e_tx_dcc_replica_vref_cfg_st: {
      vp_tx->m_tx_dcc_replica_vref_phases_done_cnt = 0;
      vp_tx->m_tx_dcc_replica_vref_cal_st = e_tx_dcc_replica_vref_apply_dcc_st;
    }
    
    case e_tx_dcc_replica_vref_apply_dcc_st: {
      g_reg_val = READ_REG( g_tx_base_addr, TX__ANA_OVRDVAL8__ADDR );
      SET_FIELD( g_reg_val, TX__ANA_OVRDVAL8__ANA_TX_ANA_CLKGEN_DCC0_6_0, vp_tx_dcc_cal_codes_restore->dcc000_cal_code );
      SET_FIELD( g_reg_val, TX__ANA_OVRDVAL8__ANA_TX_ANA_CLKGEN_DCC90_6_0, vp_tx_dcc_cal_codes_restore->dcc090_cal_code );
      SET_FIELD( g_reg_val, TX__ANA_OVRDVAL8__ANA_TX_ANA_CLKGEN_DCC180_6_0, vp_tx_dcc_cal_codes_restore->dcc180_cal_code );
      SET_FIELD( g_reg_val, TX__ANA_OVRDVAL8__ANA_TX_ANA_CLKGEN_DCC270_6_0, vp_tx_dcc_cal_codes_restore->dcc270_cal_code );
      SET_FIELD( g_reg_val, TX__ANA_OVRDVAL8__ANA_TX_ANA_CLKGEN_DCC_LA_CLK, 0 );
      WRITE_REG( g_tx_base_addr, TX__ANA_OVRDVAL8__ADDR, g_reg_val );
      
      g_reg_val = READ_REG( g_tx_base_addr, TX__ANA_OVRDEN4__ADDR );

      SET_FIELD( g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CLKGEN_DCC0,   1 );
      SET_FIELD( g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CLKGEN_DCC90,  1 );
      SET_FIELD( g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CLKGEN_DCC180, 1 );
      SET_FIELD( g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CLKGEN_DCC270, 1 );
      SET_FIELD( g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CLKGEN_DCC_LA_CLK, 1 );

      WRITE_REG( g_tx_base_addr, TX__ANA_OVRDEN4__ADDR, g_reg_val );

      g_reg_val = READ_REG( g_tx_base_addr, TX__ANA_OVRDVAL8__ADDR );
      SET_FIELD( g_reg_val, TX__ANA_OVRDVAL8__ANA_TX_ANA_CLKGEN_DCC_LA_CLK, 1 );
      WRITE_REG( g_tx_base_addr, TX__ANA_OVRDVAL8__ADDR, g_reg_val );
      SET_FIELD( g_reg_val, TX__ANA_OVRDVAL8__ANA_TX_ANA_CLKGEN_DCC_LA_CLK, 0 );
      WRITE_REG( g_tx_base_addr, TX__ANA_OVRDVAL8__ADDR, g_reg_val );

      vp_tx->m_tx_dcc_replica_vref_cal_st = e_tx_dcc0_replica_vref_cal_cfg_st;
    }

    case e_tx_dcc0_replica_vref_cal_cfg_st: {
      WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL5__ANA_TX_ANA_DRV_DAC_CAL_STATIC_PATTERN_3_0, 0x9 ); 
      WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_DRV_DAC_CAL_STATIC_PATTERN, 0x1 ); 

      vp_tx->m_tx_dcc_replica_vref_cal_st = e_tx_run_ref_cal_st;
      break;
    }

    case e_tx_dcc90_replica_vref_cal_cfg_st: {
      vp_tx_dcc_cal_codes_restore->dcc000_cal_ref_sel_replica = READ_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_REF_SEL_9_0 );

      WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL5__ANA_TX_ANA_DRV_DAC_CAL_STATIC_PATTERN_3_0, 0x3 ); 

      vp_tx->m_tx_dcc_replica_vref_cal_st = e_tx_run_ref_cal_st;
      break;
    }

    case e_tx_dcc180_replica_vref_cal_cfg_st: {
      vp_tx_dcc_cal_codes_restore->dcc090_cal_ref_sel_replica = READ_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_REF_SEL_9_0 );

      WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL5__ANA_TX_ANA_DRV_DAC_CAL_STATIC_PATTERN_3_0, 0x6 ); 

      vp_tx->m_tx_dcc_replica_vref_cal_st = e_tx_run_ref_cal_st;
      break;
    }

    case e_tx_dcc270_replica_vref_cal_cfg_st: {
      vp_tx_dcc_cal_codes_restore->dcc180_cal_ref_sel_replica = READ_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_REF_SEL_9_0 );

      WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL5__ANA_TX_ANA_DRV_DAC_CAL_STATIC_PATTERN_3_0, 0xC ); 

      vp_tx->m_tx_dcc_replica_vref_cal_st = e_tx_run_ref_cal_st;
      break;
    }

    case e_tx_run_ref_cal_st: {
      bool v_vref_cal_done = tx__vcm_vref_cal(a_lane_no);

      if (v_vref_cal_done) { 

        vp_tx->m_tx_dcc_replica_vref_phases_done_cnt++; 

        if (vp_tx->m_tx_dcc_replica_vref_phases_done_cnt == 4) { 
          vp_tx_dcc_cal_codes_restore->dcc270_cal_ref_sel_replica = READ_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_REF_SEL_9_0 );

          vp_tx->m_tx_dcc_replica_vref_cal_st = e_tx_dcc_replica_vref_cal_done_st;
        } else { 
          vp_tx->m_tx_dcc_replica_vref_cal_st = e_tx_dcc0_replica_vref_cal_cfg_st + vp_tx->m_tx_dcc_replica_vref_phases_done_cnt; 
          break;
        }
      } else { 
        vp_tx->m_tx_dcc_replica_vref_cal_st = e_tx_run_ref_cal_st;
        break;
      }
    }

    case e_tx_dcc_replica_vref_cal_done_st: {
      g_reg_val = READ_REG( g_tx_base_addr, TX__ANA_OVRDEN4__ADDR );
      SET_FIELD( g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CLKGEN_DCC0,   0 );
      SET_FIELD( g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CLKGEN_DCC90,  0 );
      SET_FIELD( g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CLKGEN_DCC180, 0 );
      SET_FIELD( g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CLKGEN_DCC270, 0 );
      SET_FIELD( g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CLKGEN_DCC_LA_CLK, 0 );

      WRITE_REG( g_tx_base_addr, TX__ANA_OVRDEN4__ADDR, g_reg_val );

      g_reg_val = READ_REG( g_tx_base_addr, TX__ANA_OVRDEN1__ADDR );
      SET_FIELD( g_reg_val, TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_DRV_DAC_CAL_STATIC_PATTERN, 0x0 );
      SET_FIELD( g_reg_val, TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_CAL_REF_SEL, 0x0 );

      WRITE_REG( g_tx_base_addr, TX__ANA_OVRDEN1__ADDR, g_reg_val ); 

      v_done = true;
      vp_tx->m_tx_dcc_replica_vref_cal_st = e_tx_dcc_replica_vref_cfg_st;
      break;
    }
  }

  return v_done;
}


ATTR_INLINE bool tx__calibrations (uint8_t a_lane_no, bool a_strup_dcc_skip, bool a_strup_iq_skip) {

  tx_t *vp_tx = &g_tx[a_lane_no];
  bool    v_poll_done;
  uint8_t v_poll_cntr;
  bool    v_done = false;
  uint8_t v_dcc_loop_max = (vp_tx->m_tx_cals_use_pads ? (gTxLaneConfigBlock[a_lane_no].m_tx_dcc_pad_txpn_avg_en ? 4 : 2) : 2); 
  tx_dcc_cal_settings *vp_tx_dcc_cal_codes_restore = &(vp_tx->m_tx_dcc_cal_codes_restore);

  if (g_fw_fastsim_en == 1) {
  }

  switch (vp_tx->m_tx_cal_st) {
    case e_tx_dcc_iq_onetime_setup: {
      if (vp_tx->m_tx_cals_use_pads) { 
        tx__patgen_cfg_save (a_lane_no);
        tx__dcc_cal_cm_patgen_cfg (a_lane_no);
      }

      g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL15__ADDR );
      SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL15__DCC_CAL_STARTUP_LINEAR_SEARCH_VOTING_MODE, 0 );
      SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL15__DCC_CAL_STARTUP_LINEAR_SEARCH_LOOP_COUNT_6_0, gTxLaneConfigBlock[a_lane_no].m_tx_strup_dcc_lin_loop_cnt );
      WRITE_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL15__ADDR, g_reg_val );

      g_reg_val = READ_REG ( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL0__ADDR );
      SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL0__TX_IQ_CAL_STARTUP_LINEAR_SEARCH_VOTING_MODE, 0 );
      SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL0__TX_IQ_CAL_STARTUP_LINEAR_SEARCH_LOOP_COUNT_6_0, gTxLaneConfigBlock[a_lane_no].m_tx_strup_iq_lin_loop_cnt );
      WRITE_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL0__ADDR, g_reg_val );

      g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL3__ADDR );
      SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL3__TX_PHC_I_CAL_REPLICA_STATIC_PATTERN_3_0, gTxLaneConfigBlock[a_lane_no].m_iq_cal_replica_i_static_pattern );
      SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL3__TX_PHC_Q_CAL_REPLICA_STATIC_PATTERN_3_0, gTxLaneConfigBlock[a_lane_no].m_iq_cal_replica_i_static_pattern );
      WRITE_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL3__ADDR, g_reg_val );

      if (vp_tx->m_tx_cals_use_pads) { 
        g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL4__ADDR );
        SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_PHC_I_CAL_STATIC_PATTERN_3_0, gTxLaneConfigBlock[a_lane_no].m_iq_cal_replica_i_static_pattern );
        SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_PHC_Q_CAL_STATIC_PATTERN_3_0, gTxLaneConfigBlock[a_lane_no].m_iq_cal_replica_i_static_pattern );
        WRITE_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL4__ADDR, g_reg_val );
        WRITE_REG_FIELD( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL0__TX_IQ_CAL_MM_DECISION_POLARITY_INV, gTxLaneConfigBlock[a_lane_no].m_iq_cal_mm_i_pattern_polarity_inv );
      }

      vp_tx->m_tx_cal_st = e_tx_dcc_iq_cfg_st;
    }

    case e_tx_dcc_iq_cfg_st: {
      vp_tx->m_dcc_loop_cnt   = 0;
      vp_tx->m_iq_loop_cnt    = 0;
      vp_tx->m_tx_dcc0_avg    = 0;
      vp_tx->m_tx_dcc90_avg   = 0;
      vp_tx->m_tx_dcc180_avg  = 0;
      vp_tx->m_tx_dcc270_avg  = 0;
      vp_tx->m_tx_dcc_sel_txn0_txp1 = false;
      vp_tx->m_tx_dcc_sel_linear0_bin1  = true;
      vp_tx->m_tx_iq_sel_linear0_bin1   = true;
      vp_tx->m_startup_phc_q = 0;

      if (a_strup_dcc_skip) {
        vp_tx->m_tx_cal_st = e_tx_iq_cal_en_st;
        break;
      }

      vp_tx_dcc_cal_codes_restore->dcc000_cal_code = 64;
      vp_tx_dcc_cal_codes_restore->dcc090_cal_code = 64;
      vp_tx_dcc_cal_codes_restore->dcc180_cal_code = 64;
      vp_tx_dcc_cal_codes_restore->dcc270_cal_code = 64;
      vp_tx_dcc_cal_codes_restore->dcc000_cal_ref_sel_replica = 512;
      vp_tx_dcc_cal_codes_restore->dcc090_cal_ref_sel_replica = 512;
      vp_tx_dcc_cal_codes_restore->dcc180_cal_ref_sel_replica = 512;
      vp_tx_dcc_cal_codes_restore->dcc270_cal_ref_sel_replica = 512;
      tx__dcc_cal_code_initiate_restore (a_lane_no, vp_tx_dcc_cal_codes_restore);
      tx__iq_cal_restore_midcode (a_lane_no);

      vp_tx->m_tx_cal_st = e_tx_dcc_restore_done_check;
    }

    case e_tx_dcc_restore_done_check: {
      v_poll_cntr = 0;

      do {
        v_poll_done = READ_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_DCC_CAL_DONE_O );
        v_poll_cntr++;
      } while ((v_poll_done == false) && (v_poll_cntr < 10));

      if(v_poll_done) { 
        g_reg_val = READ_REG( g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR );
        SET_FIELD( g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_DCC_CAL_REQ_I, 0 );
        SET_FIELD( g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_DCC_RESTORE_I, 0 ); 
        WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR, g_reg_val );

        g_reg_val = READ_REG( g_tx_base_addr, TX__PIN_OVRDEN2__ADDR );
        SET_FIELD( g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_DCC_RESTORE_I, 0 );
        SET_FIELD( g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_DCC_CAL_REQ_I, 0 );
        WRITE_REG( g_tx_base_addr, TX__PIN_OVRDEN2__ADDR, g_reg_val );

        if(vp_tx->m_dcc_loop_cnt == v_dcc_loop_max) { 
          vp_tx->m_dcc_loop_cnt++;
          vp_tx->m_tx_cal_st = e_tx_iq_cal_en_st; 
          break;
        } else if(vp_tx->m_dcc_loop_cnt > v_dcc_loop_max) {
          vp_tx->m_tx_cal_st = e_tx_repeat_dcc_iq_st; 
          break;
        } else { 
          vp_tx->m_tx_cal_st = e_tx_dcc_cal_en_st;
        }
      } else { 
        vp_tx->m_tx_cal_st = e_tx_dcc_restore_done_check;
        break;
      }
    }

    case e_tx_dcc_cal_en_st: {

      v_poll_cntr = 0;

      do {
        v_poll_done = READ_REG_FIELD (g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_DCC_CAL_DONE_O);
        v_poll_cntr++;
      } while ((v_poll_done == true) && (v_poll_cntr < 10));

      if (v_poll_done == true) {
        break;
      }

      if (vp_tx->m_tx_cals_use_pads) { 
      
      
        WRITE_REG_FIELD( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL5__DCC_CAL_MUXA_SEL_3_0, ((vp_tx->m_tx_dcc_sel_txn0_txp1) ? 0x5 : 0x6) );
        WRITE_REG_FIELD( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL3__DCC_CAL_CM_MUXA_SEL_3_0, ((vp_tx->m_tx_dcc_sel_txn0_txp1) ? 0x5 : 0x6) );
 
        if (vp_tx->m_tx_dcc_sel_txn0_txp1 == false) { 
          g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL11__ADDR );
          SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL11__DCC000_CAL_DATA_PATTERN_15_0, 26214 );
          SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL11__DCC090_CAL_DATA_PATTERN_15_0, 52428 );
          WRITE_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL11__ADDR, g_reg_val );
          g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL12__ADDR );
          SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL12__DCC180_CAL_DATA_PATTERN_15_0, 39321 );
          SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL12__DCC270_CAL_DATA_PATTERN_15_0, 13107 );
          WRITE_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL12__ADDR, g_reg_val );
        } else { 
          g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL11__ADDR );
          SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL11__DCC000_CAL_DATA_PATTERN_15_0, 39321 );
          SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL11__DCC090_CAL_DATA_PATTERN_15_0, 13107 );
          WRITE_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL11__ADDR, g_reg_val );
          g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL12__ADDR );
          SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL12__DCC180_CAL_DATA_PATTERN_15_0, 26214 );
          SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL12__DCC270_CAL_DATA_PATTERN_15_0, 52428 );
          WRITE_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL12__ADDR, g_reg_val );
        }
      }

      WRITE_REG_FIELD( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL0__DCC_CAL_BIN_MODE , vp_tx->m_tx_dcc_sel_linear0_bin1 );

      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_DCC_CAL_MODE_I, 0); 
      SET_FIELD (g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_DCC_CAL_REQ_I, 1);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR, g_reg_val);
      
      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_DCC_CAL_MODE_I, 1);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR, g_reg_val);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_DCC_CAL_REQ_I, 1);

      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR, g_reg_val);

      vp_tx->m_tx_cal_st = e_tx_dcc_cal_poll_done_st;
    }

    case e_tx_dcc_cal_poll_done_st: {
      v_poll_cntr = 0;
      do {
        v_poll_done = READ_REG_FIELD (g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_DCC_CAL_DONE_O);
        v_poll_cntr++;
      } while ((v_poll_done == false) && (v_poll_cntr < 10));

      if (v_poll_done == false) {
        break;
      }

      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_DCC_CAL_MODE_I, 0);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_DCC_CAL_REQ_I, 0);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR, g_reg_val);

      vp_tx->m_tx_cal_st = e_tx_dcc_loop_st;
    }

    case e_tx_dcc_loop_st: {
      if (vp_tx->m_tx_cals_use_pads && gTxLaneConfigBlock[a_lane_no].m_tx_dcc_pad_txpn_avg_en == 1) { 
        if(vp_tx->m_dcc_loop_cnt == 1 || vp_tx->m_dcc_loop_cnt == 3) {  
          g_reg_val = READ_REG( g_tx_base_addr, TX__ANA_OVRDVAL8__ADDR );
          vp_tx->m_tx_dcc0_avg    += GET_FIELD( g_reg_val, TX__ANA_OVRDVAL8__ANA_TX_ANA_CLKGEN_DCC0_6_0 );
          vp_tx->m_tx_dcc90_avg   += GET_FIELD( g_reg_val, TX__ANA_OVRDVAL8__ANA_TX_ANA_CLKGEN_DCC90_6_0 );
          vp_tx->m_tx_dcc180_avg  += GET_FIELD( g_reg_val, TX__ANA_OVRDVAL8__ANA_TX_ANA_CLKGEN_DCC180_6_0 );
          vp_tx->m_tx_dcc270_avg  += GET_FIELD( g_reg_val, TX__ANA_OVRDVAL8__ANA_TX_ANA_CLKGEN_DCC270_6_0 );

        }

        if(vp_tx->m_dcc_loop_cnt == 1) { 
          tx__dcc_cal_code_initiate_restore (a_lane_no, vp_tx_dcc_cal_codes_restore);
        }
      }

      vp_tx->m_dcc_loop_cnt++;

      if(vp_tx->m_dcc_loop_cnt < v_dcc_loop_max) { 
        vp_tx->m_tx_dcc_sel_txn0_txp1     = (vp_tx->m_dcc_loop_cnt < 2) ? false : true; 
        vp_tx->m_tx_dcc_sel_linear0_bin1  = (vp_tx->m_dcc_loop_cnt % 2 == 0) ? true : false; 
        if(vp_tx->m_dcc_loop_cnt == 2) { 
          vp_tx->m_tx_cal_st = e_tx_dcc_restore_done_check;
        } else {
          vp_tx->m_tx_cal_st = e_tx_dcc_cal_en_st;
        }
        break;
      } else {
        if (vp_tx->m_tx_cals_use_pads && gTxLaneConfigBlock[a_lane_no].m_tx_dcc_pad_txpn_avg_en == 1) { 
          vp_tx->m_tx_dcc0_avg    /= 2;
          vp_tx->m_tx_dcc90_avg   /= 2;
          vp_tx->m_tx_dcc180_avg  /= 2;
          vp_tx->m_tx_dcc270_avg  /= 2;
          vp_tx_dcc_cal_codes_restore->dcc000_cal_code = vp_tx->m_tx_dcc0_avg;
          vp_tx_dcc_cal_codes_restore->dcc090_cal_code = vp_tx->m_tx_dcc90_avg;
          vp_tx_dcc_cal_codes_restore->dcc180_cal_code = vp_tx->m_tx_dcc180_avg;
          vp_tx_dcc_cal_codes_restore->dcc270_cal_code = vp_tx->m_tx_dcc270_avg;
          tx__dcc_cal_code_initiate_restore (a_lane_no, vp_tx_dcc_cal_codes_restore); 
          vp_tx->m_tx_cal_st = e_tx_dcc_restore_done_check;
          break;
        } else {
          vp_tx->m_tx_cal_st = e_tx_iq_cal_en_st;
        }
      }
    }

    case e_tx_iq_cal_en_st: {

      v_poll_cntr = 0;

      do {
        v_poll_done = READ_REG_FIELD (g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_IQ_CAL_DONE_O);
        v_poll_cntr++;
      } while ((v_poll_done == true) && (v_poll_cntr < 10));

      if (v_poll_done == true) {
        break;
      }

      if (a_strup_iq_skip) {
        vp_tx->m_tx_cal_st = (a_strup_dcc_skip == true) ? e_tx_repeat_dcc_iq_st : e_tx_dcc_replica_vcm_vref_st;
        break;
      }
      WRITE_REG_FIELD( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL0__TX_IQ_CAL_BIN_MODE, vp_tx->m_tx_iq_sel_linear0_bin1 );

      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_IQ_CAL_REQ_I, 1);
      SET_FIELD (g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_IQ_CAL_MODE_I, 0); 
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR, g_reg_val);
      
      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_IQ_CAL_MODE_I, 1);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR, g_reg_val);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_IQ_CAL_REQ_I, 1);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR, g_reg_val);

      vp_tx->m_tx_cal_st = e_tx_iq_cal_poll_done_st;
    }

    case e_tx_iq_cal_poll_done_st: {
      v_poll_cntr = 0;
      do {
        v_poll_done = READ_REG_FIELD (g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_IQ_CAL_DONE_O);
        v_poll_cntr++;
      } while ((v_poll_done == false) && (v_poll_cntr < 10));

      if (v_poll_done == false) {
        break;
      }

      g_reg_val = READ_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_IQ_CAL_MODE_I, 0);
      SET_FIELD (g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_IQ_CAL_REQ_I, 0);
      WRITE_REG (g_tx_base_addr, TX__PIN_OVRDEN2__ADDR, g_reg_val);

      vp_tx->m_tx_cal_st = e_tx_iq_loop_st;
    }

    case e_tx_iq_loop_st: {

      vp_tx->m_iq_loop_cnt++;

      if(vp_tx->m_iq_loop_cnt < 2) { 
        vp_tx->m_tx_iq_sel_linear0_bin1  = (vp_tx->m_iq_loop_cnt % 2 == 0) ? true : false; 
        vp_tx->m_tx_cal_st = e_tx_iq_cal_en_st;
        break;
      } else { 

        if (vp_tx->m_tx_cals_use_pads) { 
          if (vp_tx->m_iq_loop_cnt == 2) {
            vp_tx->m_startup_phc_q = READ_REG_FIELD( g_tx_base_addr, TX__TXS_ISTAT5__TX_PHC_Q_CAL_CODE_6_0 );
          }
       
          if (vp_tx->m_startup_phc_q > 0 && vp_tx->m_iq_loop_cnt < 4) {
            g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL3__ADDR );
            SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL3__TX_PHC_I_CAL_REPLICA_STATIC_PATTERN_3_0, gTxLaneConfigBlock[a_lane_no].m_iq_cal_replica_q_static_pattern );
            SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL3__TX_PHC_Q_CAL_REPLICA_STATIC_PATTERN_3_0, gTxLaneConfigBlock[a_lane_no].m_iq_cal_replica_q_static_pattern );
            WRITE_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL3__ADDR, g_reg_val );

            g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL4__ADDR );
            SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_PHC_I_CAL_STATIC_PATTERN_3_0, gTxLaneConfigBlock[a_lane_no].m_iq_cal_replica_q_static_pattern );
            SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_PHC_Q_CAL_STATIC_PATTERN_3_0, gTxLaneConfigBlock[a_lane_no].m_iq_cal_replica_q_static_pattern );
            WRITE_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL4__ADDR, g_reg_val );

            WRITE_REG_FIELD( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL0__TX_IQ_CAL_MM_DECISION_POLARITY_INV, gTxLaneConfigBlock[a_lane_no].m_iq_cal_mm_q_pattern_polarity_inv );

            vp_tx->m_tx_iq_sel_linear0_bin1  = (vp_tx->m_iq_loop_cnt % 2 == 0) ? true : false; 
            vp_tx->m_tx_cal_st = e_tx_iq_cal_en_st;
            break;
          }
        }

        if (a_strup_dcc_skip){
          vp_tx->m_tx_cal_st = e_tx_repeat_dcc_iq_st;
          break;
        } else {
          vp_tx->m_tx_cal_st = e_tx_dcc_replica_vcm_vref_st; 
        }
      }
      
    }

    case e_tx_dcc_replica_vcm_vref_st: {
      if (vp_tx->m_tx_cals_use_pads && gTxLaneConfigBlock[a_lane_no].m_tx_dcc_pad_txpn_avg_en == 1) { 
        bool v_dcc_replica_ref_done = tx__dcc_replica_vref_cal(a_lane_no);
        if (v_dcc_replica_ref_done) {
          tx__dcc_cal_code_initiate_restore (a_lane_no, vp_tx_dcc_cal_codes_restore); 
          vp_tx->m_tx_cal_st = e_tx_dcc_restore_done_check;
          break;
        } else { 
          vp_tx->m_tx_cal_st = e_tx_dcc_replica_vcm_vref_st;
          break;
        }
      } else { 
        vp_tx->m_tx_cal_st = e_tx_repeat_dcc_iq_st;
      }
    }

    case e_tx_repeat_dcc_iq_st: {
      vp_tx->m_tx_dcc_iq_curr_rpt_cnt++;
      if (vp_tx->m_tx_dcc_iq_curr_rpt_cnt < vp_tx->m_tx_startup_dcc_iq_rpt_cnt) {
        vp_tx->m_tx_cal_st = e_tx_dcc_iq_cfg_st;
        break;
      } else {
        vp_tx->m_tx_cal_st = e_tx_cals_done_st;
      }

    }






    case e_tx_cals_done_st: {
      if (vp_tx->m_tx_cals_use_pads) { 
        tx__patgen_cfg_restore (a_lane_no);
      }

      vp_tx->m_tx_cal_st = e_tx_dcc_iq_onetime_setup;
      vp_tx->m_tx_dcc_iq_curr_rpt_cnt = 0;
      v_done = true;
      break;
    }
  }
  return v_done;
}








