void tx__patgen_cfg_restore (uint8_t a_lane_no) {
  g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_CFG0__ADDR );
  SET_FIELD( g_reg_val, TX__TXS_CFG0__GRAYCODE_EN, tx_patgen_settings_h[a_lane_no].graycode_en ); 
  SET_FIELD( g_reg_val, TX__TXS_CFG0__PRECODE_EN, tx_patgen_settings_h[a_lane_no].precode_en );
  WRITE_REG( g_tx_base_addr, TX__TXS_CFG0__ADDR, g_reg_val );

  WRITE_REG( g_tx_base_addr, TX__TST_CFG1__ADDR, tx_patgen_settings_h[a_lane_no].custom_pattern_cfg1 );
  WRITE_REG( g_tx_base_addr, TX__TST_CFG2__ADDR, tx_patgen_settings_h[a_lane_no].custom_pattern_cfg2 );
  WRITE_REG( g_tx_base_addr, TX__TST_CFG3__ADDR, tx_patgen_settings_h[a_lane_no].custom_pattern_cfg3 );
  WRITE_REG( g_tx_base_addr, TX__TST_CFG4__ADDR, tx_patgen_settings_h[a_lane_no].custom_pattern_cfg4 );
  WRITE_REG( g_tx_base_addr, TX__TST_CFG5__ADDR, tx_patgen_settings_h[a_lane_no].custom_pattern_cfg5 );
  WRITE_REG( g_tx_base_addr, TX__TST_CFG9__ADDR, tx_patgen_settings_h[a_lane_no].custom_pattern_cfg9 );
  WRITE_REG( g_tx_base_addr, TX__TST_CFG10__ADDR, tx_patgen_settings_h[a_lane_no].custom_pattern_cfg10 );
  WRITE_REG( g_tx_base_addr, TX__TST_CFG11__ADDR, tx_patgen_settings_h[a_lane_no].custom_pattern_cfg11 );
  
  g_reg_val = READ_REG( g_tx_base_addr, TX__TST_CFG0__ADDR );
  SET_FIELD( g_reg_val, TX__TST_CFG0__PATTERN_SEL_4_0, tx_patgen_settings_h[a_lane_no].pattern_sel ) ;
  WRITE_REG( g_tx_base_addr, TX__TST_CFG0__ADDR, g_reg_val );
  
  SET_FIELD( g_reg_val,TX__TST_CFG0__PATGEN_EN, tx_patgen_settings_h[a_lane_no].patgen_en) ; 
  WRITE_REG( g_tx_base_addr, TX__TST_CFG0__ADDR, g_reg_val );
}


ATTR_INLINE void tx__iq_cal_restore_midcode (uint8_t a_lane_no) {

  bool v_iq_restore_done = false;

  g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL9__ADDR );
  SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL9__TX_PHC_I_CAL_CODE_RESTORE_6_0, 0 );
  SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL9__TX_PHC_Q_CAL_CODE_RESTORE_6_0, 0 );
  SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL9__TX_IQ_CAL_REF_SEL_REPLICA_RESTORE_9_0, 512 );
  WRITE_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL9__ADDR, g_reg_val );

  g_reg_val = READ_REG( g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR );
  SET_FIELD( g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_IQ_RESTORE_I, 1 );
  SET_FIELD( g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_IQ_CAL_REQ_I, 1 );
  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR, g_reg_val );

  WRITE_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDEN2__OVRD_EN_TX0_IQ_RESTORE_I, 1 );
  WRITE_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDEN2__OVRD_EN_TX0_IQ_CAL_REQ_I, 1 );

  do {
    v_iq_restore_done = READ_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_IQ_CAL_DONE_O );
  } while (v_iq_restore_done == false);

  WRITE_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_IQ_CAL_REQ_I, 0 );
  WRITE_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_IQ_RESTORE_I, 0 ); 

  WRITE_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDEN2__OVRD_EN_TX0_IQ_RESTORE_I, 0 );
  WRITE_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDEN2__OVRD_EN_TX0_IQ_CAL_REQ_I, 0 );
}




ATTR_INLINE bool tx__fractional_div_config (uint8_t a_lane_no) {

  tx_t *vp_tx = &g_tx[a_lane_no];

  uint8_t v_tx_rate_idx = vp_tx->m_tx_rate_idx;
  bool v_done = false, v_dll_restore_done;


  
  
  if ( ( (gTxLaneConfigBlock[a_lane_no].m_tx_force_wa4_tx_fractional_divider_fix == 1) || \
         ((g_fw_fastsim_en != 1) && \
          ((gRateConfigMasterDefaults[v_tx_rate_idx].cfg_tx_ana_clkgen_clk_div >= 4) && (gRateConfigMasterDefaults[v_tx_rate_idx].cfg_tx_ana_clkgen_clk_div <= 11))) ) && \
       (v_tx_rate_idx != 255) ) {

       if (gTxLaneConfigBlock[a_lane_no].m_tx_1p25_div_retry_seq_en == 0) {
        tx__div_config (a_lane_no, v_tx_rate_idx);
        v_done = true;
       } else {

         if (vp_tx->m_tx_1p25_div_retry_iter < gTxLaneConfigBlock[a_lane_no].m_tx_1p25_retry_count) {

           tx__div_config (a_lane_no, v_tx_rate_idx);

           delay_ns(2000);

           tx__dig_clk_en (a_lane_no, 1);

           WRITE_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_DLL_RESTORE_I, 1 );
           WRITE_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_DLL_CAL_REQ_I, 1 );

           g_reg_val = READ_REG( g_tx_base_addr, TX__PIN_OVRDEN1__ADDR );
           SET_FIELD( g_reg_val, TX__PIN_OVRDEN1__OVRD_EN_TX0_DLL_RESTORE_I, 1 );
           SET_FIELD( g_reg_val, TX__PIN_OVRDEN1__OVRD_EN_TX0_DLL_CAL_REQ_I, 1 );
           WRITE_REG( g_tx_base_addr, TX__PIN_OVRDEN1__ADDR, g_reg_val );

           delay_ns(1000);

           v_dll_restore_done = READ_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_DLL_CAL_DONE_O );

           WRITE_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_DLL_CAL_REQ_I, 0 );
           WRITE_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDVAL1__INT_TX0_DLL_RESTORE_I, 0 );

           tx__dig_clk_en (a_lane_no, 0);

           delay_ns(50);

           if (v_dll_restore_done == 1) {

             g_reg_val = READ_REG( g_tx_base_addr, TX__PIN_OVRDEN1__ADDR );
             SET_FIELD( g_reg_val, TX__PIN_OVRDEN1__OVRD_EN_TX0_DLL_RESTORE_I, 0 );
             SET_FIELD( g_reg_val, TX__PIN_OVRDEN1__OVRD_EN_TX0_DLL_CAL_REQ_I, 0 );
             WRITE_REG( g_tx_base_addr, TX__PIN_OVRDEN1__ADDR, g_reg_val );

             v_done = true;
           } else {

             vp_tx->m_tx_1p25_div_retry_iter++;
             if (vp_tx->m_tx_1p25_div_retry_iter == gTxLaneConfigBlock[a_lane_no].m_tx_1p25_retry_count) {
               gTxLaneConfigBlock[a_lane_no].m_tx_fractional_div_failure = 1;
             }
           }
         }
       }
  } else {
    v_done = true;
  }

  return v_done;
}


void tx__vreg_config (uint8_t a_lane_no) {

  g_reg_val = READ_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL9__ANA_TX_ANA_VREG_CONFIG_7_0 );

  if (gTxLaneConfigBlock[a_lane_no].m_tx_skip_wa2_tx_vreg_boost == 0) {
    g_reg_val = (g_reg_val & 0x07) | (17 << 3); 
    g_reg_val = (g_reg_val & 0xF8) | (3);  
  } 
  else {
    g_reg_val = gRateConfigMasterDefaults[0].ana_tx_ana_vreg_config;    
  }


  WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL9__ANA_TX_ANA_VREG_CONFIG_7_0, g_reg_val );
  WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDEN5__OVRD_EN_TX_ANA_VREG_CONFIG, 0x1 );



}


void tx__drv_disable (uint8_t a_lane_no, bool a_drv_disable ) {

  tx_t *vp_tx = &g_tx[a_lane_no];
  
  if (a_drv_disable == true) { 
    g_reg_val = READ_REG( g_tx_base_addr, TX__ANA_OVRDVAL0__ADDR );
    SET_FIELD( g_reg_val, TX__ANA_OVRDVAL0__ANA_TX_ANA_DRV_SER_DATA_EN, 0 );
    SET_FIELD( g_reg_val, TX__ANA_OVRDVAL0__ANA_TX_ANA_DRV_DAC_PWR_GATE_EN, 0 );

    WRITE_REG( g_tx_base_addr, TX__ANA_OVRDVAL0__ADDR, g_reg_val );

    WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDEN5__OVRD_EN_TX_ANA_DRV_SER_DATA_EN, 1 ); 
    WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDEN0__OVRD_EN_TX_ANA_DRV_DAC_PWR_GATE_EN, 1 ); 


  } else {  
    if ((vp_tx->m_tx_mode == e_pcie_mode) || (gTxLaneConfigBlock[a_lane_no].m_tx_drv_release_skip == 0)) { 
    WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDEN5__OVRD_EN_TX_ANA_DRV_SER_DATA_EN, 0 ); 
    WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDEN0__OVRD_EN_TX_ANA_DRV_DAC_PWR_GATE_EN, 0 ); 



    }
  }

}

void tx__pulse_ffe_coeff_update (uint8_t a_lane_no) {

  uint32_t v_reg_val;

  v_reg_val = READ_REG( g_tx_base_addr, TX__PIN_OVRDEN0__ADDR );
  SET_FIELD( v_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_COEFF_UPDATE_I, 1 );
  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDEN0__ADDR, v_reg_val );

  g_reg_val = READ_REG( g_tx_base_addr, TX__PIN_OVRDVAL0__ADDR );
  SET_FIELD( g_reg_val, TX__PIN_OVRDVAL0__INT_TX0_FFE_COEFF_UPDATE_I, 0 );
  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL0__ADDR, g_reg_val );

  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL0__ADDR, g_reg_val );
  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL0__ADDR, g_reg_val );
  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL0__ADDR, g_reg_val );
  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL0__ADDR, g_reg_val );

  SET_FIELD( g_reg_val, TX__PIN_OVRDVAL0__INT_TX0_FFE_COEFF_UPDATE_I, 1 );
  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL0__ADDR, g_reg_val );

  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL0__ADDR, g_reg_val );
  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL0__ADDR, g_reg_val );
  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL0__ADDR, g_reg_val );
  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL0__ADDR, g_reg_val );

  SET_FIELD( g_reg_val, TX__PIN_OVRDVAL0__INT_TX0_FFE_COEFF_UPDATE_I, 0 );
  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL0__ADDR, g_reg_val );

  SET_FIELD( v_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_COEFF_UPDATE_I, 0 );
  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDEN0__ADDR, v_reg_val );
}

void tx__ffe_coeff_squelch (uint8_t a_lane_no, bool a_unsquelch0_squelch1) {

  tx_t *vp_tx = &g_tx[a_lane_no];
  if (a_unsquelch0_squelch1) {
    if(!gTxLaneConfigBlock[a_lane_no].m_tx_coeff_squelch_skip && (vp_tx->m_tx_mode == e_eth_mode)) { 

      g_reg_val = READ_REG( g_tx_base_addr, TX__PIN_OVRDVAL7__ADDR );
      SET_FIELD( g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_CURSOR_COEFF_I_5_0, 0 );      
      SET_FIELD( g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_POSTCURSOR_COEFF_I_4_0, 0 );   
      SET_FIELD( g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_PRECURSOR1_COEFF_I_4_0, 0 );   
      SET_FIELD( g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_PRECURSOR2_COEFF_I_3_0, 0 );   
      SET_FIELD( g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_PRECURSOR3_COEFF_I_2_0, 0 );   
      WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL7__ADDR, g_reg_val );

      g_reg_val = READ_REG( g_tx_base_addr, TX__PIN_OVRDEN0__ADDR );
      SET_FIELD( g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_CURSOR_COEFF_I, 1 );
      SET_FIELD( g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_POSTCURSOR_COEFF_I, 1 );
      SET_FIELD( g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_PRECURSOR1_COEFF_I, 1 );
      SET_FIELD( g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_PRECURSOR2_COEFF_I, 1 );
      SET_FIELD( g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_PRECURSOR3_COEFF_I, 1 );
      WRITE_REG( g_tx_base_addr, TX__PIN_OVRDEN0__ADDR, g_reg_val );

      tx__pulse_ffe_coeff_update (a_lane_no);
    }
  } else { 
    g_reg_val = READ_REG( g_tx_base_addr, TX__PIN_OVRDEN0__ADDR );
    SET_FIELD( g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_CURSOR_COEFF_I, 0 );
    SET_FIELD( g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_POSTCURSOR_COEFF_I, 0 );
    SET_FIELD( g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_PRECURSOR1_COEFF_I, 0 );
    SET_FIELD( g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_PRECURSOR2_COEFF_I, 0 );
    SET_FIELD( g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_PRECURSOR3_COEFF_I, 0 );
    WRITE_REG( g_tx_base_addr, TX__PIN_OVRDEN0__ADDR, g_reg_val );

    tx__pulse_ffe_coeff_update (a_lane_no);
  }
}

