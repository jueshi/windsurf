ATTR_INLINE void pmd_tx__restore_tx_cfg (uint8_t a_lane_no) {
  pmd_tx_cfg_settings *vp_pmd_tx_cfg_settings_h = &pmd_tx_cfg_settings_h[a_lane_no];
  g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDVAL0__ADDR );
  SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_RATE_I_5_0, vp_pmd_tx_cfg_settings_h->m_txX_rate ); 
