      WRITE_REG_FIELD (g_cm_base_addr, CM__PIN_OVRDVAL3__INT_PLL0_SHORT_LOCK_EN_I, vp_cntx_config_master_defaults->pll0_short_lock_en_i);
    }

    WRITE_REG_FIELD (g_cm_base_addr, CM__PIN_OVRDVAL0__INT_CM_REF_RANGE_I_3_0, vp_cntx_config_master_defaults->cm_ref_range_i);

    g_reg_val = READ_REG (g_cm_base_addr, CM__PIN_OVRDEN0__ADDR);
    SET_FIELD (g_reg_val, CM__PIN_OVRDEN0__OVRD_EN_PLL0_SHORT_LOCK_EN_I, 1);
    SET_FIELD (g_reg_val, CM__PIN_OVRDEN0__OVRD_EN_CM_REF_RANGE_I, 1);
    WRITE_REG (g_cm_base_addr, CM__PIN_OVRDEN0__ADDR, g_reg_val);
  }


  v_fbdiv_div5_en |= READ_REG_FIELD (g_cm_base_addr, CM__PLL0_CFG24__PLL0_DIV_VCOCLK_DIV5_SEL);
  v_fbdiv_div5_en |= READ_REG_FIELD (g_cm_base_addr, CM__PLL0_CFG2__PLL0_CLKOUT_VCOCLK_DIV5_SEL);   
  v_fbdiv_div5_en |= READ_REG_FIELD (g_cm_base_addr, CM__PLL0_CFG5__PLL0_WORDCLK_DIV5_SEL);

  WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDVAL0__CM_ANA_PLL_FBDIV_DIV5_EN, v_fbdiv_div5_en);
  WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_PLL_FBDIV_DIV5_EN, 1);


  
  if ((a_pllX_cntx == 8) || (a_pllX_cntx == 9)){ 
    WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDVAL4__CM_ANA_PLL_TEST_CLKPATH_ITAIL_INC, gCmConfigBlock[a_cm_no].m_cm_ana_pll_test_clkpath_itail_inc_10g_cntx);
    WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDVAL2__CM_ANA_PLL_INC_CURR_DIV2_BUF, gCmConfigBlock[a_cm_no].m_cm_ana_pll_inc_curr_div2_buf_10g_cntx);
 
  }else{
    WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDVAL4__CM_ANA_PLL_TEST_CLKPATH_ITAIL_INC, gCmConfigBlock[a_cm_no].m_cm_ana_pll_test_clkpath_itail_inc_non_10g_cntx);
    WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDVAL2__CM_ANA_PLL_INC_CURR_DIV2_BUF, gCmConfigBlock[a_cm_no].m_cm_ana_pll_inc_curr_div2_buf_non_10g_cntx);
  }

  WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDEN2__OVRD_EN_CM_ANA_PLL_TEST_CLKPATH_ITAIL_INC, 1);
  WRITE_REG_FIELD (g_cm_base_addr, CM__ANA_OVRDEN1__OVRD_EN_CM_ANA_PLL_INC_CURR_DIV2_BUF, 1);
  



}




ATTR_INLINE void cm__pll_cal_code_restore (uint8_t a_cm_no) {

}



ATTR_INLINE void cm__pll_pgm_vctl (uint8_t a_cm_no) {
  uint8_t v_idx;

  if (gCmConfigBlock[a_cm_no].m_tsense_error == 0) {
    v_idx = ( ((int8_t) gCmConfigBlock[a_cm_no].m_s2c_meas_temp) - MIN_TEMP ) / TEMP_STEP; 

    g_reg_val = READ_REG (g_cm_base_addr, CM__ANA_OVRDVAL6__ADDR);
    SET_FIELD (g_reg_val, CM__ANA_OVRDVAL6__CM_ANA_PLL_VCO_GAIN_CAL_1_0,      g_vctl_tsense_lut[v_idx].vco_gain_cal_bg);
    SET_FIELD (g_reg_val, CM__ANA_OVRDVAL6__CM_ANA_PLL_VCO_GAIN_CAL_LVL_5_0,  g_vctl_tsense_lut[v_idx].vco_gain_cal_lvl_bg);
    WRITE_REG (g_cm_base_addr, CM__ANA_OVRDVAL6__ADDR, g_reg_val);

    g_reg_val = READ_REG (g_cm_base_addr, CM__ANA_OVRDEN3__ADDR);
    SET_FIELD (g_reg_val, CM__ANA_OVRDEN3__OVRD_EN_CM_ANA_PLL_VCO_GAIN_CAL, 0x1);
    SET_FIELD (g_reg_val, CM__ANA_OVRDEN3__OVRD_EN_CM_ANA_PLL_VCO_GAIN_CAL_LVL, 0x1);
    WRITE_REG (g_cm_base_addr, CM__ANA_OVRDEN3__ADDR, g_reg_val);
  }   
}

