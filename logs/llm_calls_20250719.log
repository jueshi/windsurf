void rx__update_ctle_deq_coarse (uint8_t a_lane_no, uint8_t aDir) {

  rx_t *vp_rx = &g_rx[a_lane_no];

  uint32_t  vCtleDeqCoarseCodeTherm; 
  uint8_t   vCtleDeqCoarseCodeTherm_0, vCtleDeqCoarseCodeTherm_1;
  uint32_t  vCtleDacSel; 
  uint32_t  vRxAnaSpare; 

  if (aDir == 0) {  
    if (gCtleDeqCoarseCode[a_lane_no] > gRxLaneConfigBlock[a_lane_no].m_ctle_deq_coarse_min) {
      gCtleDeqCoarseCode[a_lane_no] = gCtleDeqCoarseCode[a_lane_no] - 1 ; 

      vCtleDacSel = READ_REG_FIELD( g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0 );
      vCtleDacSel = vCtleDacSel & (~(0x3 << 10)); 
      WRITE_REG_FIELD( g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0, vCtleDacSel);

      vRxAnaSpare = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 
      vRxAnaSpare = (vp_rx->m_rx_afe_ctle_cca_sel == e_rx_afe_ctle_rz_cca) ? (vRxAnaSpare & ~(0x3 << 23)) : ((vRxAnaSpare & ~(0x3 << 23)) | (0x2 << 23)); 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ;

      vRxAnaSpare = vRxAnaSpare | (0xFF<<14) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ;
      gCtleDeqFineCode[a_lane_no] = 255 ;

      vRxAnaSpare = vRxAnaSpare | (1<<22) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 
      vRxAnaSpare = vRxAnaSpare & (~(1<<22)) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 

      vCtleDacSel = (1 << gCtleDeqCoarseCode[a_lane_no]) & 0x3; 
      g_reg_val = READ_REG_FIELD( g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0 );
      g_reg_val = (g_reg_val & (~(0x3 << 10))) | (vCtleDacSel << 10);
      WRITE_REG_FIELD( g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0, g_reg_val);

      vCtleDeqCoarseCodeTherm = dec2therm(gCtleDeqCoarseCode[a_lane_no]) ;
      vCtleDeqCoarseCodeTherm_0 = vCtleDeqCoarseCodeTherm & 0x1;
      vCtleDeqCoarseCodeTherm_1 = ((vCtleDeqCoarseCodeTherm & 0x2) >> 1);

      g_reg_val = READ_REG ( g_rx_base_addr, RX__ANA_OVRDVAL12__ANA_RX_ANA_TEST_AFE_I_31_0__ADDR );
      g_reg_val = (g_reg_val & (~(1 << 29))) | (vCtleDeqCoarseCodeTherm_0 << 29);
      WRITE_REG ( g_rx_base_addr, RX__ANA_OVRDVAL12__ANA_RX_ANA_TEST_AFE_I_31_0__ADDR, g_reg_val );

      g_reg_val = READ_REG ( g_rx_base_addr, RX__ANA_OVRDVAL13__ANA_RX_ANA_TEST_AFE_I_43_32__ADDR );
      g_reg_val = (g_reg_val & (~(1 << 5))) | (vCtleDeqCoarseCodeTherm_1 << 5);
      WRITE_REG ( g_rx_base_addr, RX__ANA_OVRDVAL13__ANA_RX_ANA_TEST_AFE_I_43_32__ADDR, g_reg_val );
    }
  } else if (aDir == 1) {   
    if (gCtleDeqCoarseCode[a_lane_no] < gRxLaneConfigBlock[a_lane_no].m_ctle_deq_coarse_max) {
      gCtleDeqCoarseCode[a_lane_no] = gCtleDeqCoarseCode[a_lane_no] + 1 ;

      vCtleDeqCoarseCodeTherm = dec2therm(gCtleDeqCoarseCode[a_lane_no]) ;
      vCtleDeqCoarseCodeTherm_0 = vCtleDeqCoarseCodeTherm & 0x1;
      vCtleDeqCoarseCodeTherm_1 = ((vCtleDeqCoarseCodeTherm & 0x2) >> 1);

      g_reg_val = READ_REG ( g_rx_base_addr, RX__ANA_OVRDVAL12__ANA_RX_ANA_TEST_AFE_I_31_0__ADDR );
      g_reg_val = (g_reg_val & (~(1 << 29))) | (vCtleDeqCoarseCodeTherm_0 << 29);
      WRITE_REG ( g_rx_base_addr, RX__ANA_OVRDVAL12__ANA_RX_ANA_TEST_AFE_I_31_0__ADDR, g_reg_val );

      g_reg_val = READ_REG ( g_rx_base_addr, RX__ANA_OVRDVAL13__ANA_RX_ANA_TEST_AFE_I_43_32__ADDR );
      g_reg_val = (g_reg_val & (~(1 << 5))) | (vCtleDeqCoarseCodeTherm_1 << 5);
      WRITE_REG ( g_rx_base_addr, RX__ANA_OVRDVAL13__ANA_RX_ANA_TEST_AFE_I_43_32__ADDR, g_reg_val );

      vCtleDacSel = READ_REG_FIELD( g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0 );
      vCtleDacSel = vCtleDacSel & (~(0x3 << 10)); 
      WRITE_REG_FIELD( g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0, vCtleDacSel);

      vRxAnaSpare = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 
      vRxAnaSpare = (vp_rx->m_rx_afe_ctle_cca_sel == e_rx_afe_ctle_rz_cca) ? (vRxAnaSpare & ~(0x3 << 23)) : ((vRxAnaSpare & ~(0x3 << 23)) | (0x2 << 23)); 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ;

      vRxAnaSpare = vRxAnaSpare & (~(0xFF<<14)) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ;
      gCtleDeqFineCode[a_lane_no] = 0 ;

      vRxAnaSpare = vRxAnaSpare | (1<<22) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 
      vRxAnaSpare = vRxAnaSpare & (~(1<<22)) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ;

      vCtleDacSel = (1 << gCtleDeqCoarseCode[a_lane_no]) & 0x3; 
      g_reg_val = READ_REG_FIELD( g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0 );
      g_reg_val = (g_reg_val & (~(0x3 << 10))) | (vCtleDacSel << 10);
      WRITE_REG_FIELD( g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0, g_reg_val);
    }
  }
}





