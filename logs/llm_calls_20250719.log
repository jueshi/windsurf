  }

  cm__pll_cal_code_restore (a_cm_no);
  
  
  g_reg_val = READ_REG (g_pmd_cm_base_addr, PMD_CM__FW_CSR0__ADDR);
  SET_FIELD (g_reg_val, PMD_CM__FW_CSR0__USE_PLLX_FW_SKIP_CAL, 1);
  SET_FIELD (g_reg_val, PMD_CM__FW_CSR0__PLLX_FW_SKIP_CAL, vp_cm->m_pll_cal_code_save_done[v_pllX_cntx_sr_idx]);  
  WRITE_REG (g_pmd_cm_base_addr, PMD_CM__FW_CSR0__ADDR, g_reg_val);

}



ATTR_INLINE bool pmd_cm__pll_fw_cmd1_b4_pllcal_host_brk_pnt (uint8_t a_cm_no) {
  bool     v_done = false;
  uint32_t v_reg_addr_offset, v_req_val, v_ack_val;
 
  pmd_cm_t *vp_pmd_cm = &g_pmd_cm[a_cm_no];

  v_reg_addr_offset = PMD_CM__FW_CSR1__ADDR;
  v_req_val = 0x1;      
  v_ack_val = 0x2;      

  g_reg_val = READ_REG (g_pmd_cm_base_addr, v_reg_addr_offset);

  switch (vp_pmd_cm->m_pllX_host_brk_pnt_st) {
    case e_req1_st: {
      WRITE_REG( g_pmd_cm_base_addr, v_reg_addr_offset, (g_reg_val | v_req_val) );    
      vp_pmd_cm->m_pllX_host_brk_pnt_st = e_ack1_poll_req0_st;                        
      break;
    }

    case e_ack1_poll_req0_st: {
      if ((g_reg_val & v_ack_val) == v_ack_val) {                                         
        WRITE_REG( g_pmd_cm_base_addr, v_reg_addr_offset, (g_reg_val & (~(v_req_val))) ); 
        vp_pmd_cm->m_pllX_host_brk_pnt_st = e_ack0_poll_st;                               
      }
      break;
    }

    case e_ack0_poll_st: {
      if ((g_reg_val & v_ack_val) != v_ack_val) {         
        vp_pmd_cm->m_pllX_host_brk_pnt_st = e_req1_st;    
        v_done = true;
      }
      break;
    }
  }

  return v_done;
} 








