void pmd_rx__set_link_maps (uint8_t a_lane_no, bool a_enable1_disable0) {

  rx_t *vp_rx = &g_rx[a_lane_no];

  for (uint8_t v_cm_no = 0; v_cm_no < g_num_cm; v_cm_no++) {
    g_reg_val = READ_REG_FIELD( g_pmd_cm_base_addr_lut[v_cm_no], PMD_CM__CM_CFG6__RX_PLL_LINK_MAP_7_0 );
    if (a_enable1_disable0 && (v_cm_no == vp_rx->m_rx_pll_sel)) { 
      g_reg_val = g_reg_val | (1 << a_lane_no);
    } else { 
      g_reg_val = g_reg_val & (~(1 << a_lane_no));
    }
    WRITE_REG_FIELD( g_pmd_cm_base_addr_lut[v_cm_no], PMD_CM__CM_CFG6__RX_PLL_LINK_MAP_7_0, g_reg_val );
  }

  uint8_t v_cm_sel; 
  v_cm_sel = ((g_num_cm == 2) && (a_lane_no >= 2)) ? 1 : 0;

  g_reg_val = READ_REG_FIELD( g_pmd_cm_base_addr_lut[v_cm_sel], PMD_CM__CM_CFG0__RX_LANE_LINK_MAP_7_0 );
  if (a_enable1_disable0) {
    g_reg_val = g_reg_val | (1 << a_lane_no);
  } else {
    g_reg_val = g_reg_val & (~(1 << a_lane_no));
  }
  WRITE_REG_FIELD( g_pmd_cm_base_addr_lut[v_cm_sel], PMD_CM__CM_CFG0__RX_LANE_LINK_MAP_7_0, g_reg_val );

}

void func_rx_fwcmd_rate_cfgs (uint8_t fsm_no) {
  uint8_t vLaneNo = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;

  rx_t *vp_rx = &g_rx[vLaneNo];
  pmd_rx_t *vp_pmd_rx = &g_pmd_rx[vLaneNo];

  uint8_t  v_rx_width;
  uint32_t vEthStnAdaptSkip, vEthAdaptStnFwCmdEn;

  union tPmdLaneRxRxFwCsr9RxFwSpare0_t vPmdLaneRxRxFwCsr9RxFwSpare0;

  gIsFirstCtleContAdaptn[vLaneNo] = 1;
  gIsFirstVgaContAdaptn[vLaneNo] = 1;

  vp_pmd_rx->pmd_krt_fsm_st = 0;

  
  g_reg_val = READ_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__ADDR);
  vp_rx->m_rx_rate    = GET_FIELD (g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_RATE_I_5_0);  
  v_rx_width          = GET_FIELD (g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_WIDTH_I_3_0); 
  vp_rx->m_rx_pll_sel = GET_FIELD (g_reg_val, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_PLL_SEL_I);   

  vPmdLaneRxRxFwCsr9RxFwSpare0.reg = READ_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR9__RX_FW_SPARE0_30_0);

  gRxXFwDoFtffe[vLaneNo] = READ_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR13__RXX_FW_DO_FTFFE);
 
  gRxXFwDoFtffe[vLaneNo] = (gRxLaneConfigBlock[vLaneNo].m_low_power_mode == 1 && gRxLaneConfigBlock[vLaneNo].m_ffe_float_tap_en == 0 ) ? 0 :  gRxXFwDoFtffe[vLaneNo];
 
  if ((vp_rx->m_rx_mode == e_pcie_mode) && (g_fw_skip_pcie_repeat_strup == 0) && (gRxFwRptStrupCount[vLaneNo] == 1)) {  

    vp_rx->m_rx_rate    = READ_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL2__RXX_RATE_I_5_0);  

  } else if (vp_rx->m_rx_mode == e_eth_mode) {
    
    if (vp_rx->m_rx_rate == 62) {         
      WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_LANE_CFG0__RX_SIGNAL_TYPE, 0);

    } else if (vp_rx->m_rx_rate == 63) {  
      WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_LANE_CFG0__RX_SIGNAL_TYPE, 1);
    }

    
    if (vPmdLaneRxRxFwCsr9RxFwSpare0.fields.mRxXNewRate == 1) {
      vp_rx->m_rx_rate = vPmdLaneRxRxFwCsr9RxFwSpare0.fields.mRxXNewRateEncoding;
    }
  }

  vp_rx->m_rx_rate_idx       = rate_index_map[vp_rx->m_rx_rate];
  vp_rx->m_rx_rate_width_idx = rate_width_index_map[vp_rx->m_rx_rate_idx][v_rx_width];   

  if (vp_rx->m_rx_mode == e_pcie_mode) {
    vp_rx->m_rx_cdr_ssc_mode = READ_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__PMD_RX_OVRDVAL3__RXX_CDR_SSC_MODE_I_1_0);
    vp_rx->m_rx_rate_clk_idx = (vp_rx->m_rx_cdr_ssc_mode * NUM_PCIE_RATE) + vp_rx->m_rx_rate_idx;   

  } else {
    vp_rx->m_rx_cdr_ssc_mode = 0;
    vp_rx->m_rx_rate_clk_idx = (NUM_PCIE_RATE * 3) + (vp_rx->m_rx_rate_idx - NUM_PCIE_RATE) ;       
  }
  


  
  pmd_rx__set_link_maps (vLaneNo, true); 
  

  


  
  


  


  
  union tPmdLaneTxTxFwCsr5TxFwSpare1_t v_pmd_lane_tx_tx_fw_csr5_tx_fw_spare1;

  v_pmd_lane_tx_tx_fw_csr5_tx_fw_spare1.reg = READ_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_FW_CSR5__TX_FW_SPARE1_31_0 );
  
  vp_rx->m_rx_ne_serial_lpbk_en = v_pmd_lane_tx_tx_fw_csr5_tx_fw_spare1.fields.m_txX_ne_serial_lpbk_en;

  if (vp_rx->m_rx_ne_serial_lpbk_en == true) { 
    g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_PWRUP_CFG66__ADDR );
    SET_FIELD( g_reg_val, PMD_LANE_RX__RX_PWRUP_CFG66__RX_SKIP_ATT_CAL, 0x1 );
    SET_FIELD( g_reg_val, PMD_LANE_RX__RX_PWRUP_CFG66__RX_SKIP_HFEQ_CAL, 0x1 );
    WRITE_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_PWRUP_CFG66__ADDR, g_reg_val );
  }



  

  
  if (vp_rx->m_rx_rate_idx != 255) { 
    WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_LANE_CFG0__RX_SIGNAL_TYPE, gRateConfigMasterDefaults[vp_rx->m_rx_rate_idx].rx0_signal_type_i);

    g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR11__ADDR );
    SET_FIELD( g_reg_val, PMD_LANE_RX__RX_FW_CSR11__RX_ALLOW_FIFO_EN, ((~gRateConfigMasterDefaults[vp_rx->m_rx_rate_idx].rx_fifo_bypass)&0x1));
    SET_FIELD( g_reg_val, PMD_LANE_RX__RX_FW_CSR11__RX_ALLOW_DSER_CLK_EN, ((~gRateConfigMasterDefaults[vp_rx->m_rx_rate_idx].rx_fifo_bypass)&0x1));
    WRITE_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR11__ADDR, g_reg_val );

    rx__rate_config (vLaneNo);
  }

  rx__ne_serial_lpbk_config (vLaneNo); 

  WRITE_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__INTR_CLR1__CLR_INTERRUPT_31_0__ADDR, 0x00004000);
  WRITE_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__INTR_CLR1__CLR_INTERRUPT_31_0__ADDR, 0x00000000);


  

  if (vp_rx->m_rx_mode == e_eth_mode) {  
    g_reg_val = READ_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR13__ADDR);
    gFwEthDoAn[vLaneNo] = GET_FIELD (g_reg_val, PMD_LANE_RX__RX_FW_CSR13__FW_ETH_DO_AN);
    gFwEthDoKr[vLaneNo] = GET_FIELD (g_reg_val, PMD_LANE_RX__RX_FW_CSR13__FW_ETH_DO_KR);


    gFwLaneXSignalOk[vLaneNo] = 0;  

    trigger_rx_ack_check[vLaneNo] = 1; 

    if (gFwEthDoAn[vLaneNo] == 1) { 
      g_reg_val = READ_REG(g_pmd_lane_rx_base_addr_lut[vLaneNo], PMD_LANE_RX__AN_CFG0__ADDR);
      SET_FIELD (g_reg_val, PMD_LANE_RX__AN_CFG0__AN_ENABLE, 0x1);  
      SET_FIELD (g_reg_val, PMD_LANE_RX__AN_CFG0__AN_STATUS, 0x0);  
      WRITE_REG (g_pmd_lane_rx_base_addr_lut[vLaneNo], PMD_LANE_RX__AN_CFG0__ADDR, g_reg_val);

      g_reg_val = READ_REG (g_pmd_lane_rx_base_addr_lut[vLaneNo], PMD_LANE_RX__RX_FW_CSR3__ADDR);
      SET_FIELD (g_reg_val, PMD_LANE_RX__RX_FW_CSR3__AN_TX_GBOX_EN_FW, 1);
      SET_FIELD (g_reg_val, PMD_LANE_RX__RX_FW_CSR3__AN_RX_GBOX_EN_FW, 1);
      WRITE_REG (g_pmd_lane_rx_base_addr_lut[vLaneNo], PMD_LANE_RX__RX_FW_CSR3__ADDR, g_reg_val);
    }

    
    vEthStnAdaptSkip    = 0xFFFFFF5C ;
    vEthAdaptStnFwCmdEn = 0x80000000 | (gRxXFwDoFtffe[vLaneNo] << 6) | (gRxLaneConfigBlock[vLaneNo].m_do_ctle_gn_adj << 4) | (gRxLaneConfigBlock[vLaneNo].m_do_inl_corr << 2) | (gRxLaneConfigBlock[vLaneNo].m_do_ctle_lut_reload << 9) ;

      vEthAdaptStnFwCmdEn  |= (gRxLaneConfigBlock[vLaneNo].m_do_short_channel_ctle_boost << 8);

    if (g_fw_fastsim_en == 1 && g_fw_ufastsim_0_fastsim_1 == 0) {
      vEthStnAdaptSkip    |= (0x1 << 7) | (!gFwEthDoKr[vLaneNo] << 5) ;  

      if (gFwEthDoAn[vLaneNo]) {
        WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__AN_CFG0__CL73_TMR_OVRRIDE, 1);
        WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__CL73_AN_TMR0__BREAK_LINK_TIMER_X2048_15_0, 1);
      }

    } else {
      vEthStnAdaptSkip    |= ((gFwEthDoKr[vLaneNo] & (!gRxXFwDoFtffe[vLaneNo])) << 7) | (0x1 << 5); 
      vEthAdaptStnFwCmdEn |= (gFwEthDoKr[vLaneNo] << 5) ;
    }

    if (vp_rx->m_rx_ne_serial_lpbk_en == true) {
      vEthStnAdaptSkip = 0xFFFCFFFF; 
      vEthAdaptStnFwCmdEn = 0x0; 
      vp_rx->m_rx_internal_cca_en = false;

    }

    WRITE_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__ETH_ADAPT_CTRL43__STN_ADAPT_SKIP_31_0__ADDR,  vEthStnAdaptSkip);
    WRITE_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__ETH_ADAPT_CTRL23__STN_FW_CMD_EN_31_0__ADDR,   vEthAdaptStnFwCmdEn);




  }


  
  handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
}


