#include "fw.h"


uint8_t func_read_fw_version_cmd_decode () {
  if (general_debug_fsm_busy == 1) {
    return 1 ;  
  } else {
    general_debug_mb_cmd  = 1 ;
    new_general_debug_cmd = 1 ;
    return 0 ;  
  }
}


uint8_t func_get_trim_code_cmd_decode () {
  uint8_t v_lane_no;
  uint8_t v_average_cnt;
  uint8_t v_trim_temp_idx;

   g_reg_val       = READ_REG( PMD_BASE_ADDR, PMD__FW_MAILBOX0__ADDR );               
  v_lane_no       = GET_FIELD( g_reg_val, PMD__FW_MAILBOX0__CMD_DATA0_7_0 ) & 0x7;   
  v_average_cnt   = GET_FIELD( g_reg_val, PMD__FW_MAILBOX0__CMD_DATA1_7_0 );

  v_trim_temp_idx = READ_REG_FIELD( PMD_BASE_ADDR, PMD__FW_MAILBOX1__CMD_DATA2_7_0 );

  if (v_lane_no > (g_num_lane-1) || (!(v_trim_temp_idx >= 0 && v_trim_temp_idx <= 33)))
  {
    return 2; 

  } else if (general_debug_fsm_busy == 1) {
    return 1; 

  } else {

    general_debug_mb_cmd  = 2;
    new_general_debug_cmd = 1;

    if (general_debug_fsm_h.m_tsense_in_prog == false) {
      general_debug_fsm_h.m_tsense_in_prog = true;

      general_debug_fsm_h.m_cm_no      = 0;          

      general_debug_fsm_h.m_lane_count = 1;
      general_debug_fsm_h.m_lane_no[0] = v_lane_no;
      general_debug_fsm_h.m_lane_no[1] = v_lane_no;

      general_debug_fsm_h.m_average_cnt  = v_average_cnt;

      general_debug_fsm_h.m_trim_temp_idx   = v_trim_temp_idx;
    }

    return 0;
  }
}

uint8_t func_get_temp_cmd_decode () {
  uint8_t  v_cm_no;
  uint8_t  v_lane_no;
  uint8_t  v_average_cnt;

  g_reg_val = READ_REG( PMD_BASE_ADDR, PMD__FW_MAILBOX0__ADDR );                    
  v_lane_no = GET_FIELD( g_reg_val, PMD__FW_MAILBOX0__CMD_DATA0_7_0 ) & 0x7;          
  v_cm_no   = (GET_FIELD( g_reg_val, PMD__FW_MAILBOX0__CMD_DATA0_7_0 ) & 0x8) >> 3;      

  v_average_cnt             =  GET_FIELD( g_reg_val, PMD__FW_MAILBOX0__CMD_DATA1_7_0 );

  if (v_lane_no > (g_num_lane - 1))
  {
    return 2; 

  } else if (general_debug_fsm_busy == 1) {
    return 1; 

  } else {
    general_debug_mb_cmd  = 3;
    new_general_debug_cmd = 1;

    if (general_debug_fsm_h.m_tsense_in_prog == false) {
      general_debug_fsm_h.m_tsense_in_prog = true;

      general_debug_fsm_h.m_cm_no      = v_cm_no;

      general_debug_fsm_h.m_lane_count = 1;
      general_debug_fsm_h.m_lane_no[0] = v_lane_no;
      general_debug_fsm_h.m_lane_no[1] = v_lane_no;

      general_debug_fsm_h.m_average_cnt = v_average_cnt;
      general_debug_fsm_h.m_trim_code = gPmdConfigBlock.m_tsense_trim_code;

    }
    return 0;
  }
}






