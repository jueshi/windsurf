void func_tx_fwcmd_clk_align_req (uint8_t fsm_no) {

  uint8_t vLaneNo = fsm_no - MAX_NUM_CM;
  bool vSkipClkAlign;

  vSkipClkAlign = READ_REG_FIELD (g_pmd_lane_tx_base_addr,PMD_LANE_TX__TX_PWRDN_CFG16__TX_SKIP_CLK_ALIGN);

