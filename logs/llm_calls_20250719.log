  vp_pmd_tx_cfg_settings_h->m_tx_word_clk_cm_sel = READ_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__FREQ_CODE_FWD6__TX_WORD_CLK_CM_SEL_2_0 );

