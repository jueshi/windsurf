  rx_t *vp_rx = &g_rx[a_lane_no];

  uint8_t v_pattern_sel;

  WRITE_REG_FIELD(g_tx_base_addr, TX__TST_CFG0__PATGEN_EN, 0);
  WRITE_REG_FIELD(g_tx_base_addr, TX__TST_CFG0__PATGEN_EN, 0); 

  v_pattern_sel = (vp_rx->m_pmix_inl_pat_sel == 0) ? 0 : 22; 

  WRITE_REG_FIELD(g_tx_base_addr, TX__TST_CFG0__PATTERN_SEL_4_0, v_pattern_sel);

  if (v_pattern_sel == 22) {
    uint32_t v_clk4_pattern = 0x33333333;
    WRITE_REG_FIELD(g_tx_base_addr, TX__TST_CFG1__CUSTOM_PATTERN_31_0, (vp_rx->m_pmix_inl_pat_sel == 1 ? v_clk4_pattern : 0x73333333));
    WRITE_REG_FIELD(g_tx_base_addr, TX__TST_CFG2__CUSTOM_PATTERN_63_32, (vp_rx->m_pmix_inl_pat_sel == 1 ? v_clk4_pattern : 0xCCCC6666));
    WRITE_REG_FIELD(g_tx_base_addr, TX__TST_CFG3__CUSTOM_PATTERN_95_64, (vp_rx->m_pmix_inl_pat_sel == 1 ? v_clk4_pattern : 0x8CCCCCCC));
    WRITE_REG_FIELD(g_tx_base_addr, TX__TST_CFG4__CUSTOM_PATTERN_127_96, (vp_rx->m_pmix_inl_pat_sel == 1 ? v_clk4_pattern : 0x33339999));
    WRITE_REG_FIELD(g_tx_base_addr, TX__TST_CFG5__CUSTOM_PATTERN_159_128, (vp_rx->m_pmix_inl_pat_sel == 1 ? v_clk4_pattern : 0x73333333));
    WRITE_REG_FIELD(g_tx_base_addr, TX__TST_CFG9__CUSTOM_PATTERN_191_160, (vp_rx->m_pmix_inl_pat_sel == 1 ? v_clk4_pattern : 0xCCCC6666));
    WRITE_REG_FIELD(g_tx_base_addr, TX__TST_CFG10__CUSTOM_PATTERN_223_192, (vp_rx->m_pmix_inl_pat_sel == 1 ? v_clk4_pattern : 0x8CCCCCCC));
    WRITE_REG_FIELD(g_tx_base_addr, TX__TST_CFG11__CUSTOM_PATTERN_255_224, (vp_rx->m_pmix_inl_pat_sel == 1 ? v_clk4_pattern : 0x33339999));
  }

  WRITE_REG_FIELD(g_tx_base_addr, TX__TST_CFG0__PATGEN_EN, 1);
  WRITE_REG_FIELD(g_tx_base_addr, TX__TST_CFG0__PATGEN_EN, 1); 
}

void pmix_inl_cal_set_internal_lpbk (uint8_t a_lane_no, bool a_en1_dis0) {

  WRITE_REG_FIELD(g_rx_base_addr, RX__ANA_OVRDVAL10__ANA_RX_ANA_SEL_LPBK_I, a_en1_dis0);
  WRITE_REG_FIELD(g_rx_base_addr, RX__ANA_OVRDEN2__OVRD_EN_ANA_RX_ANA_SEL_LPBK_I, a_en1_dis0);

  WRITE_REG_FIELD(g_rx_base_addr, RX__PIN_OVRDVAL0__INT_RX0_AFE_DC_LPBK_I, a_en1_dis0);
  WRITE_REG_FIELD(g_rx_base_addr, RX__PIN_OVRDEN0__OVRD_EN_RX0_AFE_DC_LPBK_I, a_en1_dis0);

  WRITE_REG_FIELD(g_tx_base_addr, TX__TXS_CFG3__EN_LB, a_en1_dis0);

  WRITE_REG_FIELD(g_tx_base_addr, TX__ANA_OVRDVAL0__ANA_TX_ANA_DRV_DAC_LB_EN, a_en1_dis0);
  WRITE_REG_FIELD(g_tx_base_addr, TX__ANA_OVRDEN0__OVRD_EN_TX_ANA_DRV_DAC_LB_EN, a_en1_dis0);
}

void pmix_inl_cal_store_tx_eq_settings(uint8_t a_lane_no) {

  pmix_inl_cal_reg_settings_t* vpPmixInlCalRegValues = &(g_pmix_inl_cal_restore_settings[a_lane_no]);

  g_reg_val = READ_REG(g_tx_base_addr_lut[a_lane_no], TX__PIN_OVRDVAL7__ADDR);
  vpPmixInlCalRegValues->m_tx_ffe_precursor_3_coeff = GET_FIELD (g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_PRECURSOR3_COEFF_I_2_0);
  vpPmixInlCalRegValues->m_tx_ffe_precursor_2_coeff = GET_FIELD (g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_PRECURSOR2_COEFF_I_3_0);
  vpPmixInlCalRegValues->m_tx_ffe_precursor_1_coeff = GET_FIELD (g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_PRECURSOR1_COEFF_I_4_0);
  vpPmixInlCalRegValues->m_tx_ffe_cursor_coeff = GET_FIELD (g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_CURSOR_COEFF_I_5_0);
  vpPmixInlCalRegValues->m_tx_ffe_postcursor_coeff = GET_FIELD (g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_POSTCURSOR_COEFF_I_4_0);
}


void pmix_inl_cal_write_tx_eq_settings(uint8_t a_lane_no, pmix_inl_cal_settings_type_t a_settings_type) {

  pmix_inl_cal_reg_settings_t* vpPmixInlCalRegValues = pmix_inl_cal_get_settings(a_lane_no, a_settings_type);

  if(a_settings_type == e_pmix_inl_cal_settings_type_cal) {
    vpPmixInlCalRegValues->m_tx_ffe_cursor_coeff = gPmdConfigBlock.m_tx_pmix_lpbk_cursor_eq;
  }

  g_reg_val = READ_REG(g_tx_base_addr_lut[a_lane_no], TX__PIN_OVRDEN0__ADDR);
  SET_FIELD (g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_PRECURSOR3_COEFF_I, 1);
  SET_FIELD (g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_PRECURSOR2_COEFF_I, 1);
  SET_FIELD (g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_PRECURSOR1_COEFF_I, 1);
  SET_FIELD (g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_CURSOR_COEFF_I, 1);
  SET_FIELD (g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_POSTCURSOR_COEFF_I, 1);
  SET_FIELD (g_reg_val, TX__PIN_OVRDEN0__OVRD_EN_TX0_FFE_COEFF_UPDATE_I, 1);
  WRITE_REG (g_tx_base_addr_lut[a_lane_no], TX__PIN_OVRDEN0__ADDR, g_reg_val);
  
  g_reg_val = READ_REG(g_tx_base_addr_lut[a_lane_no], TX__PIN_OVRDVAL7__ADDR);
  SET_FIELD (g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_PRECURSOR3_COEFF_I_2_0, vpPmixInlCalRegValues->m_tx_ffe_precursor_3_coeff);
  SET_FIELD (g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_PRECURSOR2_COEFF_I_3_0, vpPmixInlCalRegValues->m_tx_ffe_precursor_2_coeff);
  SET_FIELD (g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_PRECURSOR1_COEFF_I_4_0, vpPmixInlCalRegValues->m_tx_ffe_precursor_1_coeff);
  SET_FIELD (g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_CURSOR_COEFF_I_5_0, vpPmixInlCalRegValues->m_tx_ffe_cursor_coeff);
  SET_FIELD (g_reg_val, TX__PIN_OVRDVAL7__INT_TX0_FFE_POSTCURSOR_COEFF_I_4_0, vpPmixInlCalRegValues->m_tx_ffe_postcursor_coeff);
  WRITE_REG (g_tx_base_addr_lut[a_lane_no], TX__PIN_OVRDVAL7__ADDR, g_reg_val);

  for (uint8_t i=0; i < 10; i++){
    WRITE_REG_FIELD(g_tx_base_addr, TX__PIN_OVRDVAL0__INT_TX0_FFE_COEFF_UPDATE_I, 0);
    WRITE_REG_FIELD(g_tx_base_addr, TX__PIN_OVRDVAL0__INT_TX0_FFE_COEFF_UPDATE_I, 1);
    WRITE_REG_FIELD(g_tx_base_addr, TX__PIN_OVRDVAL0__INT_TX0_FFE_COEFF_UPDATE_I, 0);
  }

}

void pmix_inl_cal_cm_write_fcode (uint8_t cm, int16_t a_target_fcode) {

  int16_t v_curr_fcode;
  int8_t v_step_dir;

  v_curr_fcode  = READ_REG_FIELD( g_cm_base_addr_lut[cm], CM__PIN_OVRDVAL3__INT_PLL0_FCODE_I_10_0 ); 
  v_curr_fcode  = (v_curr_fcode & (1 << 10)) ? (0xF800 | v_curr_fcode) : v_curr_fcode; 
  v_step_dir    = (v_curr_fcode > a_target_fcode) ? -1 :
                  (v_curr_fcode < a_target_fcode) ?  1 : 0;

  g_reg_val = READ_REG(g_cm_base_addr_lut[cm], CM__PLL0_CFG24__ADDR);
  SET_FIELD (g_reg_val, CM__PLL0_CFG24__PLL0_PI_FBDIV_DIV4_EN, 1);
  SET_FIELD (g_reg_val, CM__PLL0_CFG24__PLL0_USE_CODE_FORWARDING, 1);
  WRITE_REG (g_cm_base_addr_lut[cm], CM__PLL0_CFG24__ADDR, g_reg_val);

  g_reg_val = READ_REG( g_cm_base_addr_lut[cm], CM__PIN_OVRDVAL3__ADDR);
  SET_FIELD( g_reg_val, CM__PIN_OVRDVAL3__INT_PLL0_FCODE_I_10_0, v_curr_fcode);
  SET_FIELD( g_reg_val, CM__PIN_OVRDVAL3__INT_PLL0_FCODE_UPDATE_I, 0);
  WRITE_REG( g_cm_base_addr_lut[cm], CM__PIN_OVRDVAL3__ADDR, g_reg_val);

  g_reg_val = READ_REG( g_cm_base_addr_lut[cm], CM__PIN_OVRDEN1__ADDR);
  SET_FIELD( g_reg_val, CM__PIN_OVRDEN1__OVRD_EN_PLL0_FCODE_I, 1);
  SET_FIELD( g_reg_val, CM__PIN_OVRDEN1__OVRD_EN_PLL0_FCODE_UPDATE_I, 1);
  WRITE_REG( g_cm_base_addr_lut[cm], CM__PIN_OVRDEN1__ADDR, g_reg_val);

  while (v_curr_fcode != a_target_fcode) {
    v_curr_fcode = v_curr_fcode + v_step_dir;
    WRITE_REG_FIELD(g_cm_base_addr_lut[cm], CM__PIN_OVRDVAL3__INT_PLL0_FCODE_I_10_0, v_curr_fcode);

    for (int i = 0; i < 10; i++) {
      g_reg_val = READ_REG( g_cm_base_addr_lut[cm], CM__PIN_OVRDVAL3__ADDR);
      SET_FIELD( g_reg_val, CM__PIN_OVRDVAL3__INT_PLL0_FCODE_UPDATE_I, 0);
      WRITE_REG( g_cm_base_addr_lut[cm], CM__PIN_OVRDVAL3__ADDR, g_reg_val);
      SET_FIELD( g_reg_val, CM__PIN_OVRDVAL3__INT_PLL0_FCODE_UPDATE_I, 1);
      WRITE_REG( g_cm_base_addr_lut[cm], CM__PIN_OVRDVAL3__ADDR, g_reg_val);
      SET_FIELD( g_reg_val, CM__PIN_OVRDVAL3__INT_PLL0_FCODE_UPDATE_I, 0);
      WRITE_REG( g_cm_base_addr_lut[cm], CM__PIN_OVRDVAL3__ADDR, g_reg_val);
    }
  }


  WRITE_REG_FIELD(g_cm_base_addr_lut[cm], CM__PIN_OVRDEN1__OVRD_EN_PLL0_FCODE_UPDATE_I, 0);
}

void pmix_inl_cal_turn_off_fcode_forwarding(uint8_t a_cm_no) {

  pmix_inl_cal_cm_write_fcode(a_cm_no, 0);

  g_reg_val = READ_REG (g_cm_base_addr_lut[a_cm_no], CM__PLL0_CFG24__ADDR) ;
  SET_FIELD (g_reg_val, CM__PLL0_CFG24__PLL0_PI_FBDIV_DIV4_EN, 0) ;
  SET_FIELD (g_reg_val, CM__PLL0_CFG24__PLL0_USE_CODE_FORWARDING, 0) ;
  WRITE_REG (g_cm_base_addr_lut[a_cm_no], CM__PLL0_CFG24__ADDR, g_reg_val) ;

  WRITE_REG_FIELD(g_cm_base_addr_lut[a_cm_no], CM__PIN_OVRDEN1__OVRD_EN_PLL0_FCODE_I, 0);
  WRITE_REG_FIELD(g_cm_base_addr_lut[a_cm_no], CM__PIN_OVRDEN1__OVRD_EN_PLL0_FCODE_UPDATE_I, 0);
}

bool pmix_inl_cal_measure_histogram (uint8_t a_lane_no, float *a_dnl) {

  rx_t *vp_rx = &g_rx[a_lane_no];
  bool v_done = false;

  switch (vp_rx->m_rx_pmix_inl_hist_st) {

    case e_rx_pmix_hist_cfg: {
      vp_rx->m_rx_pmix_code = 0;
      vp_rx->m_rx_mean_pmix_hist = 0;
      for (uint16_t i = 0; i < 256; i++) {
        a_dnl[i] = 0;
      }

      g_reg_val = READ_REG( g_rx_base_addr, RX__PMIX_HIST0__ADDR ); 
      SET_FIELD( g_reg_val, RX__PMIX_HIST0__PMIX_HIST_CG_BYPASS, 1 );
      SET_FIELD( g_reg_val, RX__PMIX_HIST0__PMIX_HIST_LD_VAL_3_0, 15 );
      SET_FIELD( g_reg_val, RX__PMIX_HIST0__PMIX_HIST_N_TOP_3_0, 1 );
      WRITE_REG( g_rx_base_addr, RX__PMIX_HIST0__ADDR, g_reg_val );
      vp_rx->m_rx_pmix_inl_hist_st = e_rx_pmix_hist_apply_code;
    }

    case e_rx_pmix_hist_apply_code: {
      g_reg_val = READ_REG( g_rx_base_addr, RX__PMIX_HIST0__ADDR ); 
      SET_FIELD( g_reg_val, RX__PMIX_HIST0__PMIX_HIST_PMIX_START_CODE_7_0, vp_rx->m_rx_pmix_code ); 
      SET_FIELD( g_reg_val, RX__PMIX_HIST0__PMIX_HIST_PMIX_END_CODE_7_0, vp_rx->m_rx_pmix_code );
      WRITE_REG( g_rx_base_addr, RX__PMIX_HIST0__ADDR, g_reg_val );

      vp_rx->m_rx_pmix_hist_update_ref = READ_REG_FIELD (g_rx_base_addr, RX__STATUS88__PMIX_HIST_DATA_UPDATE) ;

      WRITE_REG_FIELD(g_rx_base_addr, RX__PMIX_HIST0__PMIX_HIST_EN, 1);

      WRITE_REG_FIELD(g_rx_base_addr, RX__PMIX_HIST0__PMIX_HIST_READ_EN, 1);
      vp_rx->m_rx_pmix_inl_hist_st = e_pmix_hist_wait_data_update;
    }

    case e_pmix_hist_wait_data_update: {

      bool v_curr_data_update = READ_REG_FIELD (g_rx_base_addr, RX__STATUS88__PMIX_HIST_DATA_UPDATE);
      if (v_curr_data_update != vp_rx->m_rx_pmix_hist_update_ref) { 
        vp_rx->m_rx_pmix_hist_update_ref = v_curr_data_update;
        vp_rx->m_rx_pmix_inl_hist_st = e_pmix_hist_read;
      } else { 
        vp_rx->m_rx_pmix_inl_hist_st = e_pmix_hist_wait_data_update;
        break;
      }
    }

    case e_pmix_hist_read: {
      a_dnl[vp_rx->m_rx_pmix_code] = READ_REG_FIELD(g_rx_base_addr, RX__STATUS88__PMIX_HIST_HIT_CNT_15_0);
      vp_rx->m_rx_mean_pmix_hist += a_dnl[vp_rx->m_rx_pmix_code];

      WRITE_REG_FIELD(g_rx_base_addr, RX__PMIX_HIST0__PMIX_HIST_READ_EN, 0);
      vp_rx->m_rx_pmix_inl_hist_st = e_pmix_hist_wait_done;
    }

    case e_pmix_hist_wait_done: {
      bool v_curr_hist_done = READ_REG_FIELD( g_rx_base_addr, RX__STATUS88__PMIX_HIST_DONE );
      if (v_curr_hist_done == true) { 
        WRITE_REG_FIELD(g_rx_base_addr, RX__PMIX_HIST0__PMIX_HIST_EN, 0);
        vp_rx->m_rx_pmix_code++;
        if(vp_rx->m_rx_pmix_code <= 255) { 
          vp_rx->m_rx_pmix_inl_hist_st = e_rx_pmix_hist_apply_code;
          break;
        } else { 
          WRITE_REG_FIELD(g_rx_base_addr, RX__PMIX_HIST0__PMIX_HIST_CG_BYPASS, 0);
          vp_rx->m_rx_pmix_inl_hist_st = e_pmix_hist_dnl_calc;
        }
      } else { 
        vp_rx->m_rx_pmix_inl_hist_st = e_pmix_hist_wait_done;
        break;
      }
    }

    case e_pmix_hist_dnl_calc: {
      vp_rx->m_rx_mean_pmix_hist /= 256;

      for (uint16_t i = 0; i < 256; i++) {
        a_dnl[i] = (a_dnl[i]/vp_rx->m_rx_mean_pmix_hist) - 1;
      }
      v_done = true;
      vp_rx->m_rx_pmix_inl_hist_st = e_rx_pmix_hist_cfg;
      break;
    }
  }

  return v_done;
}

uint16_t float_to_q4p4 (uint8_t a_lane_no, float x) {

  uint8_t v_do_floor;
  uint16_t v_q4p4;

  x = (x < -16.0) ? (-16.0) :
      (x > 15.9375) ? (15.9375) : x;

  v_do_floor = ((int) (x * (1<<4))) == (x * (1<<4)) ? 0: 1;
  v_q4p4 = (((uint8_t) ((x * (1<<4))-(x<0)*v_do_floor)) + ((1<<8)*(x<0)));

  return v_q4p4;
}

void pmix_inl_cal_write_inl_correction (uint8_t a_lane_no) {

  rx_t *vp_rx = &g_rx[a_lane_no];
  float v_inl[256]; float v_avg_dnl[256];
  
  for ( uint16_t i = 0; i < 256; i++ ) {
    v_avg_dnl[i] = ((vp_rx->m_rx_pmix_inl_hist.m_pos_dnl[i]) + (vp_rx->m_rx_pmix_inl_hist.m_neg_dnl[i]))/2;
  }
  v_inl[0] = v_avg_dnl[0];
  for (uint16_t i = 1; i < 256; i++) {
    v_inl[i] = v_inl[i-1] + v_avg_dnl[i];
  }

  WRITE_REG_FIELD (g_rx_base_addr, RX__RXS_CFG5__PMIX_INL_CORRECTION_EN, 0) ; 

  for (uint16_t li = 0 ; li< (uint8_t) 255/3; li++) { 
      g_reg_val = (uint32_t) (float_to_q4p4(a_lane_no, v_inl[3*li]) | \
                  ((0x1ff << 9) & (float_to_q4p4(a_lane_no, v_inl[3*li+1]) << 9)) | \
                  ((0x1ff << 18) & (float_to_q4p4(a_lane_no, v_inl[3*li+2]) << 18)));
      WRITE_REG (g_rx_base_addr_lut[a_lane_no], (RX__PMIX_INL_CORRECTION0__ADDR + (4*li)), g_reg_val) ;
  }

  WRITE_REG (g_rx_base_addr_lut[a_lane_no], RX__PMIX_INL_CORRECTION85__ADDR, float_to_q4p4(a_lane_no, v_inl[255])) ;  
}


bool rx__pmix_inl_cal (uint8_t a_lane_no) {
                                                                                                              
  bool v_success = false; 
  
  rx_t *vp_rx = &g_rx[a_lane_no];
                                                                                                              
  switch (vp_rx->m_rx_pmix_inl_cal_st) {

    case e_rx_pmix_inl_cfg: {
      vp_rx->m_rx_pmix_inl_pos_done = false;
      vp_rx->m_rx_pmix_inl_neg_done = false;

      vp_rx->m_rx_pmix_inl_cal_st = e_rx_pmix_inl_enable_lpbk;
    }

    case e_rx_pmix_inl_enable_lpbk: {
      pmix_inl_cal_set_internal_lpbk(a_lane_no, true);
                                                                                                              
      pmix_inl_cal_store_tx_eq_settings(a_lane_no);
      pmix_inl_cal_write_tx_eq_settings(a_lane_no, e_pmix_inl_cal_settings_type_cal);
                                                                                                              
      pmix_inl_cal_store_afe_vga_settings (a_lane_no);
      pmix_inl_cal_write_afe_vga_settings(a_lane_no, e_pmix_inl_cal_settings_type_cal);
      
      func_do_adapt(a_lane_no, 0, 0);
                                                                                                              
      pmix_inl_cal_store_txrx_signal_type(a_lane_no);
      pmix_inl_cal_set_txrx_signal_type (a_lane_no, e_pmix_inl_cal_settings_type_cal);
                                                                                                              
      tx__patgen_cfg_save (a_lane_no);
      pmix_inl_cal_set_patgen_settings (a_lane_no);
                                                                                                              
      WRITE_REG_FIELD(g_rx_base_addr, RX__CDR_CONFIG3__MM_CDR_SOFT_DATA_SEL, 0);
                                                                                                              
      vp_rx->m_rx_pmix_inl_cal_st = e_rx_pmix_inl_apply_pos_ppm;
    }

    case e_rx_pmix_inl_apply_pos_ppm: {
      
      if (g_rx_pmix_inl_pos_ppm_applied == false) { 
        pmix_inl_cal_cm_write_fcode( (a_lane_no < 2 ? 0 : 1), gRxLaneConfigBlock[a_lane_no].m_pmix_inl_cal_ppm_offst); 
        g_rx_pmix_inl_pos_ppm_applied = true;
        vp_rx->m_rx_pmix_inl_cal_st = e_rx_pmix_inl_measure_pos_dnl;
      } else { 
        vp_rx->m_rx_pmix_inl_cal_st = e_rx_pmix_inl_measure_pos_dnl;
      }

      func_do_adapt(a_lane_no, 0, 10);
    }
    
    case e_rx_pmix_inl_measure_pos_dnl: {
                                                                                                              
      vp_rx->m_rx_pmix_inl_pos_done = pmix_inl_cal_measure_histogram (a_lane_no, (vp_rx->m_rx_pmix_inl_hist.m_pos_dnl));
                                                                                                              
      if (vp_rx->m_rx_pmix_inl_pos_done) {
        vp_rx->m_rx_pmix_inl_cal_st = e_rx_pmix_inl_apply_neg_ppm;
      } else {
        break;
      }
    }

    case e_rx_pmix_inl_apply_neg_ppm: {
      
      bool v_lane_pair_pos_dnl_done = (g_pmix_inl_lane0_lane1_done) ? (g_rx[2].m_rx_pmix_inl_pos_done && g_rx[3].m_rx_pmix_inl_pos_done) : (g_rx[0].m_rx_pmix_inl_pos_done && g_rx[1].m_rx_pmix_inl_pos_done);
      
      if (v_lane_pair_pos_dnl_done && g_rx_pmix_inl_neg_ppm_applied == false) { 
        pmix_inl_cal_cm_write_fcode( (a_lane_no < 2 ? 0 : 1), (-1*(gRxLaneConfigBlock[a_lane_no].m_pmix_inl_cal_ppm_offst))); 
        g_rx_pmix_inl_pos_ppm_applied = false;
        g_rx_pmix_inl_neg_ppm_applied = true;
        vp_rx->m_rx_pmix_inl_cal_st = e_rx_pmix_inl_measure_neg_dnl;
      } else {
        vp_rx->m_rx_pmix_inl_cal_st = e_rx_pmix_inl_measure_neg_dnl;
      }

      func_do_adapt(a_lane_no, 10, 10);
    }

    case e_rx_pmix_inl_measure_neg_dnl: {
                                                                                                                    
      vp_rx->m_rx_pmix_inl_neg_done = pmix_inl_cal_measure_histogram (a_lane_no, (vp_rx->m_rx_pmix_inl_hist.m_neg_dnl));
                                                                                                              
      if (vp_rx->m_rx_pmix_inl_neg_done) {
        vp_rx->m_rx_pmix_inl_cal_st = e_rx_pmix_inl_write_inl;
      } else {
        break;
      }
    }
                                                                                                              
    case e_rx_pmix_inl_write_inl: {

      pmix_inl_cal_write_inl_correction (a_lane_no);
      vp_rx->m_rx_pmix_inl_cal_st = e_rx_pmix_inl_remove_ppm;
    }

    case e_rx_pmix_inl_remove_ppm: {

      bool v_lane_pair_neg_dnl_done = (g_pmix_inl_lane0_lane1_done) ? (g_rx[2].m_rx_pmix_inl_neg_done && g_rx[3].m_rx_pmix_inl_neg_done) : (g_rx[0].m_rx_pmix_inl_neg_done && g_rx[1].m_rx_pmix_inl_neg_done);

      if(v_lane_pair_neg_dnl_done && g_rx_pmix_inl_neg_ppm_applied) { 
        pmix_inl_cal_turn_off_fcode_forwarding((a_lane_no < 2 ? 0 : 1)); 
        g_rx_pmix_inl_neg_ppm_applied = false;
        vp_rx->m_rx_pmix_inl_cal_st = e_rx_pmix_inl_restore_settings;
      } else if (v_lane_pair_neg_dnl_done) {
        vp_rx->m_rx_pmix_inl_cal_st = e_rx_pmix_inl_restore_settings;
      } else {
        break;
      }

      vp_rx->m_rx_pmix_inl_cal_st = e_rx_pmix_inl_restore_settings;
    }

    case e_rx_pmix_inl_restore_settings: {

      pmix_inl_cal_set_internal_lpbk(a_lane_no, false);

      pmix_inl_cal_write_tx_eq_settings(a_lane_no, e_pmix_inl_cal_settings_type_restore);

      pmix_inl_cal_write_afe_vga_settings (a_lane_no, e_pmix_inl_cal_settings_type_restore);

      pmix_inl_cal_set_txrx_signal_type(a_lane_no, e_pmix_inl_cal_settings_type_restore);
                                                                                                              
      WRITE_REG_FIELD( g_rx_base_addr, RX__CDR_CONFIG3__MM_CDR_SOFT_DATA_SEL, 1);
                                                                                                              
      tx__patgen_cfg_restore (a_lane_no);

      vp_rx->m_rx_pmix_inl_cal_done = true;
      v_success = true;

      vp_rx->m_rx_pmix_inl_cal_st = e_rx_pmix_inl_cfg;
      break;
    }
  }

  return v_success;
}


