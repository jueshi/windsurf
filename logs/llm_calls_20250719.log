#include "fw.h"


void execute_general_debug_mb_cmd () {
   general_debug_fsm_h.current_state  = general_debug_mb_start_st_array [general_debug_mb_cmd] ; 
   new_general_debug_cmd   = 0 ; 
   general_debug_cmd_cmplt = 0 ; 
   general_debug_fsm_busy  = 1 ; 
}





void func_general_debug_idle_st () {
   general_debug_fsm_h.current_state = GENERAL_DEBUG_IDLE_ST ;
}


void func_general_debug_read_fw_ver_st () {
   general_debug_cmd_cmplt = 1 ; 
   general_debug_fsm_h.current_state = GENERAL_DEBUG_IDLE_ST ; 
}



void func_general_debug_tsense () {
  bool      v_done              = false;
  uint8_t   v_inst              = 0;
  uint8_t   v_cm_no             = general_debug_fsm_h.m_cm_no;
  uint8_t   v_lane_count        = general_debug_fsm_h.m_lane_count;
  uint8_t   v_tsense_vbg0_vbe1  = gCmConfigBlock[v_cm_no].m_tsense_vbg0_vbe1;
  uint8_t   v_lane_no           = 0;
  uint8_t   v_ts_code_idx       = 0;
  uint32_t  v_ts_code           = 0;
  int8_t    v_temp_signed       = 0;

  switch (general_debug_fsm_h.m_tsense_st) {
    case e_tsense_cfg_st1: {
      gCmConfigBlock[v_cm_no].m_tsense_error  = 0;
      gCmConfigBlock[v_cm_no].m_tsense_vbg    = 0;
      gCmConfigBlock[v_cm_no].m_tsense_vbe    = 0;
      gCmConfigBlock[v_cm_no].m_s2c_meas_temp = 0x80; 

      general_debug_fsm_h.m_tsense_bin_search_fsm_st = e_tsense_bin_search_init_st; 
      general_debug_fsm_h.m_tsense_lin_search_fsm_st = e_tsense_lin_search_init_st; 

      for (v_inst = 0; v_inst < g_num_lane; v_inst++) {
        if (v_inst < g_num_cm) {
          WRITE_REG_FIELD( g_cm_base_addr_lut[v_inst], CM__ANA_OVRDVAL1__ANA_DEBUG_SEL_I_3_0,      0x0 );
          WRITE_REG_FIELD( g_cm_base_addr_lut[v_inst], CM__ANA_OVRDEN0__OVRD_EN_ANA_DEBUG_SEL_I,   0x1 );
        }

        WRITE_REG_FIELD( g_rx_base_addr_lut[v_inst], RX__ANA_OVRDVAL4__ANA_RX_ANA_ANA_DEBUG_SEL_I_3_0,    0x0 );
        WRITE_REG_FIELD( g_rx_base_addr_lut[v_inst], RX__ANA_OVRDEN1__OVRD_EN_ANA_RX_ANA_ANA_DEBUG_SEL_I, 0x1 );

        WRITE_REG_FIELD( g_tx_base_addr_lut[v_inst], TX__ANA_OVRDVAL9__ANA_TX_ANA_DEBUG_SEL_3_0,          0x0 );
        WRITE_REG_FIELD( g_tx_base_addr_lut[v_inst], TX__ANA_OVRDEN0__OVRD_EN_TX_ANA_DEBUG_SEL,           0x1 );

      }

      g_reg_val = READ_REG( g_cm_base_addr_lut[v_cm_no], CM__ANA_OVRDVAL1__ADDR );
      SET_FIELD( g_reg_val, CM__ANA_OVRDVAL1__CM_ANA_BG_EN,      0x1 );
      SET_FIELD( g_reg_val, CM__ANA_OVRDVAL1__CM_ANA_BG_EN_DCO,  0x1 );
      SET_FIELD( g_reg_val, CM__ANA_OVRDVAL1__CM_ANA_BG_CHOP_EN, 0x1 );
      WRITE_REG( g_cm_base_addr_lut[v_cm_no], CM__ANA_OVRDVAL1__ADDR, g_reg_val );

      WRITE_REG_FIELD( g_cm_base_addr_lut[v_cm_no], CM__ANA_OVRDVAL13__CM_ANA_VREG_DOUBLER_EN, 0x1 );

      g_reg_val = READ_REG( g_cm_base_addr_lut[v_cm_no], CM__ANA_OVRDEN0__ADDR );
      SET_FIELD( g_reg_val, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_BG_EN,      0x1 );
      SET_FIELD( g_reg_val, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_BG_EN_DCO,  0x1 );
      WRITE_REG( g_cm_base_addr_lut[v_cm_no], CM__ANA_OVRDEN0__ADDR, g_reg_val );

      WRITE_REG_FIELD( g_cm_base_addr_lut[v_cm_no], CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_BG_CHOP_EN, 0x1 );
      WRITE_REG_FIELD( g_cm_base_addr_lut[v_cm_no], CM__ANA_OVRDEN6__OVRD_EN_CM_ANA_VREG_DOUBLER_EN, 0x1 );

      delay_start (&general_debug_fsm_h.m_delay_timer, 10);

      general_debug_fsm_h.m_tsense_st = e_tsense_cfg_st2;
      break;
    }

    case e_tsense_cfg_st2: {
      if (delay_is_done(&general_debug_fsm_h.m_delay_timer)) {
        for (v_inst = 0; v_inst < v_lane_count; v_inst++) {
          v_lane_no = general_debug_fsm_h.m_lane_no[v_inst];

          WRITE_REG_FIELD( g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL0__ANA_TX_ANA_BIAS_EN,    0x1 );
          WRITE_REG_FIELD( g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN0__OVRD_EN_TX_ANA_BIAS_EN, 0x1 );

          WRITE_REG_FIELD( g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL12__ANA_TX_ANA_VREG_EN, 0x1 );
          WRITE_REG_FIELD( g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL6__ANA_TX_ANA_CAL_EN,   0x0 );  

          g_reg_val = READ_REG( g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN4__ADDR );
          SET_FIELD( g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_VREG_EN, 0x1 );
          SET_FIELD( g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CAL_EN,  0x1 );

          WRITE_REG( g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN4__ADDR, g_reg_val );

          
          g_reg_val = READ_REG (g_tx_base_addr_lut[v_lane_no], TX__TXS_CFG1__ADDR); 
          general_debug_fsm_h.m_tx_calclk_div[v_inst] = GET_FIELD (g_reg_val, TX__TXS_CFG1__CALCLK_DIV_5_0);
          SET_FIELD (g_reg_val, TX__TXS_CFG1__CALCLK_DIV_5_0, 0x3F); 
          general_debug_fsm_h.m_tx_calkclk_div_use_ref_range[v_inst] = GET_FIELD (g_reg_val, TX__TXS_CFG1__CALCLK_DIV_USE_REF_RANGE);
          SET_FIELD (g_reg_val, TX__TXS_CFG1__CALCLK_DIV_USE_REF_RANGE, 0x0); 
          WRITE_REG (g_tx_base_addr_lut[v_lane_no], TX__TXS_CFG1__ADDR, g_reg_val);

          g_reg_val = READ_REG( g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL5__ADDR );

          general_debug_fsm_h.m_tx_ana_drv_dac_cal_static_pattern[v_inst] = GET_FIELD( g_reg_val, TX__ANA_OVRDVAL5__ANA_TX_ANA_DRV_DAC_CAL_STATIC_PATTERN_3_0 );
          SET_FIELD( g_reg_val, TX__ANA_OVRDVAL5__ANA_TX_ANA_DRV_DAC_CAL_STATIC_PATTERN_3_0, 0x5 );
          WRITE_REG( g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL5__ADDR, g_reg_val );

          g_reg_val = READ_REG( g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN1__ADDR );
          general_debug_fsm_h.m_tx_ana_drv_dac_cal_static_pattern_ovrden[v_inst] = GET_FIELD( g_reg_val, TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_DRV_DAC_CAL_STATIC_PATTERN );
          SET_FIELD( g_reg_val, TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_DRV_DAC_CAL_STATIC_PATTERN, 0x1 );
 
          WRITE_REG( g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN1__ADDR, g_reg_val );
        }

        delay_start (&general_debug_fsm_h.m_delay_timer, 20);

        general_debug_fsm_h.m_tsense_st = e_tsense_cfg_st3;
        break;
        
      } else {
        break;
      }
    }
    
    case e_tsense_cfg_st3: {
      if (delay_is_done(&general_debug_fsm_h.m_delay_timer)) {
        WRITE_REG_FIELD (g_cm_base_addr_lut[v_cm_no], CM__ANA_OVRDVAL1__CM_ANA_BG_TEMP_MEAS,        0x1);
        WRITE_REG_FIELD (g_cm_base_addr_lut[v_cm_no], CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_BG_TEMP_MEAS, 0x1);
    
        
        gCmConfigBlock[v_cm_no].m_tsense_vbg0_vbe1 = 0;
        v_tsense_vbg0_vbe1 = gCmConfigBlock[v_cm_no].m_tsense_vbg0_vbe1;
        WRITE_REG_FIELD (g_cm_base_addr_lut[v_cm_no], CM__ANA_OVRDVAL1__ANA_DEBUG_SEL_I_3_0, 0xB); 
    
        for (v_inst = 0; v_inst < v_lane_count; v_inst++) {
          v_lane_no = general_debug_fsm_h.m_lane_no[v_inst];
          WRITE_REG_FIELD (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL9__ANA_TX_ANA_DEBUG_SEL_3_0, 0x1);
        }

        delay_start (&general_debug_fsm_h.m_delay_timer, 20);

        general_debug_fsm_h.m_tsense_st = e_tsense_cfg_st4;
        break;
        
      } else {
        break;
      }
    }

    case e_tsense_cfg_st4: {
      if (delay_is_done(&general_debug_fsm_h.m_delay_timer)) {
        for (v_inst = 0; v_inst < v_lane_count; v_inst++) {
          v_lane_no = general_debug_fsm_h.m_lane_no[v_inst];

          
          WRITE_REG_FIELD (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_COMP_MODE_1_0, 0x2);
          WRITE_REG_FIELD (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_CAL_COMP_MODE,  0x1);

          g_reg_val = READ_REG (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL6__ADDR);
          SET_FIELD (g_reg_val, TX__ANA_OVRDVAL6__ANA_TX_ANA_CAL_MUXA_SEL_3_0, 0x0);
          SET_FIELD (g_reg_val, TX__ANA_OVRDVAL6__ANA_TX_ANA_CAL_MUXB_SEL_3_0, (v_inst == 0 ? 0xF : 0xE));
          WRITE_REG (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL6__ADDR, g_reg_val);

          g_reg_val = READ_REG (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN4__ADDR);
          SET_FIELD (g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CAL_MUXA_SEL, 0x1);
          SET_FIELD (g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CAL_MUXB_SEL, 0x1);
          WRITE_REG (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN4__ADDR, g_reg_val);

          WRITE_REG_FIELD (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_CAL_COMP, 0x0);
          WRITE_REG_FIELD (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL6__ANA_TX_ANA_CAL_EN,    0x1);
          WRITE_REG_FIELD (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_REF_SEL_9_0, 0x0);
          WRITE_REG_FIELD (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_CAL_REF_SEL,  0x1);
        }

        general_debug_fsm_h.m_tsense_st = e_tsense_search_st;

      } else {
        break;
      }
    }

    case e_tsense_search_st: {
      {
        v_done = func_general_debug_tsense_linear_search(v_cm_no, v_tsense_vbg0_vbe1); 
      }

      if (v_done) {
        general_debug_fsm_h.m_tsense_st = e_tsense_cal_vref_sel_ramp_down_st; 
      } else {
        break;
      }
    }

    case e_tsense_cal_vref_sel_ramp_down_st: {

      v_lane_no = general_debug_fsm_h.m_lane_no[v_tsense_vbg0_vbe1];

      if (general_debug_fsm_h.m_tx_ana_cal_ref_sel == 0) {
        gCmConfigBlock[v_cm_no].m_tsense_error = 1; 
      }

      if (gPmdConfigBlock.m_tsense_skip_cal_vref_sel_ramp_down == 0) {
        while (general_debug_fsm_h.m_tx_ana_cal_ref_sel >= gPmdConfigBlock.m_tsense_cal_vref_sel_ramp_down_step_size) {

          general_debug_fsm_h.m_tx_ana_cal_ref_sel -= gPmdConfigBlock.m_tsense_cal_vref_sel_ramp_down_step_size;

          delay_ns(10);  

          WRITE_REG_FIELD (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_REF_SEL_9_0, general_debug_fsm_h.m_tx_ana_cal_ref_sel);
        };

        WRITE_REG_FIELD( g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_REF_SEL_9_0, 0 );
      }

      if ((gCmConfigBlock[v_cm_no].m_tsense_error != 1) && (v_tsense_vbg0_vbe1 == 0)) {
        
        gCmConfigBlock[v_cm_no].m_tsense_vbg0_vbe1 = 1;
        v_tsense_vbg0_vbe1 = gCmConfigBlock[v_cm_no].m_tsense_vbg0_vbe1;
        
        if (general_debug_fsm_h.m_lane_count == 1) {
          WRITE_REG_FIELD (g_cm_base_addr_lut[v_cm_no], CM__ANA_OVRDVAL1__ANA_DEBUG_SEL_I_3_0, 0x2); 
        }
        
        delay_start (&general_debug_fsm_h.m_delay_timer, gPmdConfigBlock.m_vbg_to_vbe_wait_us);
        
        general_debug_fsm_h.m_tsense_st = e_tsense_search_st;
        
        break;
      }

      general_debug_fsm_h.m_tsense_st = e_tsense_compute_st;
    }

    case e_tsense_compute_st: {
      if (gCmConfigBlock[v_cm_no].m_tsense_error == 0) {
        if(general_debug_fsm_h.m_lane_count == 2) {
          v_ts_code = ((1000 * gCmConfigBlock[v_cm_no].m_tsense_vbe) * 250) / (gCmConfigBlock[v_cm_no].m_tsense_vbg);

        } else{
          v_ts_code = ((1000 * gCmConfigBlock[v_cm_no].m_tsense_vbe) * 500) / (gCmConfigBlock[v_cm_no].m_tsense_vbg);
        } 


        if (general_debug_mb_cmd  == 3 || g_pmd_cm[v_cm_no].m_vctl_temp_meas_in_prog) {  
          v_ts_code = v_ts_code + general_debug_fsm_h.m_trim_code;
      
          for (v_inst = 0; v_inst < TSENSE_LUT_SIZE; v_inst++) {  
            v_ts_code_idx = v_inst;

            if (v_ts_code >= (1000 * ts_code_lut[v_inst])) {
              break;
            }
          }
      
          if (v_ts_code_idx == 0) {
            gCmConfigBlock[v_cm_no].m_s2c_meas_temp = (uint8_t)MIN_TEMP; 
      
          } else if (v_ts_code_idx == TSENSE_LUT_SIZE - 1) {
            gCmConfigBlock[v_cm_no].m_s2c_meas_temp = (uint8_t)MAX_TEMP; 
      
          } else {
            v_ts_code = (  ( (TEMP_STEP * (v_ts_code - (1000 * ts_code_lut[v_ts_code_idx]))) / (ts_code_lut[v_ts_code_idx-1] - ts_code_lut[v_ts_code_idx]) )/1000  );
            v_temp_signed = MIN_TEMP + (v_ts_code_idx * TEMP_STEP) - v_ts_code;
      
            gCmConfigBlock[v_cm_no].m_s2c_meas_temp = (uint8_t)v_temp_signed;
          }
      
        } else {  
          gPmdConfigBlock.m_tsense_trim_code = ts_code_lut[general_debug_fsm_h.m_trim_temp_idx] - (v_ts_code/1000);  
        }
      }

      general_debug_fsm_h.m_tsense_st = e_tsense_clr_ovrd_st;
    }

    case e_tsense_clr_ovrd_st: {
      for (v_inst = 0; v_inst < g_num_lane; v_inst++) {
        if (v_inst < v_lane_count) {
          v_lane_no = general_debug_fsm_h.m_lane_no[v_inst];

          g_reg_val = READ_REG (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN1__ADDR);
          SET_FIELD (g_reg_val, TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_CAL_COMP_MODE, 0x0);
          SET_FIELD (g_reg_val, TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_CAL_REF_SEL,   0x0);
          WRITE_REG (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN1__ADDR, g_reg_val);

          g_reg_val = READ_REG (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN4__ADDR);
          SET_FIELD (g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_VREG_EN,      0x0);
          SET_FIELD (g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CAL_EN,       0x0);
          SET_FIELD (g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CAL_MUXA_SEL, 0x0);
          SET_FIELD (g_reg_val, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CAL_MUXB_SEL, 0x0);

          WRITE_REG (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN4__ADDR, g_reg_val);


          WRITE_REG_FIELD (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN0__OVRD_EN_TX_ANA_BIAS_EN, 0x0);

          g_reg_val = READ_REG (g_tx_base_addr_lut[v_lane_no], TX__TXS_CFG1__ADDR); 
          SET_FIELD (g_reg_val, TX__TXS_CFG1__CALCLK_DIV_5_0, general_debug_fsm_h.m_tx_calclk_div[v_inst]);
          SET_FIELD (g_reg_val, TX__TXS_CFG1__CALCLK_DIV_USE_REF_RANGE, general_debug_fsm_h.m_tx_calkclk_div_use_ref_range[v_inst]);
          WRITE_REG (g_tx_base_addr_lut[v_lane_no], TX__TXS_CFG1__ADDR, g_reg_val);

          WRITE_REG_FIELD( g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL5__ANA_TX_ANA_DRV_DAC_CAL_STATIC_PATTERN_3_0, general_debug_fsm_h.m_tx_ana_drv_dac_cal_static_pattern[v_inst] );
          WRITE_REG_FIELD( g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_DRV_DAC_CAL_STATIC_PATTERN, general_debug_fsm_h.m_tx_ana_drv_dac_cal_static_pattern_ovrden[v_inst] );
  
      }

        WRITE_REG_FIELD (g_tx_base_addr_lut[v_inst], TX__ANA_OVRDEN0__OVRD_EN_TX_ANA_DEBUG_SEL, 0x0);

        WRITE_REG_FIELD (g_rx_base_addr_lut[v_inst], RX__ANA_OVRDEN1__OVRD_EN_ANA_RX_ANA_ANA_DEBUG_SEL_I, 0x0);

        if (v_inst < g_num_cm) {
          WRITE_REG_FIELD (g_cm_base_addr_lut[v_inst], CM__ANA_OVRDEN0__OVRD_EN_ANA_DEBUG_SEL_I, 0x0);
        }
      }

      WRITE_REG_FIELD (g_cm_base_addr_lut[v_cm_no], CM__ANA_OVRDEN6__OVRD_EN_CM_ANA_VREG_DOUBLER_EN, 0x0);

      g_reg_val = READ_REG (g_cm_base_addr_lut[v_cm_no], CM__ANA_OVRDEN0__ADDR);
      SET_FIELD (g_reg_val, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_BG_EN,        0x0);
      SET_FIELD (g_reg_val, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_BG_EN_DCO,    0x0);
      SET_FIELD (g_reg_val, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_BG_CHOP_EN,   0x0);
      SET_FIELD (g_reg_val, CM__ANA_OVRDEN0__OVRD_EN_CM_ANA_BG_TEMP_MEAS, 0x0);

      WRITE_REG (g_cm_base_addr_lut[v_cm_no], CM__ANA_OVRDEN0__ADDR, g_reg_val);

      general_debug_fsm_h.m_tsense_st = e_tsense_done_st;
    }

    case e_tsense_done_st: {
      general_debug_fsm_h.m_tsense_in_prog = false;

      general_debug_fsm_h.m_tsense_st = e_tsense_cfg_st1;

      if (g_pmd_cm[v_cm_no].m_vctl_temp_meas_in_prog == true) {  
        g_pmd_cm[v_cm_no].m_vctl_temp_meas_in_prog = false;
        general_debug_fsm_busy  = 0; 

      } else {                                    
        general_debug_cmd_cmplt = 1; 
      }

      general_debug_fsm_h.current_state = GENERAL_DEBUG_IDLE_ST;
    }
  }

  return;
}


bool func_general_debug_tsense_linear_search (uint8_t a_cm_no, uint8_t a_tsense_vbg0_vbe1) {

  uint8_t   v_lane_no     = general_debug_fsm_h.m_lane_no[a_tsense_vbg0_vbe1];
  uint8_t   v_inst        = 0;
  uint8_t   v_sample_done = 0;

  int32_t   v_tsense_meas_err_threshold_n = 0;
  int32_t   v_tsense_meas_err_threshold_p = 0;

  bool      v_search_done = false;
  bool      v_done        = false;

  switch (general_debug_fsm_h.m_tsense_lin_search_fsm_st) {

    case e_tsense_lin_search_init_st: {
      if (delay_is_done(&general_debug_fsm_h.m_delay_timer)) {
        general_debug_fsm_h.m_tx_ana_cal_ref_sel  = 0;
        general_debug_fsm_h.m_tsense_lin_search_last_dir = 0;
        general_debug_fsm_h.m_tsense_lin_step     = gPmdConfigBlock.m_tsense_linear_search_step_size; 

        WRITE_REG_FIELD( g_tx_base_addr_lut[v_lane_no], TX__TXS_CFG1__CAL_COMP_SAMPLE_CNT_14_0, gPmdConfigBlock.m_tsense_cal_comp_samp_cnt );

        WRITE_REG_FIELD (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_REF_SEL_9_0, 0);

        general_debug_fsm_h.m_tsense_lin_search_fsm_st = e_tsense_lin_search_comp_assert_check_st;

      } else {
        break;
      }
    }

    case e_tsense_lin_search_comp_assert_check_st: {
      if (delay_is_done(&general_debug_fsm_h.m_delay_timer)) {

        g_reg_val = READ_REG_FIELD (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL0__ANA_TX_ANA_CAL_COMP);

        if (g_reg_val == 1) {
          general_debug_fsm_h.m_cal_comp_samp_cntr  = 0;
          general_debug_fsm_h.m_average_cntr        = 0;
          general_debug_fsm_h.m_tsense_lin_search_fsm_st = e_tsense_lin_search_accum_start_st;

        } else {
          if ((1023 - general_debug_fsm_h.m_tx_ana_cal_ref_sel) > general_debug_fsm_h.m_tsense_lin_step) {
            general_debug_fsm_h.m_tx_ana_cal_ref_sel += general_debug_fsm_h.m_tsense_lin_step;
          } else {
            general_debug_fsm_h.m_tx_ana_cal_ref_sel  = 1023;
          }

          if (general_debug_fsm_h.m_tx_ana_cal_ref_sel == 1023) {
            general_debug_fsm_h.m_tsense_lin_search_fsm_st = e_tsense_lin_search_done_st;

          } else {
            
            WRITE_REG_FIELD (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_REF_SEL_9_0, general_debug_fsm_h.m_tx_ana_cal_ref_sel);

            delay_start (&general_debug_fsm_h.m_delay_timer, gPmdConfigBlock.m_cal_ref_sel_wait_us);
          }
          break;
        }

      } else { 
        break;
      }
     }

    case e_tsense_lin_search_accum_start_st: {
      if (delay_is_done(&general_debug_fsm_h.m_delay_timer)) {

        WRITE_REG_FIELD (g_tx_base_addr_lut[v_lane_no], TX__TXS_CFG1__CAL_SAMPLE_START, 1);
        
        general_debug_fsm_h.m_tsense_lin_search_fsm_st = e_tsense_lin_search_accum_done_assert_st;
      } else {
        break;
      }
    }

    case e_tsense_lin_search_accum_done_assert_st: {
      v_inst = 0;
      do { 
        v_sample_done = READ_REG_FIELD( g_tx_base_addr_lut[v_lane_no], TX__TXS_STAT0__CAL_SAMPLE_DONE );
        v_inst++;
      } while ((v_inst < 10) && (v_sample_done == 0)); 

      if (v_sample_done == 0) {
        break;              
      }

      general_debug_fsm_h.m_cal_comp_samp_cntr += READ_REG_FIELD( g_tx_base_addr_lut[v_lane_no], TX__TXS_STAT0__CAL_COMP_SAMPLE_COUNT_14_0 );

      WRITE_REG_FIELD( g_tx_base_addr_lut[v_lane_no], TX__TXS_CFG1__CAL_SAMPLE_START, 0 );

      general_debug_fsm_h.m_tsense_lin_search_fsm_st = e_tsense_lin_search_accum_done_deassert_st;
    }

    case e_tsense_lin_search_accum_done_deassert_st: {
      v_inst = 0;
      do { 
        v_sample_done = READ_REG_FIELD( g_tx_base_addr_lut[v_lane_no], TX__TXS_STAT0__CAL_SAMPLE_DONE );
        v_inst++;
      } while ((v_inst < 10) && (v_sample_done == 1)); 

      if (v_sample_done == 1) {
        break;              
      }

       general_debug_fsm_h.m_average_cntr++;

      if (general_debug_fsm_h.m_average_cntr < general_debug_fsm_h.m_average_cnt) {

        general_debug_fsm_h.m_tsense_lin_search_fsm_st = e_tsense_lin_search_accum_start_st;
        break;

      } else {
        general_debug_fsm_h.m_tsense_lin_search_fsm_st = e_tsense_lin_search_calc_st;
      }
    }

    case e_tsense_lin_search_calc_st: {
      v_search_done = false;

      general_debug_fsm_h.m_cal_comp_samp_cntr = general_debug_fsm_h.m_cal_comp_samp_cntr / general_debug_fsm_h.m_average_cntr ;
      general_debug_fsm_h.m_cal_comp_samp_cntr = (10000 * general_debug_fsm_h.m_cal_comp_samp_cntr) / gPmdConfigBlock.m_tsense_cal_comp_samp_cnt ;
      general_debug_fsm_h.m_cal_comp_samp_cntr = (general_debug_fsm_h.m_cal_comp_samp_cntr * 2) - 10000; 

      v_tsense_meas_err_threshold_n = ((-10000 * gPmdConfigBlock.m_tsense_meas_err_threshold_per)/2)/100;
      v_tsense_meas_err_threshold_p = ((10000 * gPmdConfigBlock.m_tsense_meas_err_threshold_per)/2)/100;

      if (general_debug_fsm_h.m_cal_comp_samp_cntr < v_tsense_meas_err_threshold_n) {       
         general_debug_fsm_h.m_tx_ana_cal_ref_sel += 1;
         v_search_done = (general_debug_fsm_h.m_tsense_lin_search_last_dir == -1) || (general_debug_fsm_h.m_tx_ana_cal_ref_sel == 1023);

      } else if (general_debug_fsm_h.m_cal_comp_samp_cntr > v_tsense_meas_err_threshold_p) {        
        general_debug_fsm_h.m_tsense_lin_search_last_dir = -1; 
        general_debug_fsm_h.m_tx_ana_cal_ref_sel -= 1;
        v_search_done = (general_debug_fsm_h.m_tx_ana_cal_ref_sel == 0) ;

      } else {
        v_search_done = true;
      }

      if (v_search_done == true) {
        if (a_tsense_vbg0_vbe1 == 0) {
          gCmConfigBlock[a_cm_no].m_tsense_vbg = general_debug_fsm_h.m_tx_ana_cal_ref_sel;
        } else {
          gCmConfigBlock[a_cm_no].m_tsense_vbe = general_debug_fsm_h.m_tx_ana_cal_ref_sel;
        }
        general_debug_fsm_h.m_tsense_lin_search_fsm_st = e_tsense_lin_search_done_st;

      } else {
        
        WRITE_REG_FIELD (g_tx_base_addr_lut[v_lane_no], TX__ANA_OVRDVAL5__ANA_TX_ANA_CAL_REF_SEL_9_0, general_debug_fsm_h.m_tx_ana_cal_ref_sel);

        general_debug_fsm_h.m_cal_comp_samp_cntr  = 0;
        general_debug_fsm_h.m_average_cntr        = 0;

        general_debug_fsm_h.m_tsense_lin_search_fsm_st = e_tsense_lin_search_accum_start_st;
        break;
      }
    }

    case e_tsense_lin_search_done_st: {
      v_done = true;

      general_debug_fsm_h.m_tsense_lin_search_fsm_st = e_tsense_lin_search_init_st;
      break;
    }
  } 
  return v_done;
}



