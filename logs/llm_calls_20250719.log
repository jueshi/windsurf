  uint8_t v_lane_no = fsm_no - MAX_NUM_CM;

  tx_t *vp_tx = &g_tx[v_lane_no];
  if (handler_cmd_arg[fsm_no] == 1) { 
    if(vp_tx->m_tx_cals_use_pads == true) { 
      tx__dig_clk_en (v_lane_no, handler_cmd_arg[fsm_no]);
    }
  } else { 
    tx__dig_clk_en (v_lane_no, handler_cmd_arg[fsm_no]);
  }

  handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
}

void pmd_tx__dig_clk_en_replica (uint8_t fsm_no) {
