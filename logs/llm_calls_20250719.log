void tx__dcc_cal_code_initiate_restore (uint8_t a_lane_no, tx_dcc_cal_settings *ap_tx_dcc_cal_settings) {
  
  g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL16__ADDR );
  SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL16__DCC000_CAL_CODE_RESTORE_6_0, ap_tx_dcc_cal_settings->dcc000_cal_code );
  SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL16__DCC090_CAL_CODE_RESTORE_6_0, ap_tx_dcc_cal_settings->dcc090_cal_code );
  SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL16__DCC180_CAL_CODE_RESTORE_6_0, ap_tx_dcc_cal_settings->dcc180_cal_code );
  SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL16__DCC270_CAL_CODE_RESTORE_6_0, ap_tx_dcc_cal_settings->dcc270_cal_code );
  WRITE_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL16__ADDR, g_reg_val );

  g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL17__ADDR );
  SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL17__DCC000_CAL_REF_SEL_REPLICA_RESTORE_9_0, ap_tx_dcc_cal_settings->dcc000_cal_ref_sel_replica );
  SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL17__DCC090_CAL_REF_SEL_REPLICA_RESTORE_9_0, ap_tx_dcc_cal_settings->dcc090_cal_ref_sel_replica );
  WRITE_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL17__ADDR, g_reg_val );

  g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL18__ADDR );
  SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL18__DCC180_CAL_REF_SEL_REPLICA_RESTORE_9_0, ap_tx_dcc_cal_settings->dcc180_cal_ref_sel_replica );
  SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL18__DCC270_CAL_REF_SEL_REPLICA_RESTORE_9_0, ap_tx_dcc_cal_settings->dcc270_cal_ref_sel_replica );
  WRITE_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL18__ADDR, g_reg_val );

  g_reg_val = READ_REG( g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR );
  SET_FIELD( g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_DCC_RESTORE_I, 1 );
  SET_FIELD( g_reg_val, TX__PIN_OVRDVAL1__INT_TX0_DCC_CAL_REQ_I, 1 );
  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDVAL1__ADDR, g_reg_val );

  g_reg_val = READ_REG( g_tx_base_addr, TX__PIN_OVRDEN2__ADDR );
  SET_FIELD( g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_DCC_RESTORE_I, 1 );
  SET_FIELD( g_reg_val, TX__PIN_OVRDEN2__OVRD_EN_TX0_DCC_CAL_REQ_I, 1 );
  WRITE_REG( g_tx_base_addr, TX__PIN_OVRDEN2__ADDR, g_reg_val );
  
}

