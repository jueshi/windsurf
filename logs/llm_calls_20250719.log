  tx_patgen_settings_h[a_lane_no].custom_pattern_cfg3 = READ_REG( g_tx_base_addr, TX__TST_CFG3__ADDR );
  tx_patgen_settings_h[a_lane_no].custom_pattern_cfg4 = READ_REG( g_tx_base_addr, TX__TST_CFG4__ADDR );
  tx_patgen_settings_h[a_lane_no].custom_pattern_cfg5 = READ_REG( g_tx_base_addr, TX__TST_CFG5__ADDR );
  tx_patgen_settings_h[a_lane_no].custom_pattern_cfg9 = READ_REG( g_tx_base_addr, TX__TST_CFG9__ADDR );
  tx_patgen_settings_h[a_lane_no].custom_pattern_cfg10 = READ_REG( g_tx_base_addr, TX__TST_CFG10__ADDR );
  tx_patgen_settings_h[a_lane_no].custom_pattern_cfg11 = READ_REG( g_tx_base_addr, TX__TST_CFG11__ADDR );
 
