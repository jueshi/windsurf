#include "rx.h"











void vga_fine_adapt_config (uint8_t a_lane_no) {

  rx_t *vp_rx = &g_rx[a_lane_no];

  uint32_t vRxAnaSpare;
  uint32_t vRxAnaSpareVal = 0;
  uint32_t v_vga_dac_sel = 0;

  if (gRxLaneConfigBlock[a_lane_no].m_afe_fine_adapt_run_dsp) {
    if(gRxXFwDoFtffe[a_lane_no] == 0) {
      WRITE_REG_FIELD (g_rx_base_addr, RX__MODE_CTL14__ADPT_CDR_EN_14_11_0, 0x19F) ;     
    } else {
      WRITE_REG_FIELD (g_rx_base_addr, RX__MODE_CTL14__ADPT_CDR_EN_14_11_0, 0x59F) ;     
    }
  } else {
    WRITE_REG_FIELD (g_rx_base_addr, RX__MODE_CTL14__ADPT_CDR_EN_14_11_0, 0x191) ;
  }

  WRITE_REG_FIELD (g_rx_base_addr, RX__MODE_CTL14__N_TOP_14_10_0, 64);

  g_reg_val = READ_REG( g_rx_base_addr, RX__ANA_OVRDVAL14__ANA_RX_ANA_VGA_GAIN_I_19_0__ADDR ); 
  vRxAnaSpareVal = GET_FIELD( g_reg_val, RX__ANA_OVRDVAL14__ANA_RX_ANA_VGA_GAIN_I_19_0 );
  gVgaCoarseCode[a_lane_no] = (uint8_t) (therm2dec(vRxAnaSpareVal)) ; 
  gRxLaneConfigBlock[a_lane_no].m_rx_cca_vga_coarse_code = gVgaCoarseCode[a_lane_no];

   
  vp_rx->m_rx_vga_cca_coarse_max = gPmdConfigBlock.m_vga_coarse_max;
  vp_rx->m_rx_vga_cca_coarse_min = min( gVgaCoarseCode[a_lane_no],
                                        ((vp_rx->m_rx_rate >= e_ref_156p25m_eth_106g) ? gPmdConfigBlock.m_vga_coarse_min : gRxLaneConfigBlock[a_lane_no].m_rx_vga_cca_coarse_min_lteq_50g) );
   

  gVgaFineCode[a_lane_no] = 0 ;
  gRxLaneConfigBlock[a_lane_no].m_rx_cca_vga_fine_code = gVgaFineCode[a_lane_no];


  WRITE_REG( g_rx_base_addr, RX__ANA_OVRDVAL14__ANA_RX_ANA_VGA_GAIN_I_19_0__ADDR, g_reg_val );

  g_reg_val = READ_REG( g_rx_base_addr, RX__ANA_OVRDVAL15__ANA_RX_ANA_VGA_GAIN_REPLICA_I_3_0__ADDR ); 
  WRITE_REG( g_rx_base_addr, RX__ANA_OVRDVAL15__ANA_RX_ANA_VGA_GAIN_REPLICA_I_3_0__ADDR, g_reg_val ); 

  g_reg_val = READ_REG( g_rx_base_addr, RX__ANA_OVRDEN2__ADDR );
  SET_FIELD( g_reg_val, RX__ANA_OVRDEN2__OVRD_EN_ANA_RX_ANA_VGA_GAIN_I, 0x1 );
  SET_FIELD( g_reg_val, RX__ANA_OVRDEN2__OVRD_EN_ANA_RX_ANA_VGA_GAIN_REPLICA_I, 0x1 );
  WRITE_REG( g_rx_base_addr, RX__ANA_OVRDEN2__ADDR, g_reg_val );


  v_vga_dac_sel = 1<<gVgaCoarseCode[a_lane_no] ; 
  WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL6__ANA_RX_POWER_I_15_0, ((v_vga_dac_sel>>4)& 0xFFFF)) ; 

  g_reg_val = READ_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0) ; 
  g_reg_val = (g_reg_val & 0xFFF) | ((v_vga_dac_sel & 0xF)<<12) ; 
  WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0, g_reg_val) ; 

  WRITE_REG_FIELD( g_rx_base_addr, RX__ANA_OVRDEN1__OVRD_EN_ANA_RX_ANA_CLK_TEST_I, 0x1 );
  WRITE_REG_FIELD( g_rx_base_addr, RX__ANA_OVRDEN4__OVRD_EN_ANA_RX_POWER_I_15_0, 0xFFFF ); 

  vRxAnaSpareVal = READ_REG( g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR );
  vRxAnaSpareVal = vRxAnaSpareVal & 0xFFFFFFFE ;        
  WRITE_REG( g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpareVal );

  vRxAnaSpare = READ_REG( g_rx_base_addr, RX__ANA_OVRDEN5__OVRD_EN_ANA_RX_ANA_SPARE_I_31_0__ADDR );
  vRxAnaSpare= vRxAnaSpare   | 
    (0x3  << 23)  | 
    (0x1  << 22)  | 
    (0xFF << 14)  | 
    (0x1) ;

  WRITE_REG( g_rx_base_addr, RX__ANA_OVRDEN5__OVRD_EN_ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare );

  g_prev_vga_status30[a_lane_no] = READ_REG_FIELD (g_rx_base_addr,  RX__STATUS30__RX_ANA_VGA_GAIN_4_0); 

  gIsFirstVgaContAdaptn[a_lane_no] = 0;
}

void run_vga_fine_adapt (uint8_t a_lane_no) {

  rx_t *vp_rx = &g_rx[a_lane_no];
  uint8_t v_curr_adc_vref_sel;

  g_curr_vga_status30[a_lane_no] = READ_REG_FIELD (g_rx_base_addr,  RX__STATUS30__RX_ANA_VGA_GAIN_4_0) ;

  if ((g_prev_vga_status30[a_lane_no] < g_curr_vga_status30[a_lane_no]) || (g_curr_vga_status30[a_lane_no] == gPmdConfigBlock.m_vga_status30_max)) {

    if ((gVgaFineCode[a_lane_no] + gVgaFineStep[a_lane_no]) > 255) {
      inlinefunc_updateVgaRollOver (a_lane_no,1) ;
    } else if (gVgaCoarseCode[a_lane_no] >= vp_rx->m_rx_vga_cca_coarse_max) {
      g_flag_adc_vref_adapt[a_lane_no] = 1; 
    } else {
      if (gVgaCoarseCode[a_lane_no] <= vp_rx->m_rx_vga_cca_coarse_min) {
        v_curr_adc_vref_sel = READ_REG_FIELD (g_rx_base_addr,  RX__ANA_OVRDVAL3__ANA_RX_ANA_ADC_VREF_SEL_I_5_0) ;

        if (v_curr_adc_vref_sel == gRxLaneConfigBlock[a_lane_no].m_default_adc_vref_sel) {  
          inlinefunc_updateVgaFine (a_lane_no,gVgaFineStep[a_lane_no],1) ;
        } else {
          g_flag_adc_vref_adapt[a_lane_no] = 1; 
        }
      } else {
        inlinefunc_updateVgaFine (a_lane_no,gVgaFineStep[a_lane_no],1) ;
      }
    }
  }
  else if ((g_prev_vga_status30[a_lane_no] > g_curr_vga_status30[a_lane_no]) || (g_curr_vga_status30[a_lane_no] == gPmdConfigBlock.m_vga_status30_min)) {

    if ((gVgaFineCode[a_lane_no] == 0) && (gVgaCoarseCode[a_lane_no] <= vp_rx->m_rx_vga_cca_coarse_min)) {
      g_flag_adc_vref_adapt[a_lane_no] = 1; 
    } else if (gVgaFineCode[a_lane_no] < gVgaFineStep[a_lane_no]) {
      if (gVgaCoarseCode[a_lane_no] >= vp_rx->m_rx_vga_cca_coarse_max) {
        v_curr_adc_vref_sel = READ_REG_FIELD (g_rx_base_addr,  RX__ANA_OVRDVAL3__ANA_RX_ANA_ADC_VREF_SEL_I_5_0) ;

        if (v_curr_adc_vref_sel == gRxLaneConfigBlock[a_lane_no].m_default_adc_vref_sel) {
          inlinefunc_updateVgaRollOver (a_lane_no,0) ;
        } else {
          g_flag_adc_vref_adapt[a_lane_no] = 1;
        }
      } else {
        inlinefunc_updateVgaRollOver (a_lane_no,0) ;
      }
    } else {
      inlinefunc_updateVgaFine (a_lane_no,gVgaFineStep[a_lane_no],0) ;
    }
  }

  g_prev_vga_status30[a_lane_no] = g_curr_vga_status30[a_lane_no];
 
}


void inlinefunc_updateVgaRollOver (uint8_t a_lane_no, uint8_t aDir) {

  rx_t *vp_rx = &g_rx[a_lane_no];

  uint8_t vInitFineCode = 0 ;
  vInitFineCode = gVgaFineCode[a_lane_no] ;  

  if (aDir == 0) { 
    inlinefunc_updateVgaFine (a_lane_no, gVgaFineCode[a_lane_no], 0) ; 
    inlinefunc_updateVgaCoarse (a_lane_no, 0) ; 
    if ((gVgaCoarseCode[a_lane_no] >= vp_rx->m_rx_vga_cca_coarse_min) && (gVgaFineCode[a_lane_no] > 0)) {
      inlinefunc_updateVgaFine (a_lane_no, (gVgaFineStep[a_lane_no]-vInitFineCode-1), 0) ;
    }
  } else { 
    inlinefunc_updateVgaFine (a_lane_no, (255-gVgaFineCode[a_lane_no]),1) ;
    inlinefunc_updateVgaCoarse (a_lane_no, 1) ;
    if (gVgaCoarseCode[a_lane_no] < vp_rx->m_rx_vga_cca_coarse_max) {
      inlinefunc_updateVgaFine (a_lane_no, (vInitFineCode+gVgaFineStep[a_lane_no]-256), 1) ;
    }

  }
}

void inlinefunc_updateVgaFine (uint8_t a_lane_no, uint8_t aFineStep, uint8_t aDir) { 
  uint32_t vRxAnaSpare ; 
  if (aFineStep>0) {
    g_reg_val = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 
    g_reg_val = ((g_reg_val & ~(0x3 << 23)) | (0x1 << 23)); 
    vRxAnaSpare = g_reg_val ; 
    WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, g_reg_val) ; 

    for (uint8_t i=0; i<aFineStep; i++) {
      
      gVgaFineCode [a_lane_no] = (aDir == 0) ? (gVgaFineCode [a_lane_no] - 1) : (gVgaFineCode [a_lane_no] + 1)  ; 
      
      vRxAnaSpare = vRxAnaSpare & (~(0xFF<<14)) ; 
      vRxAnaSpare = vRxAnaSpare | (gVgaFineCode[a_lane_no] << 14);
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 

      vRxAnaSpare = vRxAnaSpare | (1<<22) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 

      vRxAnaSpare = vRxAnaSpare & (~(1<<22)) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 
    }
  }
}

void inlinefunc_updateVgaCoarse (uint8_t a_lane_no, uint8_t aDir) {

  rx_t *vp_rx = &g_rx[a_lane_no];

  uint32_t vVgaCoarseCodeTherm ; 
  uint32_t vVgaDacSel ; 
  uint32_t vRxAnaSpare ; 
  uint32_t vRxAnaClkTest ;

  if (aDir == 0) {  
    if (gVgaCoarseCode[a_lane_no] > vp_rx->m_rx_vga_cca_coarse_min) {

      vRxAnaSpare = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 
      vRxAnaSpare = ((vRxAnaSpare & ~(0x3 << 23)) | (0x1 << 23)); 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 

      gVgaCoarseCode[a_lane_no] = gVgaCoarseCode[a_lane_no] - 1 ; 

      WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL6__ANA_RX_POWER_I_15_0, 0x0) ; 
      vRxAnaClkTest = READ_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0) ; 
      vRxAnaClkTest = vRxAnaClkTest & 0xFFF ; 
      WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0, vRxAnaClkTest) ; 

      vRxAnaSpare = vRxAnaSpare | (0xFF<<14) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ;
      gVgaFineCode[a_lane_no] = 255 ;

      vRxAnaSpare = vRxAnaSpare | (1<<22) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 
      vRxAnaSpare = vRxAnaSpare & (~(1<<22)) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 

      vVgaDacSel = 1<<gVgaCoarseCode[a_lane_no] ; 
      WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL6__ANA_RX_POWER_I_15_0, ((vVgaDacSel>>4)& 0xFFFF)) ; 
      vRxAnaClkTest = vRxAnaClkTest | ((vVgaDacSel & 0xF)<<12) ; 
      WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0, vRxAnaClkTest) ; 

      vVgaCoarseCodeTherm = dec2therm (gVgaCoarseCode[a_lane_no]) ; 
      WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL14__ANA_RX_ANA_VGA_GAIN_I_19_0, vVgaCoarseCodeTherm) ;
    }
  } else if (aDir == 1) { 
    if (gVgaCoarseCode[a_lane_no] < vp_rx->m_rx_vga_cca_coarse_max) {

      vRxAnaSpare = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 
      vRxAnaSpare = ((vRxAnaSpare & ~(0x3 << 23)) | (0x1 << 23)); 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 

      gVgaCoarseCode[a_lane_no] = gVgaCoarseCode[a_lane_no] + 1 ; 
      vVgaCoarseCodeTherm = dec2therm (gVgaCoarseCode[a_lane_no]) ; 
      WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL14__ANA_RX_ANA_VGA_GAIN_I_19_0, vVgaCoarseCodeTherm) ;

      WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL6__ANA_RX_POWER_I_15_0, 0x0) ; 
      vRxAnaClkTest = READ_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0) ; 
      vRxAnaClkTest = vRxAnaClkTest & 0xFFF ; 
      WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0, vRxAnaClkTest) ; 

      vRxAnaSpare = vRxAnaSpare & (~(0xFF<<14)) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ;
      gVgaFineCode[a_lane_no] = 0 ;

      vRxAnaSpare = vRxAnaSpare | (1<<22) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 
      vRxAnaSpare = vRxAnaSpare & (~(1<<22)) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 

      if (gVgaCoarseCode[a_lane_no] < vp_rx->m_rx_vga_cca_coarse_max) {
        vVgaDacSel = 1<<gVgaCoarseCode[a_lane_no] ; 
        WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL6__ANA_RX_POWER_I_15_0, ((vVgaDacSel>>4)& 0xFFFF)) ; 
        vRxAnaClkTest = vRxAnaClkTest | ((vVgaDacSel & 0xF)<<12) ; 
        WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0, vRxAnaClkTest) ; 
      }
    }
  }
}









void ctle_fine_adapt_config (uint8_t a_lane_no) {

  uint32_t vRxAnaSpare = 0 ;
  uint32_t vRxAnaSpareVal = 0;
  uint8_t v_ctle_rz_therm_coarse, v_ctle_rz_dac_sel;
  uint8_t v_ctle_deq_therm_coarse, v_ctle_deq_dac_sel;
 

  CTLE_STATUS30_MAX = READ_REG_FIELD (g_rx_base_addr, RX__BOOST_LUT59__RX_ANA_CTLE_CZ_LUT_63_3_0);


  if (gRxLaneConfigBlock[a_lane_no].m_afe_fine_adapt_run_dsp) {
    if(gRxXFwDoFtffe[a_lane_no] == 0) {
      WRITE_REG_FIELD (g_rx_base_addr, RX__MODE_CTL13__ADPT_CDR_EN_13_11_0, 0x1AF) ;     
    } else {
      WRITE_REG_FIELD (g_rx_base_addr, RX__MODE_CTL13__ADPT_CDR_EN_13_11_0, 0x5AF) ;     
    }
  } else {
    WRITE_REG_FIELD (g_rx_base_addr, RX__MODE_CTL13__ADPT_CDR_EN_13_11_0, 0x1A1) ;
  }
  
  WRITE_REG_FIELD (g_rx_base_addr, RX__MODE_CTL13__N_TOP_13_10_0, 64);


  vRxAnaSpareVal = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ;
  vRxAnaSpareVal = vRxAnaSpareVal & 0xFFFFFFFE ;        
  WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpareVal);

  vRxAnaSpare = READ_REG (g_rx_base_addr, RX__ANA_OVRDEN5__OVRD_EN_ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 

  vRxAnaSpare = vRxAnaSpare   |
    (0x1  << 31)  | 
    (0x7  << 25)  | 
    (0x3  << 23)  | 
    (0x1  << 22)  | 
    (0xFF << 14)  | 
    (0x1  << 13)  | 
    (0x7  << 10)  | 
    (0x1) ;

  WRITE_REG (g_rx_base_addr, RX__ANA_OVRDEN5__OVRD_EN_ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ;

  g_reg_val = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL6__ANA_RX_ANA_CTLE_CZ_I_14_0__ADDR) ;
  WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL6__ANA_RX_ANA_CTLE_CZ_I_14_0__ADDR, g_reg_val) ; 

  g_reg_val = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL7__ANA_RX_ANA_CTLE_CZ_REPLICA_I_3_0__ADDR) ;    
  WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL7__ANA_RX_ANA_CTLE_CZ_REPLICA_I_3_0__ADDR, g_reg_val) ; 

  g_reg_val = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL8__ADDR) ;
  v_ctle_rz_therm_coarse = GET_FIELD( g_reg_val, RX__ANA_OVRDVAL8__ANA_RX_ANA_CTLE_RZ_I_1_0 ); 
  WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL8__ADDR, g_reg_val) ; 

  v_ctle_rz_therm_coarse = (v_ctle_rz_therm_coarse << 1) | ((vRxAnaSpareVal & 0x2000) >> 13);
  gCtleRzCoarseCode[a_lane_no] = (uint8_t)(therm2dec(v_ctle_rz_therm_coarse));

  v_ctle_rz_dac_sel = (1 << gCtleRzCoarseCode[a_lane_no]) & 0x7;   
  vRxAnaSpare = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 
  vRxAnaSpare = (vRxAnaSpare & (~(7<<10))) | (v_ctle_rz_dac_sel<<10)  ; 
  WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ;

  g_reg_val = READ_REG (g_rx_base_addr, RX__ANA_OVRDEN1__ADDR) ; 
  SET_FIELD (g_reg_val, RX__ANA_OVRDEN1__OVRD_EN_ANA_RX_ANA_CTLE_CZ_I, 0x1) ; 
  SET_FIELD (g_reg_val, RX__ANA_OVRDEN1__OVRD_EN_ANA_RX_ANA_CTLE_CZ_REPLICA_I, 0x1) ;
  SET_FIELD (g_reg_val, RX__ANA_OVRDEN1__OVRD_EN_ANA_RX_ANA_CTLE_RZ_I, 0x1) ;
  SET_FIELD (g_reg_val, RX__ANA_OVRDEN1__OVRD_EN_ANA_RX_ANA_MFEQ_CZ_I, 0x1) ;
  WRITE_REG (g_rx_base_addr, RX__ANA_OVRDEN1__ADDR, g_reg_val) ;

  WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDEN2__OVRD_EN_ANA_RX_ANA_MFEQ_RZ_I, 0x1) ;

  g_reg_val = READ_REG ( g_rx_base_addr, RX__ANA_OVRDVAL12__ANA_RX_ANA_TEST_AFE_I_31_0__ADDR );
  WRITE_REG ( g_rx_base_addr, RX__ANA_OVRDVAL12__ANA_RX_ANA_TEST_AFE_I_31_0__ADDR, g_reg_val );
  v_ctle_deq_therm_coarse = ((g_reg_val & (1 << 29)) >> 29); 
  g_reg_val = READ_REG ( g_rx_base_addr, RX__ANA_OVRDVAL13__ANA_RX_ANA_TEST_AFE_I_43_32__ADDR );
  WRITE_REG ( g_rx_base_addr, RX__ANA_OVRDVAL13__ANA_RX_ANA_TEST_AFE_I_43_32__ADDR, g_reg_val );  

  v_ctle_deq_therm_coarse = (((g_reg_val & (1 << 5)) >> 5) << 1) | (v_ctle_deq_therm_coarse) ; 
  gCtleDeqCoarseCode[a_lane_no] = (uint8_t)(therm2dec(v_ctle_deq_therm_coarse));

  v_ctle_deq_dac_sel = (1 << gCtleDeqCoarseCode[a_lane_no]) & 0x3; 
  g_reg_val = READ_REG_FIELD( g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0 );
  g_reg_val = (g_reg_val & (~(0x3 << 10))) | (v_ctle_deq_dac_sel << 10);
  WRITE_REG_FIELD( g_rx_base_addr, RX__ANA_OVRDVAL5__ANA_RX_ANA_CLK_TEST_I_15_0, g_reg_val);
  WRITE_REG_FIELD( g_rx_base_addr, RX__ANA_OVRDEN1__OVRD_EN_ANA_RX_ANA_CLK_TEST_I, 0x1 );

  g_reg_val = READ_REG ( g_rx_base_addr, RX__ANA_OVRDEN6__OVRD_EN_ANA_RX_ANA_TEST_AFE_I_31_0__ADDR );
  g_reg_val = g_reg_val | (1 << 29); 
  WRITE_REG ( g_rx_base_addr, RX__ANA_OVRDEN6__OVRD_EN_ANA_RX_ANA_TEST_AFE_I_31_0__ADDR, g_reg_val );

  g_reg_val = READ_REG ( g_rx_base_addr, RX__ANA_OVRDEN7__OVRD_EN_ANA_RX_ANA_TEST_AFE_I_43_32__ADDR );
  g_reg_val = g_reg_val | (1 << 5); 
  WRITE_REG ( g_rx_base_addr, RX__ANA_OVRDEN7__OVRD_EN_ANA_RX_ANA_TEST_AFE_I_43_32__ADDR, g_reg_val );


  gRxLaneConfigBlock[a_lane_no].m_rx_cca_ctle_rz_coarse_code = gCtleRzCoarseCode[a_lane_no];
  gRxLaneConfigBlock[a_lane_no].m_rx_cca_ctle_deq_coarse_code = gCtleDeqCoarseCode[a_lane_no];

  gCtleRzFineCode[a_lane_no] = 0 ;
  gCtleDeqFineCode[a_lane_no] = 0 ;
  gRxLaneConfigBlock[a_lane_no].m_rx_cca_ctle_rz_fine_code = gCtleRzFineCode[a_lane_no];
  gRxLaneConfigBlock[a_lane_no].m_rx_cca_ctle_deq_fine_code = gCtleDeqFineCode[a_lane_no];

  g_prev_ctle_status30[a_lane_no] = READ_REG_FIELD (g_rx_base_addr, RX__STATUS30__RX_ANA_HFEQ_BST_5_0) ;

  gIsFirstCtleContAdaptn[a_lane_no] = 0;
}


void run_ctle_fine_adapt (uint8_t a_lane_no) {

  rx_t *vp_rx = &g_rx[a_lane_no];

  uint16_t v_ctle_rz_abs_val, v_ctle_rz_min, v_ctle_rz_max;

  v_ctle_rz_abs_val = (gCtleRzCoarseCode[a_lane_no] * 256 + gCtleRzFineCode[a_lane_no]);
  v_ctle_rz_min = (gPmdConfigBlock.m_ctle_rz_coarse_min * 256 + gPmdConfigBlock.m_ctle_rz_fine_min);
  v_ctle_rz_max = (gPmdConfigBlock.m_ctle_rz_coarse_max * 256 + gPmdConfigBlock.m_ctle_rz_fine_max);

  vp_rx->m_rx_ctle_cca_rz_railed_min = (v_ctle_rz_abs_val - gCtleRzFineStep[a_lane_no] >= v_ctle_rz_min) ? false : true;
  vp_rx->m_rx_ctle_cca_rz_railed_max = (v_ctle_rz_abs_val + gCtleRzFineStep[a_lane_no] <= v_ctle_rz_max) ? false : true;


  uint16_t v_ctle_deq_abs_val, v_ctle_deq_min, v_ctle_deq_max;

  v_ctle_deq_abs_val = (gCtleDeqCoarseCode[a_lane_no] * 256 + gCtleDeqFineCode[a_lane_no]);
  v_ctle_deq_min = (gRxLaneConfigBlock[a_lane_no].m_ctle_deq_coarse_min * 256 + gRxLaneConfigBlock[a_lane_no].m_ctle_deq_fine_min);
  v_ctle_deq_max = (gRxLaneConfigBlock[a_lane_no].m_ctle_deq_coarse_max * 256 + gRxLaneConfigBlock[a_lane_no].m_ctle_deq_fine_max);

  vp_rx->m_rx_ctle_cca_deq_railed_min = (v_ctle_deq_abs_val - gCtleDeqFineStep[a_lane_no] >= v_ctle_deq_min) ? false : true;
  vp_rx->m_rx_ctle_cca_deq_railed_max = (v_ctle_deq_abs_val + gCtleDeqFineStep[a_lane_no] <= v_ctle_deq_max) ? false : true;


  g_curr_ctle_status30[a_lane_no] = READ_REG_FIELD (g_rx_base_addr, RX__STATUS30__RX_ANA_HFEQ_BST_5_0) ;

  if (g_curr_ctle_status30[a_lane_no] > g_prev_ctle_status30[a_lane_no]) { 
    vp_rx->m_rx_ctle_cca_inc_bst = true;
    vp_rx->m_rx_ctle_cca_dec_bst = false;
  } else if (g_curr_ctle_status30[a_lane_no] == CTLE_STATUS30_MAX) { 
    vp_rx->m_rx_bst_rail_cnt = vp_rx->m_rx_bst_rail_cnt + 1;
    vp_rx->m_rx_ctle_cca_inc_bst = (vp_rx->m_rx_bst_rail_cnt >= gRxLaneConfigBlock[a_lane_no].m_rx_ctle_cca_inc_bst_rail_dither) ? true : false;
    vp_rx->m_rx_ctle_cca_dec_bst = false;
  } else if (g_curr_ctle_status30[a_lane_no] < g_prev_ctle_status30[a_lane_no]) { 
    vp_rx->m_rx_ctle_cca_dec_bst = true;
    vp_rx->m_rx_ctle_cca_inc_bst = false;
  } else if (g_curr_ctle_status30[a_lane_no] == gPmdConfigBlock.m_ctle_status30_min) { 
    vp_rx->m_rx_bst_rail_cnt = vp_rx->m_rx_bst_rail_cnt + 1;
    vp_rx->m_rx_ctle_cca_dec_bst = (vp_rx->m_rx_bst_rail_cnt >= gRxLaneConfigBlock[a_lane_no].m_rx_ctle_cca_dec_bst_rail_dither) ? true : false;
    vp_rx->m_rx_ctle_cca_inc_bst = false;
  } else {
    vp_rx->m_rx_ctle_cca_inc_bst = false;
    vp_rx->m_rx_ctle_cca_dec_bst = false;
  }

  if (vp_rx->m_rx_ctle_cca_inc_bst == true) { 
    vp_rx->m_rx_bst_rail_cnt = 0;

    if ((vp_rx->m_rx_ctle_cca_deq_railed_min == false) && (vp_rx->m_rx_afecca_skip_ctle_deq_update == false)) { 
      vp_rx->m_rx_afe_ctle_cca_sel = e_rx_afe_ctle_deq_cca;

      rx__set_ctle_cca_control_vars(a_lane_no, vp_rx->m_rx_afe_ctle_cca_sel);
 
      if (gCtleFineCode[a_lane_no] < gCtleFineStep[a_lane_no] ) { 
        inlinefunc_updateCtleRollOver (a_lane_no, 0) ;

      } else { 
        inlinefunc_updateCtleFine (a_lane_no, gCtleFineStep[a_lane_no], 0);
      }
    }

    if ((vp_rx->m_rx_ctle_cca_rz_railed_min == false) && (!gRxLaneConfigBlock[a_lane_no].m_rx_afecca_skip_ctle_rz_update)) { 
      vp_rx->m_rx_afe_ctle_cca_sel = e_rx_afe_ctle_rz_cca;

      rx__set_ctle_cca_control_vars(a_lane_no, vp_rx->m_rx_afe_ctle_cca_sel);
 
      if (gCtleFineCode[a_lane_no] < gCtleFineStep[a_lane_no] ) { 
        inlinefunc_updateCtleRollOver (a_lane_no, 0) ;

      } else { 
        inlinefunc_updateCtleFine (a_lane_no, gCtleFineStep[a_lane_no], 0);
      }
    }

  } else if (vp_rx->m_rx_ctle_cca_dec_bst == true) { 

    vp_rx->m_rx_bst_rail_cnt = 0;

    if ((vp_rx->m_rx_ctle_cca_deq_railed_max == false) && (vp_rx->m_rx_afecca_skip_ctle_deq_update == false)) { 
      vp_rx->m_rx_afe_ctle_cca_sel = e_rx_afe_ctle_deq_cca;

      rx__set_ctle_cca_control_vars(a_lane_no, vp_rx->m_rx_afe_ctle_cca_sel);

      if ((gCtleFineCode[a_lane_no] + gCtleFineStep[a_lane_no]) > 255) { 
        inlinefunc_updateCtleRollOver (a_lane_no, 1) ;
      } else { 
        inlinefunc_updateCtleFine (a_lane_no, gCtleFineStep[a_lane_no], 1);
      }
    }

    if ((vp_rx->m_rx_ctle_cca_rz_railed_max == false) && (!gRxLaneConfigBlock[a_lane_no].m_rx_afecca_skip_ctle_rz_update)) {
      vp_rx->m_rx_afe_ctle_cca_sel = e_rx_afe_ctle_rz_cca;

      rx__set_ctle_cca_control_vars(a_lane_no, vp_rx->m_rx_afe_ctle_cca_sel);

      if ((gCtleFineCode[a_lane_no] + gCtleFineStep[a_lane_no]) > 255) { 
        inlinefunc_updateCtleRollOver (a_lane_no, 1) ;
      } else { 
        inlinefunc_updateCtleFine (a_lane_no, gCtleFineStep[a_lane_no], 1);
      }
    } 
  }

  g_prev_ctle_status30[a_lane_no] = g_curr_ctle_status30[a_lane_no];
}

void rx__set_ctle_cca_control_vars(uint8_t a_lane_no, rx_afe_ctle_cca_sel_t a_rx_afe_ctle_cca_sel) {

  if (a_rx_afe_ctle_cca_sel == e_rx_afe_ctle_rz_cca) { 
    gCtleFineCode[a_lane_no] = gCtleRzFineCode[a_lane_no];
    gCtleFineStep[a_lane_no] = gCtleRzFineStep[a_lane_no];
  } else { 
    gCtleFineCode[a_lane_no] = gCtleDeqFineCode[a_lane_no];
    gCtleFineStep[a_lane_no] = gCtleDeqFineStep[a_lane_no];
  }
}

void inlinefunc_updateCtleRollOver (uint8_t a_lane_no, uint8_t aDir) {

  rx_t *vp_rx = &g_rx[a_lane_no];

  uint8_t v_ctle_coarse_min, v_ctle_coarse_max;

  if (vp_rx->m_rx_afe_ctle_cca_sel == e_rx_afe_ctle_rz_cca) { 
    gCtleCoarseCode[a_lane_no] = gCtleRzCoarseCode[a_lane_no];
    gCtleFineCode[a_lane_no] = gCtleRzFineCode[a_lane_no];
    gCtleFineStep[a_lane_no] = gCtleRzFineStep[a_lane_no];
    v_ctle_coarse_min = gPmdConfigBlock.m_ctle_rz_coarse_min;
    v_ctle_coarse_max = gPmdConfigBlock.m_ctle_rz_coarse_max;
  } else { 
    gCtleCoarseCode[a_lane_no] = gCtleDeqCoarseCode[a_lane_no];
    gCtleFineCode[a_lane_no] = gCtleDeqFineCode[a_lane_no];
    gCtleFineStep[a_lane_no] = gCtleDeqFineStep[a_lane_no];
    v_ctle_coarse_min = gRxLaneConfigBlock[a_lane_no].m_ctle_deq_coarse_min;
    v_ctle_coarse_max = gRxLaneConfigBlock[a_lane_no].m_ctle_deq_coarse_max;
  }

  if (aDir == 0) { 
    inlinefunc_updateCtleFine (a_lane_no, gCtleFineCode[a_lane_no], 0) ; 
    inlinefunc_updateCtleCoarse (a_lane_no, 0) ; 
    if ((gCtleCoarseCode[a_lane_no] >= v_ctle_coarse_min) && (gCtleFineCode[a_lane_no] > 0)) {
      inlinefunc_updateCtleFine (a_lane_no, (gCtleFineStep[a_lane_no] - gCtleFineCode[a_lane_no] - 1), 0) ;
    }
  } else { 
    inlinefunc_updateCtleFine (a_lane_no, (255-gCtleFineCode[a_lane_no]),1) ;
    inlinefunc_updateCtleCoarse (a_lane_no, 1) ;
    if (gCtleCoarseCode[a_lane_no] < v_ctle_coarse_max) {
      inlinefunc_updateCtleFine (a_lane_no, (gCtleFineCode[a_lane_no] + gCtleFineStep[a_lane_no] - 256), 1) ;
    }
  }
}

void inlinefunc_updateCtleFine (uint8_t a_lane_no, uint8_t aFineStep, uint8_t aDir) { 

  rx_t *vp_rx = &g_rx[a_lane_no];

  uint32_t vRxAnaSpare; 

  if (aFineStep>0) {
    g_reg_val = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 
    g_reg_val = (vp_rx->m_rx_afe_ctle_cca_sel == e_rx_afe_ctle_rz_cca) ? (g_reg_val & ~(0x3 << 23)) : ((g_reg_val & ~(0x3 << 23)) | (0x2 << 23)); 
    vRxAnaSpare = g_reg_val ; 
    WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, g_reg_val) ; 
  }

  for (uint8_t i=0; i<aFineStep; i++) {
    
    if (vp_rx->m_rx_afe_ctle_cca_sel == e_rx_afe_ctle_rz_cca) { 
      gCtleRzFineCode [a_lane_no] = (aDir == 0) ? (gCtleRzFineCode [a_lane_no] - 1) : (gCtleRzFineCode [a_lane_no] + 1)  ;
      gCtleFineCode[a_lane_no] = gCtleRzFineCode[a_lane_no];
    } else { 
      gCtleDeqFineCode [a_lane_no] = (aDir == 0) ? (gCtleDeqFineCode [a_lane_no] - 1) : (gCtleDeqFineCode [a_lane_no] + 1)  ;
      gCtleFineCode[a_lane_no] = gCtleDeqFineCode[a_lane_no];
    }
    vRxAnaSpare = vRxAnaSpare & (~(0xFF<<14)) ; 
    vRxAnaSpare = vRxAnaSpare | (gCtleFineCode[a_lane_no] << 14);
    WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 

    vRxAnaSpare = vRxAnaSpare | (1<<22) ; 
    WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 
    WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 

    vRxAnaSpare = vRxAnaSpare & (~(1<<22)) ; 
    WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 
  }
}

void inlinefunc_updateCtleCoarse (uint8_t a_lane_no, uint8_t aDir) {

  rx_t *vp_rx = &g_rx[a_lane_no];

  if(vp_rx->m_rx_afe_ctle_cca_sel == e_rx_afe_ctle_deq_cca) { 
    rx__update_ctle_deq_coarse (a_lane_no, aDir);
  }
 
  if(vp_rx->m_rx_afe_ctle_cca_sel == e_rx_afe_ctle_rz_cca) { 
    rx__update_ctle_rz_coarse (a_lane_no, aDir);
  }
}

void rx__update_ctle_rz_coarse (uint8_t a_lane_no, uint8_t aDir) {

  rx_t *vp_rx = &g_rx[a_lane_no];

  uint32_t  vCtleRzCoarseCodeTherm;
  uint8_t   vCtleRzCoarseCodeTherm_0, vCtleRzCoarseCodeTherm_2_1;
  uint32_t  vCtleDacSel; 
  uint32_t  vRxAnaSpare; 

  if (aDir == 0) {  
    if (gCtleRzCoarseCode[a_lane_no] > gPmdConfigBlock.m_ctle_rz_coarse_min) {
      
      gCtleRzCoarseCode[a_lane_no] = gCtleRzCoarseCode[a_lane_no] - 1 ; 

      vRxAnaSpare = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 
      vRxAnaSpare = (vRxAnaSpare & ~(7<<10)) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ;

      vRxAnaSpare = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 
      vRxAnaSpare = (vp_rx->m_rx_afe_ctle_cca_sel == e_rx_afe_ctle_rz_cca) ? (vRxAnaSpare & ~(0x3 << 23)) : ((vRxAnaSpare & ~(0x3 << 23)) | (0x2 << 23)); 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ;        

      vRxAnaSpare = vRxAnaSpare | (0xFF<<14) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ;
      gCtleRzFineCode[a_lane_no] = 255 ;

      vRxAnaSpare = vRxAnaSpare | (1<<22) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 
      vRxAnaSpare = vRxAnaSpare & (~(1<<22)) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 

      vCtleDacSel = 1<<gCtleRzCoarseCode[a_lane_no] ; 
      vRxAnaSpare = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 
      vRxAnaSpare = vRxAnaSpare | ((vCtleDacSel & 0x7) <<10) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ; 

      vCtleRzCoarseCodeTherm = dec2therm (gCtleRzCoarseCode[a_lane_no]) ;
      vCtleRzCoarseCodeTherm_0 = vCtleRzCoarseCodeTherm & 1 ;
      vCtleRzCoarseCodeTherm_2_1 = ((vCtleRzCoarseCodeTherm >> 1) & 0x3) ;

      g_reg_val = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 
      g_reg_val = g_reg_val & (~(1<<13)) ;
      g_reg_val = g_reg_val | (vCtleRzCoarseCodeTherm_0 << 13) ;
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, g_reg_val) ;

      WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL8__ANA_RX_ANA_CTLE_RZ_I_1_0, vCtleRzCoarseCodeTherm_2_1) ;
    }

  } else if (aDir == 1) {   
    if (gCtleRzCoarseCode[a_lane_no] < gPmdConfigBlock.m_ctle_rz_coarse_max) {

      gCtleRzCoarseCode[a_lane_no] = gCtleRzCoarseCode[a_lane_no] + 1 ;

      vCtleRzCoarseCodeTherm = dec2therm (gCtleRzCoarseCode[a_lane_no]) ;
      vCtleRzCoarseCodeTherm_0 = vCtleRzCoarseCodeTherm & 1 ;
      vCtleRzCoarseCodeTherm_2_1 = ((vCtleRzCoarseCodeTherm >> 1) & 0x3) ;

      g_reg_val = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 
      g_reg_val = g_reg_val & (~(1<<13)) ;
      g_reg_val = g_reg_val | (vCtleRzCoarseCodeTherm_0 << 13) ;
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, g_reg_val) ;

      WRITE_REG_FIELD (g_rx_base_addr, RX__ANA_OVRDVAL8__ANA_RX_ANA_CTLE_RZ_I_1_0, vCtleRzCoarseCodeTherm_2_1) ;

      vRxAnaSpare = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 
      vRxAnaSpare = (vRxAnaSpare & ~(7<<10)) ; 
      WRITE_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR, vRxAnaSpare) ;

      vRxAnaSpare = READ_REG (g_rx_base_addr, RX__ANA_OVRDVAL11__ANA_RX_ANA_SPARE_I_31_0__ADDR) ; 
