#include "fw.h"



void func_sch_decode_mb_req (void) {
  uint8_t cmd_rsp = 0; 
  uint8_t mb_req  = 0; 
 
  g_reg_val = READ_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX0__ADDR);
  mb_req = GET_FIELD (g_reg_val, PMD__FW_MAILBOX0__MB_REQ);

  if (mb_req == 1) {
    g_reg_val = GET_FIELD (g_reg_val, PMD__FW_MAILBOX0__CMD_7_0);
 
    if (g_reg_val < NUM_MB_CMD) {
      if (g_reg_val == 0x1) {         
        cmd_rsp = general_debug_mb_cmd_decode_func_array[0] ();
      
      } else if (g_reg_val == 0xE) { 
        cmd_rsp = general_debug_mb_cmd_decode_func_array[1] ();
      } else if (g_reg_val == 0xF) { 
        cmd_rsp = general_debug_mb_cmd_decode_func_array[2] ();
      
      }
    } else {
      cmd_rsp = 0x2;  
    }

    g_reg_val = READ_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX0__ADDR);
    SET_FIELD (g_reg_val, PMD__FW_MAILBOX0__CMD_7_0, cmd_rsp);
    SET_FIELD (g_reg_val, PMD__FW_MAILBOX0__MB_REQ, 0x0);
    WRITE_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX0__ADDR, g_reg_val);
 
  } else {}
}




