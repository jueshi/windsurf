void rx_handler_req_decode (uint8_t fsm_no) {
  bool    vFwReq;
  
  g_reg_val = READ_REG (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR10__ADDR);
  vFwReq  = GET_FIELD (g_reg_val, PMD_LANE_RX__RX_FW_CSR10__RX_FW_REQ);

  if (vFwReq) {
    
    g_reg_val = GET_FIELD(g_reg_val, PMD_LANE_RX__RX_FW_CSR10__RX_FW_REQ_TYPE_2_0);

    if (g_reg_val == 0) {
      
      g_reg_val = READ_REG(g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR0__ADDR);
      handler_func_pntr[fsm_no] = GET_FIELD (g_reg_val, PMD_LANE_RX__RX_FW_CSR0__RX_FW_PWRCMD_5_0);
      handler_cmd_arg[fsm_no]   = GET_FIELD (g_reg_val, PMD_LANE_RX__RX_FW_CSR0__RX_FW_PWRCMD_ARG_2_0);

    } else {
      
      handler_func_pntr[fsm_no] = (NUM_FW_PWR_CMDS - 1) + g_reg_val;
    }

    handshake_fsm_st[fsm_no] = e_pmd_handler_req_st;
  }

}


void rx_handler_ack_gen (uint8_t fsm_no) {
  uint8_t v_lane_no = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;
  rx_t *vp_rx = &g_rx[v_lane_no];

  uint8_t vPollCntr = 0;

  
  WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR10__RX_FW_ACK, 0x1);

  
  do {
    g_reg_val = READ_REG_FIELD(g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR10__RX_FW_REQ);
    vPollCntr++;
  } while ((g_reg_val == 1) && (vPollCntr < 10));

  if ((g_reg_val == 1) && (vPollCntr == 10)) {
    return;
  }

  
  WRITE_REG_FIELD (g_pmd_lane_rx_base_addr, PMD_LANE_RX__RX_FW_CSR10__RX_FW_ACK, 0x0);


  if ((rx_handler_task_array[handler_func_pntr[fsm_no]] == pmd_rx__lane_margining) && (vp_rx->m_rx_ndes_en == true) ) {
    delay_ns(gRxLaneConfigBlock[v_lane_no].m_fw_ack_to_ndes_en_delay_ns);

    g_reg_val = READ_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN0__ADDR );
    SET_FIELD( g_reg_val, PMD_LANE_RX__EYE_SCAN0__NDES_FDF_EN, vp_rx->m_rx_ndes_fdf_en );
    SET_FIELD( g_reg_val, PMD_LANE_RX__EYE_SCAN0__NDES_EN, vp_rx->m_rx_ndes_en );
    WRITE_REG( g_pmd_lane_rx_base_addr, PMD_LANE_RX__EYE_SCAN0__ADDR, g_reg_val );
  }
  handshake_fsm_st[fsm_no] = e_pmd_handler_idle_st;
}


void funcRxTrimRtermConfig (uint8_t fsm_no) {
  
  uint8_t vLaneNo = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;

  if ( gRxLaneConfigBlock[vLaneNo].m_skip_rx_trim_rterm  || ((g_fw_fastsim_en == 1) && (g_fw_ufastsim_0_fastsim_1 == 0)) ) {
    handshake_fsm_st[fsm_no] = e_pmd_handler_idle_st;

  } else {  

    rx__trim_rterm_config (vLaneNo);

    handshake_fsm_st[fsm_no] = e_pmd_handler_idle_st;
  }
}


void func_rx_fwcmd_host_brk_pnt (uint8_t fsm_no) {
  uint8_t vLaneNo = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;
  uint32_t base; uint32_t offset; 
  uint32_t req_val; uint32_t ack_val;

  base = g_pmd_lane_rx_base_addr;

  offset = PMD_LANE_RX__RX_FW_CSR13__ADDR;
  req_val = 0x1;  
  ack_val = 0x2;  

  g_reg_val = READ_REG (base, offset);

  switch (gRxBrkPointState[vLaneNo]) {
    case e_req1_st: 
      WRITE_REG (base, offset, g_reg_val | req_val);            
      gRxBrkPointState[vLaneNo] = e_ack1_poll_req0_st;          
      break;

    case e_ack1_poll_req0_st:
      if ((g_reg_val & ack_val) == ack_val) {                   
        WRITE_REG (base, offset, g_reg_val & (~(req_val)));     
        gRxBrkPointState[vLaneNo] = e_ack0_poll_st;             
      }
      break;

    case e_ack0_poll_st:
      if ((g_reg_val & ack_val) != ack_val) {                  
        gRxBrkPointState[vLaneNo] = e_req1_st;                 
        handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;       
      }
      break;
  }
}


