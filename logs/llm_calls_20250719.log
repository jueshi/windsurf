void func_rx_fwcmd_pcie_fw_rpt_strup (uint8_t fsm_no) {
  handshake_fsm_st [fsm_no] = e_pmd_handler_ack_st ; 
}


void func_rx_fwcmd_lpbk_div7_clk_en (uint8_t fsm_no) {

  uint8_t v_lane_no = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;  

  rx__lpbk_div7_clk_en (v_lane_no, handler_cmd_arg[fsm_no]) ;

  handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
}

void func_rx_fwcmd_pi_input_skew_cal (uint8_t fsm_no) {

  uint8_t v_lane_no           = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;
  bool    v_en_pmix_skew_cal  = false;


  if ((gRateConfigMasterDefaults[g_rx[v_lane_no].m_rx_rate_idx].rx_ana_mmcdr_div_ctrl == 0) && \
      ((g_fw_fastsim_en == 0) || ((g_fw_fastsim_en == 1) && (g_fw_ufastsim_0_fastsim_1 == 1))) ) {

    v_en_pmix_skew_cal = (gRxLaneConfigBlock[v_lane_no].m_en_pi_input_skew_cal == 1);     


    if (v_en_pmix_skew_cal) {
      bool v_done= false;
      rx_t *vp_rx = &g_rx[v_lane_no];
    
      v_done = rx__pmix_iq_skew_cal (v_lane_no);

      if (v_done) {
        gRxLaneConfigBlock[v_lane_no].m_pi_input_skew_cal_sine_warn = vp_rx->m_pmix_iq_skew_cal_sine_warn;

        gRxLaneConfigBlock[v_lane_no].m_pi_skew_cal_adc_data_peak = vp_rx->m_adc_peak; 
        gRxLaneConfigBlock[v_lane_no].m_pi_skew_cal_vga_val = vp_rx->m_vga_val; 
        gRxLaneConfigBlock[v_lane_no].m_pi_skew_cal_vref_sel = vp_rx->m_pmix_skew_cal_vref_sel; 
        gRxLaneConfigBlock[v_lane_no].m_pi_skew_cal_swing_ctrl = vp_rx->m_pmix_skew_cal_swing_ctrl; 
        gRxLaneConfigBlock[v_lane_no].m_pi_input_skew_cal_adc_data_peak_bleed = vp_rx->m_adc_data_peak_bleed ; 
        
        handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
      } 

    } else {  
        rx__pmix_iq_skew_static_cfg (v_lane_no);

        handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
    }

  } else {  
    handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
  }
}

void func_rx_fwcmd_pulse_mmcdr_pi_clk (uint8_t fsm_no) {

  uint8_t v_lane_no = fsm_no - MAX_NUM_CM - MAX_NUM_LANE;

  rx__pulse_mmcdr_pi_clk (v_lane_no) ; 

