#include "fw.h"





void generate_general_debug_ack () {
  uint8_t   tsense_trim_code[4];      
  uint32_t  tsense_trim_code_u = 0;   

  g_reg_val = READ_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX2__ADDR); 
  g_reg_val = GET_FIELD (g_reg_val, PMD__FW_MAILBOX2__MB_ACK); 
 
  if (g_reg_val == 0) { 


   
   

    if (general_debug_mb_cmd == 1) {  
      WRITE_REG_FIELD (PMD_BASE_ADDR, PMD__FW_MAILBOX3__RSP_DATA1_7_0, 0x1);

      WRITE_REG_FIELD (PMD_BASE_ADDR, PMD__FW_MAILBOX5__RSP_DATA8_7_0, ((gFwMetadata.mFwVerBuildNo & 0xFF00) >> 8));

      g_reg_val = READ_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX4__ADDR);
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX4__RSP_DATA7_7_0, (gFwMetadata.mFwVerBuildNo & 0xFF));
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX4__RSP_DATA6_7_0, gFwMetadata.mFwVerSubSubMinor);
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX4__RSP_DATA5_7_0, gFwMetadata.mFwVerMajor);
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX4__RSP_DATA4_7_0, ((gFwMetadata.mFwVerMinor & 0xFF00) >> 8));
      WRITE_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX4__ADDR, g_reg_val);

      g_reg_val = READ_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX3__ADDR);
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX3__RSP_DATA3_7_0, (gFwMetadata.mFwVerMinor & 0xFF));
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX3__RSP_DATA2_7_0, gFwMetadata.mFwVerSubMinor);
      WRITE_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX3__ADDR, g_reg_val);

    } else if (general_debug_mb_cmd == 2) { 
      tsense_trim_code_u  = (uint32_t) gPmdConfigBlock.m_tsense_trim_code;
      tsense_trim_code[0] = (uint8_t) (tsense_trim_code_u & 0xFF);
      tsense_trim_code[1] = (uint8_t)((tsense_trim_code_u >>  8) & 0xFF);
      tsense_trim_code[2] = (uint8_t)((tsense_trim_code_u >> 16) & 0xFF);
      tsense_trim_code[3] = (uint8_t)((tsense_trim_code_u >> 24) & 0xFF);
      
    
      g_reg_val = READ_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX3__ADDR);
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX3__RSP_DATA1_7_0, 0xE);
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX3__RSP_DATA2_7_0, gCmConfigBlock[general_debug_fsm_h.m_cm_no].m_tsense_error);
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX3__RSP_DATA3_7_0, tsense_trim_code[0]);
      WRITE_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX3__ADDR, g_reg_val);
      
      g_reg_val = READ_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX4__ADDR);
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX4__RSP_DATA4_7_0, tsense_trim_code[1]);
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX4__RSP_DATA5_7_0, tsense_trim_code[2]);
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX4__RSP_DATA6_7_0, tsense_trim_code[3]);
      WRITE_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX4__ADDR, g_reg_val);

    } else if (general_debug_mb_cmd == 3) { 
    
      g_reg_val = READ_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX3__ADDR);
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX3__RSP_DATA1_7_0, 0xF);
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX3__RSP_DATA2_7_0, gCmConfigBlock[general_debug_fsm_h.m_cm_no].m_tsense_error);
      SET_FIELD (g_reg_val, PMD__FW_MAILBOX3__RSP_DATA3_7_0, gCmConfigBlock[general_debug_fsm_h.m_cm_no].m_s2c_meas_temp); 
      WRITE_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX3__ADDR, g_reg_val);
      
    }
  
    g_reg_val = READ_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX2__ADDR);
    SET_FIELD (g_reg_val, PMD__FW_MAILBOX2__RSP_7_0, 0x0);
    SET_FIELD (g_reg_val, PMD__FW_MAILBOX2__MB_ACK, 0x1);
    WRITE_REG (PMD_BASE_ADDR, PMD__FW_MAILBOX2__ADDR, g_reg_val);
  
    general_debug_fsm_busy  = 0;
    general_debug_cmd_cmplt = 0;
  }
}






uint32_t sign2abs (uint32_t inp_val, uint32_t width) {
   uint32_t ret_val ; 
   int32_t signed_val ; 
   uint32_t new_val =0 ;  

   ret_val = (inp_val>>(width-1)) & 1 ; 

   if (ret_val == 1) { 
      for (uint32_t i=width; i<32; i++) {
         new_val |= 1<<i ; 
      }
   }
   inp_val = inp_val | new_val ; 
   signed_val = (int32_t) inp_val ; 
   if (signed_val<0) {
      signed_val = (-1)*signed_val ; 
   }
   ret_val = (uint32_t)signed_val ; 
   return ret_val ;
}

uint32_t therm2dec (uint32_t therm_val) {
   uint32_t dec_val = 0  ; 
   uint32_t therm_val_int = 0 ;
   for (uint8_t i= 0; i<32; i++) {
      therm_val_int = (therm_val>> i) & 0x1 ; 
      if (therm_val_int == 0) {
         dec_val = i ; 
         i = 32 ; 
      } else {
         if (i == 31) dec_val = 32 ; 
      }
   }
   return dec_val ; 
}

uint32_t dec2therm (uint32_t dec_val) {
   uint32_t therm_val = 1 ; 
   for (uint32_t i =0; i<dec_val; i=i+1) {
      therm_val = therm_val*2 ; 
   }
   therm_val = therm_val -1 ; 
   return therm_val ; 
}

uint32_t dec2q (float a_frac_value, uint8_t a_no_of_frac_bits) {

  uint64_t v_q_integ_value, v_mult_factor;

  if (a_no_of_frac_bits < 32) {               
    v_mult_factor = 1 << a_no_of_frac_bits;

  } else {                                    
    v_mult_factor = 4294967296; 
  }
  
  v_q_integ_value = ((uint32_t) (a_frac_value * v_mult_factor));

  return (v_q_integ_value & 0xFFFFFFFF);
}

extern float comute_frac (bool a_sign, uint32_t a_frac_value, uint32_t a_div_factor) {

  float v_sign;

  v_sign = (a_sign) ? -1.0 : 1.0; 

  return ((a_frac_value * v_sign) / a_div_factor);
}

extern uint32_t min (uint32_t a_num1, uint32_t a_num2) {
  return ((a_num1 <= a_num2) ? a_num1 : a_num2);
}

extern int32_t movmean(int32_t *a_arr, uint32_t a_arr_size, uint32_t a_position, uint8_t a_window_size) {

  int32_t v_movmean_sum = 0, v_movmean = 0;

  uint8_t v_adjacent_elements = a_window_size / 2;
  uint8_t v_prev_elements = (((int32_t) (a_position - v_adjacent_elements)) >= 0) ? v_adjacent_elements : a_position;
  uint8_t v_next_elements = ((a_position + v_adjacent_elements) >= a_arr_size) ? ((a_arr_size - 1) - a_position) : v_adjacent_elements;

  for (uint32_t v_movmean_idx = a_position - v_prev_elements; v_movmean_idx <= a_position + v_next_elements; v_movmean_idx++) {
    v_movmean_sum = v_movmean_sum + a_arr[v_movmean_idx];
  }

  v_movmean = v_movmean_sum / (v_prev_elements + 1 + v_next_elements);
  return v_movmean;
} 




