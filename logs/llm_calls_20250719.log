ATTR_INLINE void tx__static_config (uint8_t a_lane_no, bool a_tx_mode, bool a_tx_cals_use_pads) {

  g_tx_base_addr = g_tx_base_addr_lut[a_lane_no];

  tx_t *vp_tx = &g_tx[a_lane_no];

  
  vp_tx->m_tx_mode         = a_tx_mode;

  
  vp_tx->m_tx_cals_use_pads = a_tx_cals_use_pads;
  vp_tx->m_tx_cal_st = e_tx_dcc_iq_onetime_setup;
  vp_tx->m_tx_startup_dcc_iq_rpt_cnt = gTxLaneConfigBlock[a_lane_no].m_tx_startup_dcc_iq_rpt_cnt;
  vp_tx->m_tx_dcc_iq_curr_rpt_cnt = 0;
  
  vp_tx->m_tx_ana_vref_cal_st = e_tx_ana_vref_cal_cfg_st;
  vp_tx->m_tx_ana_vref_cal_samp_cnt = gTxLaneConfigBlock[a_lane_no].m_tx_vref_cal_samp_cnt;
  vp_tx->m_tx_dcc_replica_vref_cal_st = e_tx_dcc_replica_vref_cfg_st;
  

  
  vp_tx->m_tx_level_cal_st = e_tx_level_cal_cfg_st;
  vp_tx->m_tx_level_cal_samp_count = gTxLaneConfigBlock[a_lane_no].m_tx_level_cal_samp_count;
  

  
  vp_tx->m_tx_cca_cal_st = e_tx_cca_config_st;
  vp_tx->m_tx_cca_iter_cnt = gTxLaneConfigBlock[a_lane_no].m_tx_cca_repeat_cnt;
  
  

  
  



  
  tx__startup_cal_static_config (a_lane_no);

  tx__cca_static_config (a_lane_no);
  

  
  uint8_t v_tx_ref_range = READ_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDVAL8__INT_TX0_REF_RANGE_I_3_0 );
  g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_CFG1__ADDR );
  SET_FIELD(g_reg_val, TX__TXS_CFG1__CALCLK_DIV_USE_REF_RANGE, 0);
  SET_FIELD(g_reg_val, TX__TXS_CFG1__CALCLK_DIV_5_0, v_tx_ref_range*2 ); 
  WRITE_REG( g_tx_base_addr, TX__TXS_CFG1__ADDR, g_reg_val);

  if (gTxLaneConfigBlock[a_lane_no].m_tx_skip_wa6_tx_clkgen_dcc_ctrl == 0) {
    WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL7__ANA_TX_ANA_CLKGEN_DCC_CTRL_2_0, 1 );
    WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_CLKGEN_DCC_CTRL, 1 );
  }

  if (gTxLaneConfigBlock[a_lane_no].m_tx_skip_wa5_tx_clkgen_phc_ctrl == 0) {
    WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL6__ANA_TX_ANA_CLKGEN_PHC_CTRL_2_0, 0x3 );
    WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDEN4__OVRD_EN_TX_ANA_CLKGEN_PHC_CTRL, 0x1 );
  }

    g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL2__ADDR );
    SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL2__DCC_CAL_CODE_UPDATE_T0_TO_T1_WAIT_3_0, 0xF );
    SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL2__DCC_CAL_CODE_UPDATE_T1_TO_T2_WAIT_3_0, 0xF );
    SET_FIELD( g_reg_val, TX__TXS_DCC_CAL_CTRL2__DCC_CAL_CODE_UPDATE_T2_TO_T3_WAIT_9_0, 0xFF );
    WRITE_REG( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL2__ADDR, g_reg_val );

    g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL2__ADDR );
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL2__TX_IQ_CAL_CODE_UPDATE_T0_TO_T1_WAIT_3_0, 0xF );
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL2__TX_IQ_CAL_CODE_UPDATE_T1_TO_T2_WAIT_3_0, 0xF );
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL2__TX_IQ_CAL_CODE_UPDATE_T2_TO_T3_WAIT_9_0, 0xFF );
    WRITE_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL2__ADDR, g_reg_val );


  
  if (vp_tx->m_tx_cals_use_pads == false) { 
    g_reg_val = READ_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL9__ANA_TX_ANA_VREG_CONFIG_7_0 );

    g_reg_val = (g_reg_val & 0x0F) | (2 << 4); 
    g_reg_val = (g_reg_val & 0xFC) | 0; 

    WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL9__ANA_TX_ANA_VREG_CONFIG_7_0, g_reg_val );
    WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDEN5__OVRD_EN_TX_ANA_VREG_CONFIG, 0x1 ); 

  } else { 
    tx__vreg_config (a_lane_no);
  }

  
  
}





void tx__startup_cal_static_config (uint8_t a_lane_no) {

  tx_t *vp_tx = &g_tx[a_lane_no];

  g_reg_val = READ_REG(g_tx_base_addr, TX__TXS_DCC_CAL_CTRL0__ADDR);
  SET_FIELD (g_reg_val, TX__TXS_DCC_CAL_CTRL0__DCC_CAL_CM_USE_PAD, 0x1) ; 
  SET_FIELD (g_reg_val, TX__TXS_DCC_CAL_CTRL0__DCC_CAL_COMP_POLARITY_INV, 0x0) ;
  WRITE_REG (g_tx_base_addr, TX__TXS_DCC_CAL_CTRL0__ADDR, g_reg_val) ;

  g_reg_val = READ_REG(g_tx_base_addr, TX__TXS_IQ_CAL_CTRL0__ADDR);
  SET_FIELD (g_reg_val, TX__TXS_IQ_CAL_CTRL0__TX_IQ_CAL_COMP_POLARITY_INV, 0x0);
  WRITE_REG (g_tx_base_addr, TX__TXS_IQ_CAL_CTRL0__ADDR, g_reg_val) ;

  if (vp_tx->m_tx_cals_use_pads == false) { 
    g_reg_val = READ_REG(g_tx_base_addr, TX__TXS_DCC_CAL_CTRL3__ADDR);
    SET_FIELD (g_reg_val, TX__TXS_DCC_CAL_CTRL3__DCC_CAL_CM_COMP_MODE_1_0, 0x2) ; 
    SET_FIELD (g_reg_val, TX__TXS_DCC_CAL_CTRL3__DCC_CAL_CM_REF_SEL_POLARITY_INV, 0x1) ; 
    SET_FIELD (g_reg_val, TX__TXS_DCC_CAL_CTRL3__DCC_CAL_CM_STATIC_PATTERN_3_0, 0xC) ; 
    SET_FIELD (g_reg_val, TX__TXS_DCC_CAL_CTRL3__DCC_CAL_CM_MUXA_SEL_3_0, 0x2) ; 
    SET_FIELD (g_reg_val, TX__TXS_DCC_CAL_CTRL3__DCC_CAL_CM_MUXB_SEL_3_0, 0x0) ; 
    WRITE_REG (g_tx_base_addr, TX__TXS_DCC_CAL_CTRL3__ADDR, g_reg_val) ; 

    g_reg_val = READ_REG(g_tx_base_addr, TX__TXS_DCC_CAL_CTRL5__ADDR);
    SET_FIELD (g_reg_val, TX__TXS_DCC_CAL_CTRL5__DCC_CAL_MUXA_SEL_3_0, 0x2) ; 
    SET_FIELD (g_reg_val, TX__TXS_DCC_CAL_CTRL5__DCC_CAL_MUXB_SEL_3_0, 0x0) ; 
    WRITE_REG (g_tx_base_addr, TX__TXS_DCC_CAL_CTRL5__ADDR, g_reg_val) ; 

    g_reg_val = READ_REG(g_tx_base_addr, TX__TXS_IQ_CAL_CTRL4__ADDR);
    SET_FIELD (g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_IQ_CAL_MUXA_SEL_3_0, 0x0);
    SET_FIELD (g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_IQ_CAL_MUXB_SEL_3_0, 0x1);
    SET_FIELD (g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_IQ_CAL_COMP_MODE_1_0, 0x1);
    WRITE_REG (g_tx_base_addr, TX__TXS_IQ_CAL_CTRL4__ADDR, g_reg_val) ; 

    g_reg_val = READ_REG(g_tx_base_addr, TX__TXS_IQ_CAL_CTRL0__ADDR);
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL0__TX_IQ_CAL_CM_USE_PAD, 0x0);
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL0__TX_IQ_CAL_REPLICA_SKIP, 0x1 ); 
    WRITE_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL0__ADDR, g_reg_val) ;

  } else { 
    g_reg_val = READ_REG(g_tx_base_addr, TX__TXS_DCC_CAL_CTRL3__ADDR);
    SET_FIELD (g_reg_val, TX__TXS_DCC_CAL_CTRL3__DCC_CAL_CM_REF_SEL_POLARITY_INV, 0x1) ; 
    SET_FIELD (g_reg_val, TX__TXS_DCC_CAL_CTRL3__DCC_CAL_CM_COMP_MODE_1_0, 0x2) ;
    WRITE_REG (g_tx_base_addr, TX__TXS_DCC_CAL_CTRL3__ADDR, g_reg_val) ; 


    g_reg_val = READ_REG(g_tx_base_addr, TX__TXS_IQ_CAL_CTRL4__ADDR);
    SET_FIELD (g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_IQ_CAL_MUXA_SEL_3_0, 0x0);
    SET_FIELD (g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_IQ_CAL_MUXB_SEL_3_0, 0x5);
    SET_FIELD (g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_IQ_CAL_COMP_MODE_1_0, 0x1);
    WRITE_REG (g_tx_base_addr, TX__TXS_IQ_CAL_CTRL4__ADDR, g_reg_val) ;

    g_reg_val = READ_REG(g_tx_base_addr, TX__TXS_IQ_CAL_CTRL0__ADDR);
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL0__TX_IQ_CAL_CM_USE_PAD, 0x1);
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL0__TX_IQ_CAL_REPLICA_SKIP, 0x0 ); 
    WRITE_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL0__ADDR, g_reg_val) ;
  }
}





void tx__cca_static_config (uint8_t a_lane_no) {

  tx_t *vp_tx = &g_tx[a_lane_no];


  if (vp_tx->m_tx_cals_use_pads && gTxLaneConfigBlock[a_lane_no].m_tx_dcc_pad_txpn_avg_en == 1) { 
    WRITE_REG_FIELD( g_tx_base_addr, TX__TXS_DCC_CAL_CTRL6__DCC_CAL_MM_MUXA_SEL_3_0, 0x1 ); 
  } else {
  }

  if (vp_tx->m_tx_cals_use_pads == true) { 
    g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL3__ADDR );
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL3__TX_IQ_CAL_REPLICA_COMP_MODE_1_0, 0x2 );
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL3__TX_IQ_CAL_REPLICA_MUXA_SEL_3_0, 0x0 );
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL3__TX_IQ_CAL_REPLICA_MUXB_SEL_3_0, 0x1 ); 
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL3__TX_PHC_I_CAL_REPLICA_STATIC_PATTERN_3_0, gTxLaneConfigBlock[a_lane_no].m_iq_cal_replica_i_static_pattern );
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL3__TX_PHC_Q_CAL_REPLICA_STATIC_PATTERN_3_0, gTxLaneConfigBlock[a_lane_no].m_iq_cal_replica_i_static_pattern );
    WRITE_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL3__ADDR, g_reg_val );

    g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL4__ADDR );
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_IQ_CAL_MM_MUXA_SEL_3_0, 0x0 ); 
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_IQ_CAL_MM_MUXB_SEL_3_0, 0x1 ); 
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_IQ_CAL_MM_COMP_MODE_1_0, 0x2 );
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_PHC_I_CAL_STATIC_PATTERN_3_0, gTxLaneConfigBlock[a_lane_no].m_iq_cal_replica_i_static_pattern );
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_PHC_Q_CAL_STATIC_PATTERN_3_0, gTxLaneConfigBlock[a_lane_no].m_iq_cal_replica_i_static_pattern );
    WRITE_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL4__ADDR, g_reg_val );

    g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL0__ADDR );
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL0__TX_IQ_CAL_REPLICA_DECISION_POLARITY_INV, 1 ); 
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL0__TX_IQ_CAL_MM_DECISION_POLARITY_INV, gTxLaneConfigBlock[a_lane_no].m_iq_cal_mm_i_pattern_polarity_inv );
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL0__TX_IQ_CAL_MM_LINEAR_SEARCH_LOOP_COUNT_6_0, gTxLaneConfigBlock[a_lane_no].m_iq_cal_mm_loop_count );
    WRITE_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL0__ADDR, g_reg_val );
  } else { 
    g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL4__ADDR );
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_IQ_CAL_MM_MUXA_SEL_3_0, 0x0 );
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_IQ_CAL_MM_MUXB_SEL_3_0, 0x1 ); 
    SET_FIELD( g_reg_val, TX__TXS_IQ_CAL_CTRL4__TX_IQ_CAL_MM_COMP_MODE_1_0, 0x1 );
    WRITE_REG( g_tx_base_addr, TX__TXS_IQ_CAL_CTRL4__ADDR, g_reg_val );
  }
}





ATTR_INLINE void tx__rate_config (uint8_t a_lane_no) {

  tx_t *vp_tx = &g_tx[a_lane_no];

  uint8_t v_tx_rate           = vp_tx->m_tx_rate;
  uint8_t v_tx_rate_idx       = vp_tx->m_tx_rate_idx;
  bool    v_tx_pll_sel        = vp_tx->m_tx_pll_sel;

  vp_tx->m_tx_1p25_div_retry_iter = 0;
  gTxLaneConfigBlock[a_lane_no].m_tx_fractional_div_failure = 0;


  WRITE_REG_FIELD( g_tx_base_addr, TX__TXS_CFG6__CFG_TX_ANA_CLKGEN_SEL_MAIN, 1);
  WRITE_REG_FIELD (g_tx_base_addr, TX__TXS_CFG6__CFG_TX_ANA_CLKGEN_CLK_DIV_3_0, 0x0) ; 

  if ( ( (g_fw_fastsim_en == 1) || (gTxLaneConfigBlock[a_lane_no].m_tx_skip_wa4_tx_fractional_divider_fix == 1) || \
        !((gRateConfigMasterDefaults[v_tx_rate_idx].cfg_tx_ana_clkgen_clk_div >= 4) && (gRateConfigMasterDefaults[v_tx_rate_idx].cfg_tx_ana_clkgen_clk_div <=11))) && \
       (v_tx_rate <= 61) ) {  
      tx__div_config (a_lane_no, v_tx_rate_idx);
  }

  WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL10__ANA_TX_ANA_SPARE_I_31_0, gRateConfigMasterDefaults[v_tx_rate_idx].ana_tx_ana_spare_i );
 
  WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDEN2__OVRD_EN_TX_ANA_SPARE_I_31_0, 0xFFFFFFFF);


  WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL2__ANA_TX_ANA_DRV_SER_TEST_7_0, gRateConfigMasterDefaults[v_tx_rate_idx].tx_ana_drv_ser_test );
  WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDEN0__OVRD_EN_TX_ANA_DRV_SER_TEST, 0x1 );

  g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_CFG6__ADDR );
  SET_FIELD( g_reg_val, TX__TXS_CFG6__CFG_TX_ANA_CLKGEN_TUNE_0_3_0,   gRateConfigMasterDefaults[v_tx_rate_idx].cfg_tx_ana_clkgen_tune_0  );
  SET_FIELD( g_reg_val, TX__TXS_CFG6__CFG_TX_ANA_CLKGEN_TUNE_90_3_0,  gRateConfigMasterDefaults[v_tx_rate_idx].cfg_tx_ana_clkgen_tune_90 );
  SET_FIELD( g_reg_val, TX__TXS_CFG6__CFG_TX_ANA_CLKGEN_TUNE_180_3_0, gRateConfigMasterDefaults[v_tx_rate_idx].cfg_tx_ana_clkgen_tune_180 );
  SET_FIELD( g_reg_val, TX__TXS_CFG6__CFG_TX_ANA_CLKGEN_TUNE_270_3_0, gRateConfigMasterDefaults[v_tx_rate_idx].cfg_tx_ana_clkgen_tune_270 );
  SET_FIELD( g_reg_val, TX__TXS_CFG6__CFG_TX_ANA_SEL_CLKPLLB, v_tx_pll_sel );
  WRITE_REG( g_tx_base_addr, TX__TXS_CFG6__ADDR, g_reg_val );

  g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_CFG0__ADDR );
  SET_FIELD( g_reg_val, TX__TXS_CFG0__TX_BIT_DBL_1_0,  gRateConfigMasterDefaults[v_tx_rate_idx].tx_bit_dbl );
  WRITE_REG( g_tx_base_addr, TX__TXS_CFG0__ADDR, g_reg_val );


  WRITE_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDVAL8__INT_TX0_REF_RANGE_I_3_0, gRateConfigMasterDefaults[v_tx_rate_idx].tx0_ref_range_i );
  WRITE_REG_FIELD( g_tx_base_addr, TX__PIN_OVRDEN1__OVRD_EN_TX0_REF_RANGE_I, 0x1 );


  WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDVAL4__ANA_TX_ANA_LANE_CLKBUF_TEST_2_0, gRateConfigMasterDefaults[v_tx_rate_idx].ana_tx_ana_lane_clkbuf_test );
  WRITE_REG_FIELD( g_tx_base_addr, TX__ANA_OVRDEN1__OVRD_EN_TX_ANA_LANE_CLKBUF_TEST, 0x1 );


  


}

void tx__div_config (uint8_t a_lane_no, uint8_t a_tx_rate_idx) {

  for (uint8_t j=0; j<gTxLaneConfigBlock[a_lane_no].m_tx_fractional_div_toggle_cnt; j++){
    g_reg_val = READ_REG( g_tx_base_addr, TX__TXS_CFG6__ADDR );
    SET_FIELD( g_reg_val, TX__TXS_CFG6__CFG_TX_ANA_CLKGEN_SEL_MAIN, 1 );  
    for (uint8_t i=0; i<10; i++){
      WRITE_REG( g_tx_base_addr, TX__TXS_CFG6__ADDR, g_reg_val );
    }

    SET_FIELD( g_reg_val, TX__TXS_CFG6__CFG_TX_ANA_CLKGEN_SEL_MAIN, gRateConfigMasterDefaults[a_tx_rate_idx].cfg_tx_ana_clkgen_sel_main );  
    WRITE_REG( g_tx_base_addr, TX__TXS_CFG6__ADDR, g_reg_val );
    WRITE_REG( g_tx_base_addr, TX__TXS_CFG6__ADDR, g_reg_val );
    WRITE_REG( g_tx_base_addr, TX__TXS_CFG6__ADDR, g_reg_val );
  
    for (uint8_t i=0; i<10; i++){
      WRITE_REG_FIELD (g_tx_base_addr, TX__TXS_CFG6__CFG_TX_ANA_CLKGEN_CLK_DIV_3_0, 0x0) ; 
    }

    WRITE_REG_FIELD (g_tx_base_addr, TX__TXS_CFG6__CFG_TX_ANA_CLKGEN_CLK_DIV_3_0, gRateConfigMasterDefaults[a_tx_rate_idx].cfg_tx_ana_clkgen_clk_div) ; 
    WRITE_REG_FIELD (g_tx_base_addr, TX__TXS_CFG6__CFG_TX_ANA_CLKGEN_CLK_DIV_3_0, gRateConfigMasterDefaults[a_tx_rate_idx].cfg_tx_ana_clkgen_clk_div) ; 
    WRITE_REG_FIELD (g_tx_base_addr, TX__TXS_CFG6__CFG_TX_ANA_CLKGEN_CLK_DIV_3_0, gRateConfigMasterDefaults[a_tx_rate_idx].cfg_tx_ana_clkgen_clk_div) ; 
  }
}

