ATTR_INLINE bool pmd_cm__pll_fw_cmd4_b4_pll_disable (uint8_t a_cm_no) {  
  bool    v_done = false;


  if ((g_cm[0].m_pll_mode == e_pcie_mode) && (g_cm[1].m_pll_mode == e_pcie_mode) && (g_num_cm == 2)) {  
  } else {  
    v_done = true;
  }

  return v_done;
}



ATTR_INLINE bool pmd_cm__pll_fw_cmd_reserved (uint8_t a_cm_no) {
  return true;
}

ATTR_INLINE void pmd_cm__save_pll_cfg (uint8_t a_cm_no) {
  pmd_pll_cfg_settings *vp_pmd_pll_cfg_settings_h = &pmd_pll_cfg_settings_h[a_cm_no];
  vp_pmd_pll_cfg_settings_h->m_pll_cntx = READ_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__PMD_CM_OVRDVAL1__PLLX_CNTX_SEL_I_5_0 );
}

ATTR_INLINE void pmd_cm__restore_pll_cfg (uint8_t a_cm_no) {
  pmd_pll_cfg_settings *vp_pmd_pll_cfg_settings_h = &pmd_pll_cfg_settings_h[a_cm_no];
  WRITE_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__PMD_CM_OVRDVAL1__PLLX_CNTX_SEL_I_5_0, vp_pmd_pll_cfg_settings_h->m_pll_cntx );



}

ATTR_INLINE void pmd_cm__pmix_inl_pll_cfg (uint8_t a_cm_no) {
  WRITE_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__PMD_CM_OVRDVAL1__PLLX_CNTX_SEL_I_5_0, 2 ); 
  WRITE_REG_FIELD( g_pmd_cm_base_addr, PMD_CM__PMD_CM_OVRDEN0__OVRD_EN_PLLX_CNTX_SEL_I, 1 );
}


