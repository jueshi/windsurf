inline void config_tx_pwrseq (uint8_t vLaneNo) {

  tx_t *vp_tx = &g_tx[vLaneNo];

  uint32_t vI;
  uint32_t vAddrOfst;

  struct tPowerSequencePstateStep_t *vpPowerUpSequencePstateStepLut;
  struct tPowerSequencePstateStep_t *vpPowerDownSequencePstateStepLut;

  

    vpPowerUpSequencePstateStepLut   = &gEthTxPowerUpSequencePstateStepLut;
    vpPowerDownSequencePstateStepLut = &gEthTxPowerDownSequencePstateStepLut;


  
  g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_PWRUP_CFG32__ADDR );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRUP_CFG32__TX_PWRUP_RST_STEP_MAPPING_5_0, vpPowerUpSequencePstateStepLut->rst_step_map );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRUP_CFG32__TX_PWRUP_P2_STEP_MAPPING_5_0 , vpPowerUpSequencePstateStepLut->p2_step_map  );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRUP_CFG32__TX_PWRUP_P1_STEP_MAPPING_5_0 , vpPowerUpSequencePstateStepLut->p1_step_map  );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRUP_CFG32__TX_PWRUP_P0S_STEP_MAPPING_5_0, vpPowerUpSequencePstateStepLut->p0s_step_map );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRUP_CFG32__TX_PWRUP_P0_STEP_MAPPING_5_0 , vpPowerUpSequencePstateStepLut->p0_step_map  );
  WRITE_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_PWRUP_CFG32__ADDR, g_reg_val );


  vAddrOfst = 0x0;
  for (vI = 0; vI <= vpPowerUpSequencePstateStepLut->p0_step_map ; vI=vI+2)
  {
    if (vp_tx->m_tx_mode == e_pcie_mode) { 
      g_reg_val = (uint32_t)(*((uint32_t *)&gPcieTxPowerUpSequenceTableLut[vI]));
    } else {  
      g_reg_val = (uint32_t)(*((uint32_t *)&gEthTxPowerUpSequenceTableLut[vI]));
    }

    WRITE_REG( g_pmd_lane_tx_base_addr, (PMD_LANE_TX__TX_PWRUP_CFG0__ADDR + vAddrOfst), g_reg_val );
    
    vAddrOfst += 0x04;
  }

  
  g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_PWRDN_CFG16__ADDR );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRDN_CFG16__TX_PWRDN_RST_STEP_MAPPING_4_0, vpPowerDownSequencePstateStepLut->rst_step_map );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRDN_CFG16__TX_PWRDN_P2_STEP_MAPPING_4_0 , vpPowerDownSequencePstateStepLut->p2_step_map  );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRDN_CFG16__TX_PWRDN_P1_STEP_MAPPING_4_0 , vpPowerDownSequencePstateStepLut->p1_step_map  );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRDN_CFG16__TX_PWRDN_P0S_STEP_MAPPING_4_0, vpPowerDownSequencePstateStepLut->p0s_step_map );
  SET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRDN_CFG16__TX_PWRDN_P0_STEP_MAPPING_4_0 , vpPowerDownSequencePstateStepLut->p0_step_map  );
  WRITE_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_PWRDN_CFG16__ADDR, g_reg_val );

  vAddrOfst = 0x0;
  for (vI = 0; vI <= vpPowerDownSequencePstateStepLut->rst_step_map ; vI=vI+2)
  {
    if (vp_tx->m_tx_mode == e_pcie_mode) { 
      g_reg_val = (uint32_t)(*((uint32_t *)&gPcieTxPowerDownSequenceLut[vI]));
    } else {  
      g_reg_val = (uint32_t)(*((uint32_t *)&gEthTxPowerDownSequenceLut[vI]));
    }

    WRITE_REG( g_pmd_lane_tx_base_addr, (PMD_LANE_TX__TX_PWRDN_CFG0__ADDR + vAddrOfst), g_reg_val );
    
    vAddrOfst += 0x04;
  }


}

