  handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
}




void funcTxCcaMisMode(uint8_t fsm_no) {

  uint8_t v_lane_no = fsm_no - MAX_NUM_CM;
  uint8_t v_cntx;
  bool v_done, v_abort_cca;

  v_cntx = READ_REG_FIELD( g_pmd_cm_base_addr_lut[g_tx[v_lane_no].m_tx_pll_sel], PMD_CM__PMD_CM_OVRDVAL1__PLLX_CNTX_SEL_I_5_0 );

  v_done = tx__cca_mis_mode(v_lane_no, v_cntx); 

  v_abort_cca = READ_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_FW_CSR1__TX_FW_ABORT );
  if ((gTxLaneConfigBlock[v_lane_no].m_tx_cca_status == 1) && (v_abort_cca == 1)) {
    v_done = true;
  }

  if (v_done == true) {
    handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
  }
}



void func_tx_check (uint8_t vLaneNo) {

  tx_t *vp_tx = &g_tx[vLaneNo];

  if (vp_tx->m_tx_mode == e_pcie_mode) { 
    if (gTxFwRptStrupCount[vLaneNo] == 4) {
      delay_ns(300);
      WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_REQ_I, 0x0 );
      delay_ns(100);

      g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDEN0__ADDR );
      SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDEN0__OVRD_EN_TXX_REQ_I, 0x0 );
      SET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDEN0__OVRD_EN_TXX_ACK_O, 0x0 );
      WRITE_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDEN0__ADDR, g_reg_val );

      trigger_tx_ack_check[vLaneNo] = 0;
    }

  } else {  
    func_tx_data_en(vLaneNo);
  }
}


void func_tx_data_en (uint8_t vLaneNo) {
  if (READ_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_FW_CSR6__FW_ETH_HOLD_TXX_DATA_PHASE_START ) != 1) {


    
    g_reg_val = READ_REG( g_pmd_lane_tx_base_addr,PMD_LANE_TX__PMD_TX_OVRDVAL0__ADDR );
    g_reg_val = GET_FIELD( g_reg_val, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_ACK_O);

    if (g_reg_val == 0) {
      g_dccm_time_stamp_tx[vLaneNo][e_dts_tx_9_txx_data_en_1] = dump_rtc();

      WRITE_REG_FIELD( g_pmd_lane_tx_base_addr, PMD_LANE_TX__PMD_TX_OVRDVAL0__TXX_DATA_EN_I, 1 );

      trigger_tx_ack_check[vLaneNo] = 0;
    }

  }
}

void pmd_tx__calibrations (uint8_t fsm_no) {

  uint8_t v_lane_no = fsm_no - MAX_NUM_CM;

  bool v_done, v_skip_cals, v_strup_dcc_skip, v_strup_iq_skip;

  g_reg_val = READ_REG( g_pmd_lane_tx_base_addr, PMD_LANE_TX__TX_PWRDN_CFG16__ADDR );
  v_skip_cals = GET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRDN_CFG16__TX_SKIP_CALS );
  v_strup_dcc_skip = GET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRDN_CFG16__TX_SKIP_DCC_CAL );
  v_strup_iq_skip = GET_FIELD( g_reg_val, PMD_LANE_TX__TX_PWRDN_CFG16__TX_SKIP_IQ_CAL );

  if (v_skip_cals || (g_fw_fastsim_en == 1)) {
    v_done = true;
  } else {
    v_done = tx__calibrations (v_lane_no, v_strup_dcc_skip, v_strup_iq_skip);
  }

  if (v_done == true) {
    handshake_fsm_st[fsm_no] = e_pmd_handler_ack_st;
  }
}





