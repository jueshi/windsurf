# Stock Toolbox Web - Environment Variables Template
# Copy this file to .env and fill in your values

# Google Gemini API Key (required for AI analysis features)
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Specify Gemini model (defaults to gemini-2.0-flash)
# GEMINI_MODEL_NAME=gemini-2.0-flash

# Tavily API Key (required for news fetching)
# Get your key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# SEC EDGAR Email (required for SEC filings access)
# SEC requires a valid email in the User-Agent header
SEC_EDGAR_EMAIL=your_email@example.com
